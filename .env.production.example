# Copy to .env.production and fill in every line. Never commit the real file.

# The public address people will use, without https://. Its DNS record must
# already point at this server, otherwise the certificate cannot be issued.
DOMAIN=menu.example.org
PUBLIC_BASE_URL=https://menu.example.org

# The database container. Pick a long random password with only letters and
# digits (for example the output of: openssl rand -hex 24), it is used inside a URL.
POSTGRES_USER=qaemati
POSTGRES_PASSWORD=
POSTGRES_DB=qaemati

# Each at least 16 characters, different from each other. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
CSRF_SECRET=

DEFAULT_LOCALE=ar

# Email through Gmail, see .env.example for how to get the app password.
MAIL_USER=
MAIL_APP_PASSWORD=
MAIL_FROM=

# Optional: only these addresses can open the platform area /super, for example
# 203.0.113.7,198.51.100.0/24. Leave empty until you know your own address.
SUPER_ALLOWED_IPS=

# Landing page contact (WhatsApp wins over email) and the sample menu behind "see a live menu".
LANDING_CONTACT_WHATSAPP=
LANDING_CONTACT_EMAIL=
LANDING_DEMO_SLUG=
# Set true only once thmanyah has allowed web use of its font (see .env.example).
THMANYAH_WEB_LICENSED=
