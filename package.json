{
  "name": "qaemati",
  "version": "0.1.0",
  "description": "Qaemati - digital menu demo for restaurants and cafes",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "postinstall": "node scripts/copy-vendor-js.js",
    "build": "npm run build:vendor && npm run build:css && npm run build:nest",
    "build:nest": "nest build",
    "build:css": "tailwindcss -i ./src/styles/app.css -o ./public/css/app.css --minify",
    "build:vendor": "node scripts/copy-vendor-js.js",
    "start": "node dist/main.js",
    "start:dev": "concurrently -k -n nest,css -c blue,yellow \"nest start --watch\" \"npm run watch:css\"",
    "watch:css": "tailwindcss -i ./src/styles/app.css -o ./public/css/app.css --watch",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\"",
    "lint:fix": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "format": "prettier --write \"src/**/*.ts\"",
    "test": "jest",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:seed": "prisma db seed",
    "contrast:check": "ts-node scripts/check-contrast.ts"
  },
  "dependencies": {
    "@nestjs/common": "^10.4.15",
    "@nestjs/config": "^3.3.0",
    "@nestjs/core": "^10.4.15",
    "@nestjs/platform-express": "^10.4.15",
    "@prisma/client": "^5.22.0",
    "alpinejs": "^3.17.4",
    "bcrypt": "^5.1.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "connect-pg-simple": "^10.0.0",
    "cookie-parser": "^1.4.7",
    "csrf-csrf": "^3.1.0",
    "express-session": "^1.18.1",
    "helmet": "^8.0.0",
    "htmx.org": "^2.0.11",
    "multer": "^2.4.0",
    "nestjs-i18n": "^10.5.0",
    "nunjucks": "^3.2.4",
    "qrcode": "^1.5.4",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.9",
    "@nestjs/schematics": "^10.2.3",
    "@nestjs/testing": "^10.4.15",
    "@types/bcrypt": "^5.0.2",
    "@types/cookie-parser": "^1.4.8",
    "@types/express": "^5.0.0",
    "@types/express-session": "^1.18.0",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.10.1",
    "@types/nunjucks": "^3.2.6",
    "@types/qrcode": "^1.5.5",
    "@typescript-eslint/eslint-plugin": "^8.17.0",
    "@typescript-eslint/parser": "^8.17.0",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.0",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.2.1",
    "jest": "^29.7.0",
    "postcss": "^8.4.49",
    "prettier": "^3.4.2",
    "prisma": "^5.22.0",
    "source-map-support": "^0.5.21",
    "tailwindcss": "^3.4.16",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.1",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.2"
  },
  "prisma": {
    "schema": "prisma/schema.prisma",
    "seed": "ts-node prisma/seed.ts"
  }
}
