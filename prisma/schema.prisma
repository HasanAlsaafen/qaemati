generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ItemTag {
  SPICY
  VEGETARIAN
  NEW
  POPULAR
  VEGAN
  GLUTEN_FREE
  CONTAINS_NUTS
  CONTAINS_DAIRY
}

model Restaurant {
  id String @id @default(cuid())

  slug String @unique

  /// Where the restaurant is, for checking that a table order comes from
  /// inside it. Both null means the check cannot run (the POS page warns).
  latitude             Decimal? @db.Decimal(9, 6)
  longitude            Decimal? @db.Decimal(9, 6)
  /// How far from that point a guest may be, in meters.
  orderRadiusMeters    Int      @default(150)
  requireLocationCheck Boolean  @default(true)
  /// Next order number, taken with an atomic update so numbers never repeat.
  nextOrderNumber      Int      @default(1)

  orders         Order[]
  waiterCalls    WaiterCall[]
  notices        NotificationLog[]
  pairings       ItemPairing[]
  suggestionAdds SuggestionAdd[]

  nameAr String
  nameEn String

  descriptionAr String?
  descriptionEn String?

  logoPath       String?
  coverImagePath String?

  /// A4: hex color, e.g. "#44603C". Null means "use the default Zaytoun
  /// palette" (src/styles/tokens.css's own --color-primary), not black
  /// or an empty string -- consistent with every other "unset means use
  /// the house default" field in this schema. Must pass
  /// meetsPrimaryColorContrast (src/common/color.ts) before being saved
  /// -- enforced in RestaurantService, not at the DB level, matching
  /// every other cross-field validation in this app.
  primaryColor String?

  /// Admin customization: a second accent hex, used for the soft-tint
  /// badge/button style (--color-secondary-text on --color-secondary-soft,
  /// e.g. the Instagram link button) rather than as a solid background --
  /// see RestaurantService's derivation for why its contrast check is
  /// against the derived soft tint, not white, unlike primaryColor.
  secondaryColor String?

  /// Admin customization: 'classic' (Thmanyah Sans + Serif Display, the
  /// original Phase 1 pairing) or 'modern' (IBM Plex Sans Arabic + Inter,
  /// already self-hosted as the Arabic fallback face -- see
  /// src/styles/fonts.css -- so offering it as a selectable pairing needs
  /// no new font files). Never free text: the admin picks from these two,
  /// both already licensed and vendored.
  fontTheme String @default("classic")

  /// Admin customization: 'comfortable' (the original card size/spacing)
  /// or 'compact' (smaller item images, tighter padding) on the public
  /// menu's item grid.
  menuDensity String @default("comfortable")

  /// Admin customization: 'rounded' (the original --radius-sm/md/lg
  /// token values) or 'sharp' (the same three tokens overridden much
  /// smaller -- see menu.service.ts's toCornerStyleCss). A pure CSS
  /// custom-property swap, same mechanism as primaryColor/secondaryColor,
  /// so it reaches every card/button/badge on the public menu that's
  /// already built on the rounded-sm/md/lg Tailwind classes without
  /// touching any of that markup.
  cornerStyle String @default("rounded")

  /// Admin customization: overrides --color-bg (the page background)
  /// -- null means the default Zaytoun cream. Unlike primary/secondary,
  /// there's no derived hover/soft palette, just the one swap; validated
  /// against the fixed (non-customizable) --color-text so body copy
  /// stays readable, same AA bar as the other color fields.
  backgroundColor String?

  /// Admin customization: 'flat' (the original border-only card, no
  /// shadow) or 'raised' (adds --shadow-raised on top of the same
  /// border) on the public menu's item cards.
  cardStyle String @default("flat")

  /// Admin customization: 'rounded' (follows cornerStyle's
  /// --radius-md, the original look) or 'pill' (fully rounded,
  /// independent of cornerStyle) for the menu's CTA-style buttons
  /// (WhatsApp/Instagram links, the selection sheet's send/cancel
  /// buttons) -- not the circular icon buttons or the already-pill
  /// floating selection bar, which stay as they are regardless.
  buttonShape String @default("rounded")

  /// Admin customization: 'none' (the original gap-only spacing) |
  /// 'line' (a solid border-top) | 'dashed' between category sections
  /// on the public menu. A pure CSS rule keyed off this value (see
  /// src/styles/app.css's body[data-category-divider] block), no markup
  /// change needed per category.
  categoryDivider String @default("none")

  /// How the dish cards are laid out: grid, list or large. A data attribute on the page body, like the others.
  menuLayout     String @default("grid")
  /// Whether dish cards show their photo: show or hide.
  itemImages     String @default("show")
  /// The photo frame on dish cards: standard, wide, square or round.
  itemImageShape String @default("standard")
  /// The mark before each category title: none, bar, dot or underline.
  categoryMarker String @default("none")

  /// Header and text looks, each a data attribute on the page body.
  logoShape    String @default("rounded")
  coverHeight  String @default("medium")
  priceStyle   String @default("plain")
  headingAlign String @default("start")

  /// A seasonal motif drawn as a band on the menu: none, or a theme key such as
  /// ramadan or eidAdha. Decoration only, never carries text.
  themeDecor String @default("none")

  /// Admin customization: 'solid' (the original flat --color-bg,
  /// possibly itself overridden by backgroundColor) | 'pattern' (a
  /// subtle repeating CSS pattern tinted with --color-primary, see
  /// backgroundPattern) | 'image' (a restaurant-uploaded photo, see
  /// backgroundImagePath). 'pattern' and 'image' are mutually exclusive
  /// with each other but layer on top of backgroundColor/the default.
  backgroundStyle String @default("solid")

  /// Which pattern to use when backgroundStyle is 'pattern':
  /// 'dots' | 'grid' | 'diagonal'. Ignored otherwise.
  backgroundPattern String @default("dots")

  /// Set when backgroundStyle is 'image' -- an uploaded photo used as
  /// the page background (cover, centered, scrolls with the page so it
  /// never fights mobile Safari's background-attachment:fixed quirks).
  /// Same upload mechanism as logoPath/coverImagePath.
  backgroundImagePath String?

  /// Admin customization: 'cozy' | 'comfortable' (the original gap-8
  /// spacing, left untouched) | 'spacious' -- the gap between category
  /// sections on the public menu (not item-card internal spacing,
  /// which is menuDensity's job; the two are independent dimensions).
  sectionSpacing String @default("comfortable")

  /// A4: the default currency new items are created with (restaurant-
  /// level, not per-item -- each Item still stores its own `currency`
  /// so a restaurant could in principle mix currencies, but the admin
  /// "add item" form defaults to this rather than a hardcoded "ILS").
  currency String @default("ILS")

  whatsapp        String?
  instagramHandle String?

  /// Short line under the name on the public menu header.
  taglineAr String?
  taglineEn String?

  /// Voice number for a tap to call link, shown next to WhatsApp.
  phone String?

  /// A page handle or a full https URL, normalised by src/common/contact.ts.
  facebookUrl String?

  /// Free text street address and area, plus an optional map link (https).
  addressAr String?
  addressEn String?
  mapUrl    String?

  workingHoursAr String?
  workingHoursEn String?

  /// A3: structured daily hours, "HH:MM" 24h, Asia/Hebron -- separate from
  /// the free-text workingHoursAr/En above (which stays the human-written
  /// display string, e.g. "Daily, 7:00 AM - 11:00 PM"; free text can't be
  /// parsed back into a live open/closed computation). Single daily range
  /// rather than per-weekday, matching how every seeded restaurant's own
  /// display text already describes its hours ("Daily, ..."). Null means
  /// "no structured hours set" -- the open/closed badge is hidden
  /// entirely rather than guessing, consistent with A1's "hide gracefully
  /// when the data isn't there" precedent.
  openTime  String?
  closeTime String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  adminUsers        AdminUser[]
  menus             Menu[]
  subscription      Subscription?
  payments          Payment[]
  categories        Category[]
  items             Item[]
  tables            RestaurantTable[]
  itemVariants      ItemVariant[]
  itemAddons        ItemAddon[]
  menuViews         MenuView[]
  bulkOperationLogs BulkOperationLog[]
}

enum StaffRole {
  OWNER
  CASHIER
  KITCHEN
}

model AdminUser {
  id String @id @default(cuid())

  /// OWNER can do everything. CASHIER works the orders screen and sees what a
  /// guest pays. KITCHEN sees what to cook and marks it started or ready.
  role StaffRole @default(OWNER)

  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  email        String @unique
  passwordHash String
  name         String

  /// A5: whether this admin has dismissed (or clicked through) the
  /// first-login guided tour. Checked once at login (AuthController) and
  /// cached on the session rather than re-queried on every admin page
  /// request, same "read once, cache on the session" pattern as
  /// restaurantSlug/adminName in AdminLocalsMiddleware.
  hasSeenTour Boolean @default(false)

  passwordResets PasswordResetToken[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([restaurantId])
}

/// A named group of categories with its own optional serving hours, such as
/// Breakfast 07:00 to 12:00 and All day. Hours only describe the menu on the
/// public page, they never hide it.
model Menu {
  id String @id @default(cuid())

  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  nameAr String
  nameEn String

  /// "HH:MM" 24h, Asia/Hebron. Both set or both null. A window that ends
  /// before it starts (22:00 to 02:00) runs overnight.
  availableFrom String?
  availableTo   String?

  sortOrder Int @default(0)

  categories Category[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([restaurantId])
}

model Category {
  id String @id @default(cuid())

  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  nameAr String
  nameEn String

  sortOrder Int @default(0)

  /// A3: optional daily availability window, "HH:MM" 24h, Asia/Hebron --
  /// "Breakfast" might only make sense 07:00-11:00. Both null (the
  /// default) means always available, matching every category's
  /// behavior before this feature existed. Set independently of each
  /// other is invalid (enforced in CategoryService, not at the DB level,
  /// same pattern as every other cross-field validation in this app).
  availableFrom String?
  availableTo   String?

  /// Which menu this category belongs to. Nullable so rows written before
  /// menus existed, or by code that does not know about them, still load:
  /// null means "the restaurant's first menu" (see MenusService).
  menuId String?
  menu   Menu?   @relation(fields: [menuId], references: [id], onDelete: SetNull)

  /// Picture for the round chip in the public category bar. Null falls back
  /// to the restaurant logo, then to a built in image.
  imagePath String?

  items Item[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([restaurantId])
  @@index([menuId])
}

model Item {
  id String @id @default(cuid())

  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  categoryId String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  nameAr String
  nameEn String

  descriptionAr String?
  descriptionEn String?

  price    Decimal @db.Decimal(10, 2)
  currency String  @default("ILS")

  imagePath String?

  tags ItemTag[]

  /// B1: owner-editable free text for allergy/ingredient caveats the
  /// fixed CONTAINS_NUTS/CONTAINS_DAIRY/etc. tags can't express on their
  /// own (e.g. "fried in the same oil as shellfish") -- shown on the
  /// public item detail sheet when set, optional like description.
  allergenNoteAr String?
  allergenNoteEn String?

  available       Boolean @default(true)
  /// A3: "Today's special" banner flag -- owner-toggled, not date-scoped
  /// (there's no "which day" concept in this app), so it's exactly as
  /// current as the owner keeps it, same honesty tradeoff as `available`.
  isTodaysSpecial Boolean @default(false)
  sortOrder       Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  variants       ItemVariant[]
  addons         ItemAddon[]
  menuViews      MenuView[]
  pairings       ItemPairing[]   @relation("PairingFrom")
  pairedBy       ItemPairing[]   @relation("PairingTo")
  suggestionAdds SuggestionAdd[]

  @@index([restaurantId])
  @@index([categoryId])
}

/// B2: a single view event -- a null itemId is a whole-menu page load
/// (GET /m/:slug), a set itemId is an item detail sheet open (a
/// client-side fetch beacon, since that's not a page navigation). Never
/// recorded for the restaurant's own admin viewing/previewing their own
/// menu (see MenuController), so an owner checking their own page
/// doesn't inflate their own analytics.
model MenuView {
  id String @id @default(cuid())

  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  itemId String?
  item   Item?   @relation(fields: [itemId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([restaurantId, createdAt])
  @@index([itemId, createdAt])
}

/// B3: one entry per bulk-mutating action (bulk price change, CSV import)
/// -- NOT per-item duplication, which is trivially reversible with one
/// delete and doesn't need a snapshot. `snapshot` holds one JSON array
/// entry per affected item: `{ itemId, created: bool, previous: {...} |
/// null }`. `created: true` means undo = delete that item; otherwise
/// undo = write `previous` back. Single-level undo (only the most
/// recent un-undone log is offered), not a full history stack --
/// matches the glossary's singular "Undo", not "Undo history".
model BulkOperationLog {
  id String @id @default(cuid())

  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  type     String
  snapshot Json

  createdAt DateTime  @default(now())
  undoneAt  DateTime?

  @@index([restaurantId, createdAt])
}

/// A2: a size/option with its own absolute price (not a delta) -- "Small
/// 15 ILS, Large 22 ILS" rather than "+3 ILS for Large", simpler for an
/// owner to enter correctly and for a customer to read. An item with no
/// variants just sells at its own `price`; one with variants requires
/// picking one in the detail sheet before it can be added to the
/// selection (A1) -- there's no sensible default size to assume.
model ItemVariant {
  id String @id @default(cuid())

  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  itemId String
  item   Item   @relation(fields: [itemId], references: [id], onDelete: Cascade)

  nameAr String
  nameEn String

  price Decimal @db.Decimal(10, 2)

  sortOrder Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([restaurantId])
  @@index([itemId])
}

/// A2: an optional extra added on top of the item's (or its chosen
/// variant's) price -- "Extra cheese +3 ILS". Multiple add-ons can be
/// selected at once, unlike variants (pick exactly one size).
model ItemAddon {
  id String @id @default(cuid())

  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  itemId String
  item   Item   @relation(fields: [itemId], references: [id], onDelete: Cascade)

  nameAr String
  nameEn String

  price Decimal @db.Decimal(10, 2)

  sortOrder Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([restaurantId])
  @@index([itemId])
}

/// A printable QR target: scanning it opens the public menu with
/// ?table=<label> appended, so the page can show a "Table X" indicator.
/// Not used for ordering/seating logic -- this app has none -- purely a
/// label for which QR code is which when printing a batch of them.
model RestaurantTable {
  id String @id @default(cuid())

  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  label String

  /// What the table's QR code carries. Unguessable, so an order cannot be
  /// placed for a table by typing its name into the address.
  token String @unique @default(uuid())

  sortOrder Int @default(0)

  /// When the current visit began. Null means the table is free. Orders placed
  /// at or after this moment are the visit's bill; checkout clears it.
  occupiedAt      DateTime?
  /// The last time the guest's phone, an order or a call touched the table.
  /// A visit with no orders and no touch for 30 minutes counts as free.
  lastSeenAt      DateTime?
  billRequestedAt DateTime?

  orders      Order[]
  waiterCalls WaiterCall[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([restaurantId])
}

// ---------------------------------------------------------------------------
// SaaS: plans, subscriptions, payments, platform operators
// ---------------------------------------------------------------------------

enum BillingInterval {
  MONTHLY
  YEARLY
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  SUSPENDED
  CANCELED
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
  CARD
  OTHER
}

enum PaymentStatus {
  PAID
  VOID
}

/// What a restaurant can buy. A null limit means unlimited. Feature keys come
/// from src/tenancy/plan-features.ts.
model Plan {
  id String @id @default(cuid())

  nameAr        String
  nameEn        String
  descriptionAr String?
  descriptionEn String?

  priceAmount Decimal         @db.Decimal(10, 2)
  currency    String          @default("ILS")
  interval    BillingInterval @default(MONTHLY)
  trialDays   Int             @default(0)

  maxMenus      Int?
  maxCategories Int?
  maxItems      Int?
  maxAdminUsers Int?
  features      String[]

  /// Archived plans stay on the tenants that have them but cannot be chosen
  /// for new ones.
  isActive  Boolean @default(true)
  sortOrder Int     @default(0)

  subscriptions  Subscription[]
  signupRequests SignupRequest[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// One per restaurant. A null currentPeriodEnd means it never expires, which
/// is what internal and free accounts use.
model Subscription {
  id String @id @default(cuid())

  restaurantId String     @unique
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  planId String
  plan   Plan   @relation(fields: [planId], references: [id], onDelete: Restrict)

  status             SubscriptionStatus @default(TRIALING)
  trialEndsAt        DateTime?
  currentPeriodStart DateTime?
  currentPeriodEnd   DateTime?

  /// Days the menu stays up after the period ends, with a warning in the admin.
  graceDays       Int       @default(7)
  canceledAt      DateTime?
  suspendedReason String?
  note            String?

  payments Payment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([planId])
  @@index([status])
  @@index([currentPeriodEnd])
}

/// The manual ledger. Recording one extends the subscription. Voiding keeps the
/// row and never changes the period, so history stays honest.
model Payment {
  id String @id @default(cuid())

  /// Printed on the receipt as R-000042.
  receiptNo Int @unique @default(autoincrement())

  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  subscriptionId String
  subscription   Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  amount    Decimal       @db.Decimal(10, 2)
  currency  String
  method    PaymentMethod
  reference String?
  status    PaymentStatus @default(PAID)

  paidAt      DateTime
  periodStart DateTime
  periodEnd   DateTime
  periods     Int      @default(1)

  note       String?
  voidedAt   DateTime?
  voidReason String?

  recordedById String?
  recordedBy   SuperAdmin? @relation(fields: [recordedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([restaurantId, paidAt])
  @@index([paidAt])
}

/// Platform operators. Separate from AdminUser on purpose: a super admin
/// belongs to no restaurant, and a restaurant admin can never become one.
model SuperAdmin {
  id String @id @default(cuid())

  email        String @unique
  passwordHash String
  name         String

  /// Authenticator app secret, encrypted (see super-admin/totp-crypto.ts).
  totpSecretEnc String?
  totpEnabledAt DateTime?
  /// The last 30 second step accepted, so a code cannot be used twice.
  totpLastStep  Int?
  /// SHA-256 of each unused recovery code.
  recoveryCodes String[]

  passwordResets PasswordResetToken[]
  payments       Payment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Who did what to which tenant. restaurantId is not a foreign key so the
/// trail survives a tenant being removed.
model AuditLog {
  id String @id @default(cuid())

  actorType    String
  actorId      String?
  actorLabel   String?
  action       String
  restaurantId String?
  meta         Json?

  createdAt DateTime @default(now())

  @@index([restaurantId, createdAt])
  @@index([createdAt])
}

/// One use link to choose a new password. Only a hash of the token is kept, so a
/// copy of the database cannot be used to take over an account.
model PasswordResetToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  /// Exactly one of these is set: a restaurant owner or a platform operator.
  adminUserId String?
  adminUser   AdminUser? @relation(fields: [adminUserId], references: [id], onDelete: Cascade)

  superAdminId String?
  superAdmin   SuperAdmin? @relation(fields: [superAdminId], references: [id], onDelete: Cascade)

  @@index([adminUserId])
  @@index([superAdminId])
}

/// Counters for rate limits, shared by every instance. Rows disappear when their
/// window ends (see RateLimitModule).
model RateLimitBucket {
  key     String   @id
  count   Int
  resetAt DateTime

  @@index([resetAt])
}

// ---------------------------------------------------------------------------
// Table orders and waiter calls (the POS)
// ---------------------------------------------------------------------------

enum OrderStatus {
  NEW
  PREPARING
  READY
  SERVED
  CANCELED
}

enum WaiterCallKind {
  CALL
  BILL
}

enum WaiterCallStatus {
  OPEN
  ACKNOWLEDGED
  RESOLVED
}

/// An order a guest sent from a table. Prices and names are copied in when it
/// is placed, so editing the menu later never changes an order already taken.
model Order {
  id String @id @default(cuid())

  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  tableId    String?
  table      RestaurantTable? @relation(fields: [tableId], references: [id], onDelete: SetNull)
  tableLabel String

  number Int
  status OrderStatus @default(NEW)
  note   String?

  /// What the guest's phone holds to follow this one order. Random, so only
  /// the person who sent the order can look it up.
  publicToken String @unique @default(uuid())

  total    Decimal @db.Decimal(10, 2)
  currency String

  /// How far from the restaurant the guest was, when it was checked.
  distanceMeters Int?

  items OrderItem[]

  statusChangedAt   DateTime @default(now())
  statusChangedById String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([restaurantId, number])
  @@index([restaurantId, status, createdAt])
}

model OrderItem {
  id String @id @default(cuid())

  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  /// Not a foreign key: the dish may be deleted later, the order keeps its copy.
  itemId String?

  nameAr String
  nameEn String

  quantity  Int
  unitPrice Decimal @db.Decimal(10, 2)
  lineTotal Decimal @db.Decimal(10, 2)

  @@index([orderId])
}

model WaiterCall {
  id String @id @default(cuid())

  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  tableId    String?
  table      RestaurantTable? @relation(fields: [tableId], references: [id], onDelete: SetNull)
  tableLabel String

  status WaiterCallStatus @default(OPEN)
  kind   WaiterCallKind   @default(CALL)

  distanceMeters Int?

  acknowledgedAt DateTime?
  resolvedAt     DateTime?
  handledById    String?

  createdAt DateTime @default(now())

  @@index([restaurantId, status, createdAt])
}

/// One row per reminder already sent, so each one goes out once. The unique key
/// is claimed before sending, which is what stops two servers sending it twice.
model NotificationLog {
  id String @id @default(cuid())

  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  kind    String
  /// The day the notice is about (the end of the trial or of the paid period).
  /// After a renewal the date changes, so the next ending gets its own reminders.
  forDate DateTime @db.Date

  recipients Int      @default(0)
  sentAt     DateTime @default(now())

  @@unique([restaurantId, kind, forDate])
  @@index([restaurantId, sentAt])
}

/// A sign up waiting for the owner to confirm their email. Nothing exists for the
/// restaurant until then, so nobody can squat an address or fill the database with
/// restaurants. Only a hash of the link and of the password is kept.
model SignupRequest {
  id String @id @default(cuid())

  tokenHash    String @unique
  email        String
  ownerName    String
  passwordHash String

  nameAr String
  nameEn String
  slug   String

  planId String
  plan   Plan   @relation(fields: [planId], references: [id], onDelete: Cascade)

  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([email])
  @@index([slug])
  @@index([expiresAt])
}

/// "Goes well with": a dish the owner picked to suggest next to another one.
/// The order the owner gave is the order guests see.
model ItemPairing {
  id String @id @default(cuid())

  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  itemId String
  item   Item   @relation("PairingFrom", fields: [itemId], references: [id], onDelete: Cascade)

  pairedItemId String
  pairedItem   Item   @relation("PairingTo", fields: [pairedItemId], references: [id], onDelete: Cascade)

  sortOrder Int @default(0)

  @@unique([itemId, pairedItemId])
  @@index([restaurantId])
}

/// A guest tapped + on a suggestion. A count of taps for the owner's report, with
/// no link to the guest.
model SuggestionAdd {
  id String @id @default(cuid())

  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  itemId String
  item   Item   @relation(fields: [itemId], references: [id], onDelete: Cascade)

  /// pairing, together or popular: where the suggestion came from.
  reason String

  createdAt DateTime @default(now())

  @@index([restaurantId, createdAt])
}

/// A ready-made look the restaurant owner can start from (a season, an
/// occasion). Platform-wide, edited by the platform owner. Choosing one only
/// fills the owner's branding form; it is not stored on the restaurant.
model BrandTheme {
  id String @id @default(cuid())

  /// Short and stable: the branding page refers to a theme by it.
  key String @unique

  nameAr        String
  nameEn        String
  descriptionAr String?
  descriptionEn String?

  primaryColor      String
  secondaryColor    String
  backgroundColor   String
  fontTheme         String
  cornerStyle       String
  cardStyle         String
  buttonShape       String
  categoryDivider   String
  categoryMarker    String
  headingAlign      String
  priceStyle        String
  backgroundStyle   String
  backgroundPattern String
  themeDecor        String

  /// Archived themes are hidden from owners but kept.
  isActive  Boolean @default(true)
  sortOrder Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
