generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ItemTag {
  SPICY
  VEGETARIAN
  NEW
  POPULAR
}

model Restaurant {
  id String @id @default(cuid())

  slug String @unique

  nameAr String
  nameEn String

  descriptionAr String?
  descriptionEn String?

  logoPath String?

  whatsapp        String?
  instagramHandle String?

  workingHoursAr String?
  workingHoursEn String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  adminUsers AdminUser[]
  categories Category[]
  items      Item[]
  tables     RestaurantTable[]
  itemVariants ItemVariant[]
  itemAddons   ItemAddon[]
}

model AdminUser {
  id String @id @default(cuid())

  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  email        String @unique
  passwordHash String
  name         String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([restaurantId])
}

model Category {
  id String @id @default(cuid())

  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  nameAr String
  nameEn String

  sortOrder Int @default(0)

  items Item[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([restaurantId])
}

model Item {
  id String @id @default(cuid())

  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  categoryId String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  nameAr String
  nameEn String

  descriptionAr String?
  descriptionEn String?

  price    Decimal @db.Decimal(10, 2)
  currency String  @default("ILS")

  imagePath String?

  tags ItemTag[]

  available Boolean @default(true)
  sortOrder Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  variants ItemVariant[]
  addons   ItemAddon[]

  @@index([restaurantId])
  @@index([categoryId])
}

/// A2: a size/option with its own absolute price (not a delta) -- "Small
/// 15 ILS, Large 22 ILS" rather than "+3 ILS for Large", simpler for an
/// owner to enter correctly and for a customer to read. An item with no
/// variants just sells at its own `price`; one with variants requires
/// picking one in the detail sheet before it can be added to the
/// selection (A1) -- there's no sensible default size to assume.
model ItemVariant {
  id String @id @default(cuid())

  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  itemId String
  item   Item   @relation(fields: [itemId], references: [id], onDelete: Cascade)

  nameAr String
  nameEn String

  price Decimal @db.Decimal(10, 2)

  sortOrder Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([restaurantId])
  @@index([itemId])
}

/// A2: an optional extra added on top of the item's (or its chosen
/// variant's) price -- "Extra cheese +3 ILS". Multiple add-ons can be
/// selected at once, unlike variants (pick exactly one size).
model ItemAddon {
  id String @id @default(cuid())

  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  itemId String
  item   Item   @relation(fields: [itemId], references: [id], onDelete: Cascade)

  nameAr String
  nameEn String

  price Decimal @db.Decimal(10, 2)

  sortOrder Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([restaurantId])
  @@index([itemId])
}

/// A printable QR target: scanning it opens the public menu with
/// ?table=<label> appended, so the page can show a "Table X" indicator.
/// Not used for ordering/seating logic -- this app has none -- purely a
/// label for which QR code is which when printing a batch of them.
model RestaurantTable {
  id String @id @default(cuid())

  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  label String

  sortOrder Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([restaurantId])
}
