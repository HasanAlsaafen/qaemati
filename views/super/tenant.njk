{% extends "layouts/super.njk" %}
{% set section = 'restaurants' %}
{% from "components/input.njk" import input %}
{% from "components/select.njk" import select %}

{% block title %}{{ restaurant.nameEn }}{% endblock %}

{% block content %}
{% set v = flash.values if flash and flash.values else {} %}
{% set e = flash.errors if flash and flash.errors else {} %}
{% set fieldClass = 'min-h-11 rounded-md border border-border-strong bg-surface px-3 text-base text-text focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary' %}
{% set btn = 'inline-flex min-h-11 items-center justify-center rounded-md border border-border-strong px-4 text-sm font-medium text-text hover:bg-muted-surface focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary' %}

<p><a href="/super/restaurants" class="inline-flex min-h-11 items-center text-sm font-medium text-primary hover:underline">{{ t('common.super.nav.restaurants') }}</a></p>
<div class="flex flex-wrap items-start justify-between gap-3">
  <div>
    <h1 class="font-display text-2xl font-bold text-text">{{ restaurant.nameEn }} <span class="font-normal text-muted-text">{{ restaurant.nameAr }}</span></h1>
    <p class="text-sm text-muted-text" dir="ltr">/m/{{ restaurant.slug }}</p>
  </div>
  <a href="/m/{{ restaurant.slug }}" target="_blank" rel="noopener noreferrer" class="{{ btn }}">{{ t('common.super.tenants.openMenu') }}</a>
</div>

{% if not subscription %}
  <p class="mt-6 rounded-card border border-border bg-surface p-6 text-sm text-muted-text">{{ t('common.super.tenants.noSubscription') }}</p>
{% else %}
<div class="mt-6 grid gap-6 lg:grid-cols-2">
  <section class="rounded-card border border-border bg-surface p-4" aria-labelledby="sub-heading">
    <div class="flex flex-wrap items-center justify-between gap-2">
      <h2 id="sub-heading" class="font-display text-lg font-bold text-text">{{ t('common.super.tenants.subscription') }}</h2>
      <span class="inline-flex items-center rounded-sm px-2 py-0.5 text-xs font-medium {{ 'bg-success/10 text-success' if access.state == 'ok' else ('bg-primary-soft text-primary-text' if access.state == 'trial' else ('bg-warning/10 text-warning-text' if access.state == 'grace' else 'bg-danger/10 text-danger')) }}">{{ t('common.billing.access.' + access.state) }}</span>
    </div>
    <dl class="mt-3 grid grid-cols-2 gap-3 text-sm">
      <div><dt class="text-muted-text">{{ t('common.billing.page.status') }}</dt><dd class="font-medium text-text">{{ t('common.billing.status.' + subscription.status) }}</dd></div>
      <div><dt class="text-muted-text">{{ t('common.super.tenants.plan') }}</dt><dd class="font-medium text-text">{{ plan.nameEn if locale == 'en' else plan.nameAr }}</dd></div>
      <div><dt class="text-muted-text">{{ t('common.billing.page.trialEnds') }}</dt><dd class="font-medium text-text" dir="ltr">{{ (subscription.trialEndsAt | isoDate) or '-' }}</dd></div>
      <div><dt class="text-muted-text">{{ t('common.billing.page.periodEnds') }}</dt><dd class="font-medium text-text" dir="ltr">{{ (subscription.currentPeriodEnd | isoDate) or '-' }}</dd></div>
      {% if access.blockAt %}<div><dt class="text-muted-text">{{ t('common.billing.page.offlineOn') }}</dt><dd class="font-medium text-text" dir="ltr">{{ access.blockAt | isoDate }}</dd></div>{% endif %}
      {% if subscription.suspendedReason %}<div class="col-span-2"><dt class="text-muted-text">{{ t('common.super.tenants.reason') }}</dt><dd class="font-medium text-text">{{ subscription.suspendedReason }}</dd></div>{% endif %}
    </dl>

    <div class="mt-4 flex flex-wrap gap-2">
      <a href="/super/payments/new?restaurantId={{ restaurant.id }}" class="inline-flex min-h-11 items-center rounded-md bg-primary px-4 text-sm font-medium text-primary-on hover:bg-primary-hover">{{ t('common.super.payments.record') }}</a>
      {% if subscription.status == 'SUSPENDED' or subscription.status == 'CANCELED' %}
        <form method="post" action="/super/restaurants/{{ restaurant.id }}/status">
          <input type="hidden" name="csrf_token" value="{{ csrfToken }}"><input type="hidden" name="action" value="reactivate">
          <button type="submit" class="{{ btn }}">{{ t('common.super.tenants.reactivate') }}</button>
        </form>
      {% endif %}
    </div>

    {% if subscription.status != 'SUSPENDED' and subscription.status != 'CANCELED' %}
      <details class="mt-4 rounded-md border border-border p-3">
        <summary class="inline-flex min-h-11 cursor-pointer items-center text-sm font-medium text-danger">{{ t('common.super.tenants.suspendOrCancel') }}</summary>
        <form method="post" action="/super/restaurants/{{ restaurant.id }}/status" class="mt-3 flex flex-col gap-3">
          <input type="hidden" name="csrf_token" value="{{ csrfToken }}">
          {{ input(name='reason', label=t('common.super.tenants.reason'), value='', attrs='maxlength="200"') }}
          <div class="flex flex-wrap gap-2">
            <button type="submit" name="action" value="suspend" class="{{ btn }}">{{ t('common.super.tenants.suspend') }}</button>
            <button type="submit" name="action" value="cancel" class="{{ btn }} text-danger">{{ t('common.super.tenants.cancel') }}</button>
          </div>
          <p class="text-xs text-muted-text">{{ t('common.super.tenants.suspendHint') }}</p>
        </form>
      </details>
    {% endif %}
  </section>

  <section class="rounded-card border border-border bg-surface p-4" aria-labelledby="plan-heading">
    <h2 id="plan-heading" class="font-display text-lg font-bold text-text">{{ t('common.super.tenants.planAndLimits') }}</h2>
    <form method="post" action="/super/restaurants/{{ restaurant.id }}/plan" class="mt-3 flex flex-wrap items-end gap-3">
      <input type="hidden" name="csrf_token" value="{{ csrfToken }}">
      <div class="min-w-0 flex-1">
        {% set planOptions = [] %}
        {% for p in plans %}
          {% if p.isActive or p.id == subscription.planId %}
            {% set _added = planOptions.push({ value: p.id, label: (p.nameEn if locale == 'en' else p.nameAr) + ' (' + (p.priceAmount | money) + ' ' + p.currency + ')' + ('' if p.isActive else ' *') }) %}
          {% endif %}
        {% endfor %}
        {{ select('planId', t('common.super.tenants.plan'), planOptions, subscription.planId, e.planId) }}
      </div>
      <button type="submit" class="{{ btn }}">{{ t('common.super.tenants.changePlan') }}</button>
    </form>
    <ul class="mt-4 flex flex-col gap-2 text-sm">
      {% for r in ['menus', 'categories', 'items', 'adminUsers'] %}
        <li class="flex items-center justify-between gap-3">
          <span class="text-text">{{ t('common.billing.resource.' + r) }}</span>
          <span class="text-muted-text" dir="ltr">{{ usage[r] }} / {% if limits[r] is number %}{{ limits[r] }}{% else %}{{ t('common.billing.unlimited') }}{% endif %}</span>
        </li>
      {% endfor %}
    </ul>
  </section>
</div>

<details class="mt-6 rounded-card border border-border bg-surface p-4">
  <summary class="inline-flex min-h-11 cursor-pointer items-center font-display text-lg font-bold text-text">{{ t('common.super.tenants.dates') }}</summary>
  <form method="post" action="/super/restaurants/{{ restaurant.id }}/settings" class="mt-3 grid gap-4 sm:grid-cols-2">
    <input type="hidden" name="csrf_token" value="{{ csrfToken }}">
    {{ input(name='trialEndsAt', label=t('common.billing.page.trialEnds'), type='date', value=(subscription.trialEndsAt | isoDate), error=e.trialEndsAt, dir='ltr') }}
    {{ input(name='currentPeriodEnd', label=t('common.billing.page.periodEnds'), type='date', value=(subscription.currentPeriodEnd | isoDate), error=e.currentPeriodEnd, dir='ltr') }}
    {{ input(name='graceDays', label=t('common.super.tenants.graceDays'), type='number', value=subscription.graceDays, error=e.graceDays, hint=t('common.super.tenants.graceHint'), attrs='min="0" max="365" required') }}
    {{ input(name='note', label=t('common.super.tenants.note'), value=subscription.note or '', error=e.note, attrs='maxlength="500"') }}
    <div class="sm:col-span-2"><button type="submit" class="{{ btn }}">{{ t('common.admin.form.save') }}</button></div>
  </form>
</details>
{% endif %}

<section class="mt-6 rounded-card border border-border bg-surface p-4" aria-labelledby="admins-heading">
  <h2 id="admins-heading" class="font-display text-lg font-bold text-text">{{ t('common.super.tenants.admins') }}</h2>
  {% if e.admin %}<p class="mt-2 text-sm text-danger" role="alert">{{ e.admin }}</p>{% endif %}
  <ul class="mt-3 divide-y divide-border">
    {% for admin in restaurant.adminUsers %}
      <li class="flex flex-wrap items-center justify-between gap-3 py-2 text-sm">
        <div class="min-w-0"><p class="font-medium text-text">{{ admin.name }}</p><p class="text-muted-text" dir="ltr">{{ admin.email }}</p></div>
        <div class="flex flex-wrap gap-2">
          <form method="post" action="/super/restaurants/{{ restaurant.id }}/admins/{{ admin.id }}/reset-password"><input type="hidden" name="csrf_token" value="{{ csrfToken }}"><button type="submit" class="{{ btn }}">{{ t('common.super.tenants.resetPassword') }}</button></form>
          {% if restaurant.adminUsers.length > 1 %}
            <details>
              <summary class="{{ btn }} cursor-pointer list-none text-danger">{{ t('common.admin.form.delete') }}</summary>
              <form method="post" action="/super/restaurants/{{ restaurant.id }}/admins/{{ admin.id }}/remove" class="mt-2">
                <input type="hidden" name="csrf_token" value="{{ csrfToken }}">
                <button type="submit" class="{{ btn }} text-danger">{{ t('common.super.confirm') }}</button>
              </form>
            </details>
          {% endif %}
        </div>
      </li>
    {% endfor %}
  </ul>
  <form method="post" action="/super/restaurants/{{ restaurant.id }}/admins" class="mt-4 grid gap-4 border-t border-border pt-4 sm:grid-cols-3 sm:items-end">
    <input type="hidden" name="csrf_token" value="{{ csrfToken }}">
    {{ input(name='name', label=t('common.super.tenants.adminName'), value=v.name or '', error=e.name, attrs='required maxlength="120"') }}
    {{ input(name='email', label=t('common.admin.auth.emailLabel'), type='email', value=v.email or '', error=e.email, attrs='required autocomplete="off"') }}
    <button type="submit" class="{{ btn }}">{{ t('common.super.tenants.addAdmin') }}</button>
  </form>
</section>

<section class="mt-6 rounded-card border border-border bg-surface p-4" aria-labelledby="pay-heading">
  <h2 id="pay-heading" class="font-display text-lg font-bold text-text">{{ t('common.billing.page.payments') }}</h2>
  {% if restaurant.payments.length %}
    <ul class="mt-3 divide-y divide-border">
      {% for payment in restaurant.payments %}
        <li class="flex flex-wrap items-center justify-between gap-2 py-2 text-sm">
          <div>
            <p class="font-medium text-text" dir="ltr">{{ payment.amount | money }} {{ payment.currency | symbol(locale) }}{% if payment.status == 'VOID' %} <span class="ms-2 rounded-sm bg-muted-surface px-1.5 py-0.5 text-xs text-muted-text">{{ t('common.billing.page.void') }}</span>{% endif %}</p>
            <p class="text-muted-text" dir="ltr">{{ payment.paidAt | isoDate }} · {{ payment.receiptNo | receiptNo }} · {{ t('common.billing.method.' + payment.method) }}</p>
          </div>
          <a href="/super/payments/{{ payment.id }}/receipt" class="inline-flex min-h-11 items-center font-medium text-primary hover:underline">{{ t('common.billing.page.receipt') }}</a>
        </li>
      {% endfor %}
    </ul>
  {% else %}
    <p class="mt-3 text-sm text-muted-text">{{ t('common.billing.page.noPayments') }}</p>
  {% endif %}
</section>

<section class="mt-8 rounded-card border border-border bg-surface p-5" aria-labelledby="notices-heading">
  <h2 id="notices-heading" class="font-display text-lg font-bold text-text">{{ t('common.super.tenants.noticesTitle') }}</h2>
  {% if notices.length %}
    <ul class="mt-3 divide-y divide-border text-sm">
      {% for notice in notices %}
        <li class="flex flex-wrap items-baseline justify-between gap-2 py-2"><span class="text-text">{{ t('common.super.tenants.notice.' + notice.kind) }}</span><span class="text-muted-text" dir="ltr">{{ notice.forDate | isoDate }} · {{ notice.sentAt | isoDate }} · {{ notice.recipients }}</span></li>
      {% endfor %}
    </ul>
  {% else %}
    <p class="mt-3 text-sm text-muted-text">{{ t('common.super.tenants.noticesNone') }}</p>
  {% endif %}
</section>

<section class="mt-6 rounded-card border border-border bg-surface p-4" aria-labelledby="audit-heading">
  <h2 id="audit-heading" class="font-display text-lg font-bold text-text">{{ t('common.super.nav.audit') }}</h2>
  {% if audit.length %}
    <ul class="mt-3 divide-y divide-border text-sm">
      {% for entry in audit %}
        <li class="flex flex-wrap items-baseline justify-between gap-2 py-2"><span class="text-text" dir="ltr">{{ entry.action }}</span><span class="text-muted-text" dir="ltr">{{ entry.actorLabel }} · {{ entry.createdAt | isoDate }}</span></li>
      {% endfor %}
    </ul>
  {% else %}
    <p class="mt-3 text-sm text-muted-text">{{ t('common.super.audit.none') }}</p>
  {% endif %}
</section>
{% endblock %}
