{% extends "layouts/base.njk" %}
{% from "components/input.njk" import input %}
{% from "components/button.njk" import button %}

{% block title %}{{ t('common.super.security.verifyTitle') }}{% endblock %}

{% block content %}
<div class="mx-auto max-w-sm rounded-card border border-border bg-surface p-8">
  <p class="text-xs font-bold uppercase tracking-wide text-muted-text">{{ t('common.super.platform') }}</p>
  <h1 class="mt-1 font-display text-2xl font-bold text-text">{{ t('common.super.security.verifyTitle') }}</h1>
  <p class="mt-2 text-sm text-muted-text">{{ t('common.super.security.verifyIntro') }}</p>
  {% if error %}
    <p class="mt-4 rounded-md bg-danger/10 px-3 py-2 text-sm text-danger" role="alert">{{ error }}</p>
  {% endif %}
  <form method="post" action="/super/login/verify" class="mt-6 flex flex-col gap-4">
    <input type="hidden" name="csrf_token" value="{{ csrfToken }}">
    {{ input('code', t('common.super.security.codeLabel'), 'text', '', '', none, t('common.super.security.codeHint'), 'required autocomplete="one-time-code" inputmode="text" autofocus', 'ltr') }}
    {{ button(t('common.super.security.verifySubmit'), 'primary', 'md', 'submit') }}
  </form>
  <a href="/super/login" class="mt-4 inline-flex min-h-11 items-center text-sm font-medium text-primary hover:underline">{{ t('common.admin.auth.backToLogin') }}</a>
</div>
{% endblock %}
