{% extends "layouts/super.njk" %}
{% from "components/input.njk" import input %}
{% from "components/button.njk" import button %}

{% block title %}{{ t('common.super.nav.security') }}{% endblock %}

{% block content %}
<h1 class="font-display text-2xl font-bold text-text">{{ t('common.super.nav.security') }}</h1>

<section class="mt-6 rounded-card border border-border bg-surface p-5" aria-labelledby="tf-title">
  <div class="flex flex-wrap items-center justify-between gap-3">
    <h2 id="tf-title" class="font-display text-lg font-bold text-text">{{ t('common.super.security.twoFactorTitle') }}</h2>
    <span class="rounded-full px-3 py-1 text-xs font-bold {{ 'bg-success/10 text-success' if enabled else 'bg-warning/10 text-warning-text' }}">{{ t('common.super.security.on') if enabled else t('common.super.security.off') }}</span>
  </div>
  <p class="mt-2 text-sm text-muted-text">{{ t('common.super.security.twoFactorIntro') }}</p>
  {% if required and not enabled %}
    <p class="mt-3 rounded-md bg-warning/10 px-3 py-2 text-sm text-warning-text" role="status">{{ t('common.super.security.mustEnable') }}</p>
  {% endif %}

  {% if not enabled %}
    <a href="/super/security/setup" class="mt-4 inline-flex min-h-11 items-center rounded-md bg-primary px-4 text-sm font-medium text-primary-on hover:bg-primary-hover">{{ t('common.super.security.setupButton') }}</a>
  {% else %}
    <p class="mt-3 text-sm text-text">{{ t('common.super.security.recoveryLeft', { count: recoveryLeft }) }}</p>
    <form method="post" action="/super/security/recovery" class="mt-4 flex flex-col gap-3 sm:max-w-sm">
      <input type="hidden" name="csrf_token" value="{{ csrfToken }}">
      {{ input('code', t('common.super.security.codeLabel'), 'text', '', '', none, t('common.super.security.renewHint'), 'required autocomplete="one-time-code"', 'ltr') }}
      {{ button(t('common.super.security.renewButton'), 'secondary', 'md', 'submit') }}
    </form>
    {% if not required %}
      <form method="post" action="/super/security/disable" class="mt-6 flex flex-col gap-3 border-t border-border pt-4 sm:max-w-sm">
        <input type="hidden" name="csrf_token" value="{{ csrfToken }}">
        <h3 class="text-sm font-bold text-text">{{ t('common.super.security.disableTitle') }}</h3>
        {{ input('password', t('common.admin.auth.passwordLabel'), 'password', '', '', none, none, 'required autocomplete="current-password"') }}
        {{ input('code', t('common.super.security.codeLabel'), 'text', '', '', none, none, 'required autocomplete="one-time-code"', 'ltr') }}
        {{ button(t('common.super.security.disableButton'), 'secondary', 'md', 'submit') }}
      </form>
    {% endif %}
  {% endif %}
</section>

<section class="mt-6 rounded-card border border-border bg-surface p-5" aria-labelledby="pw-title">
  <h2 id="pw-title" class="font-display text-lg font-bold text-text">{{ t('common.super.security.passwordTitle') }}</h2>
  <p class="mt-2 text-sm text-muted-text">{{ t('common.super.security.passwordIntro') }}</p>
  <form method="post" action="/super/security/password" class="mt-4 flex flex-col gap-3 sm:max-w-sm">
    <input type="hidden" name="csrf_token" value="{{ csrfToken }}">
    {{ input('current', t('common.super.security.currentPassword'), 'password', '', '', none, none, 'required autocomplete="current-password"') }}
    {{ input('password', t('common.admin.auth.newPassword'), 'password', '', '', none, t('common.admin.auth.passwordHintMin', { min: 12 }), 'required minlength="12" autocomplete="new-password"') }}
    {{ input('confirm', t('common.admin.auth.confirmPassword'), 'password', '', '', none, none, 'required minlength="12" autocomplete="new-password"') }}
    {{ button(t('common.admin.auth.resetSubmit'), 'secondary', 'md', 'submit') }}
  </form>
</section>
{% endblock %}
