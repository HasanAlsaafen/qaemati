{% extends "layouts/super.njk" %}
{% set section = 'restaurants' %}
{% from "components/input.njk" import input %}

{% block title %}{{ t('common.super.nav.restaurants') }}{% endblock %}

{% block content %}
<div class="flex flex-wrap items-center justify-between gap-3">
  <h1 class="font-display text-2xl font-bold text-text">{{ t('common.super.nav.restaurants') }}</h1>
  <a href="/super/restaurants/new" class="inline-flex min-h-11 items-center rounded-md bg-primary px-4 text-sm font-medium text-primary-on hover:bg-primary-hover">{{ t('common.super.tenants.add') }}</a>
</div>

<form method="get" action="/super/restaurants" class="mt-4 flex flex-wrap items-end gap-3">
  <div class="flex min-w-0 flex-1 flex-col gap-1.5">
    <label for="tenants-q" class="text-sm font-medium text-text">{{ t('common.super.tenants.search') }}</label>
    <input id="tenants-q" name="q" type="search" value="{{ q }}" class="min-h-11 rounded-md border border-border-strong bg-surface px-3 text-base text-text focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary">
  </div>
  <div class="flex flex-col gap-1.5">
    <label for="tenants-state" class="text-sm font-medium text-text">{{ t('common.super.tenants.state') }}</label>
    <select id="tenants-state" name="state" class="min-h-11 rounded-md border border-border-strong bg-surface px-3 text-base text-text focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary">
      <option value="">{{ t('common.super.all') }}</option>
      {% for s in ['ok', 'trial', 'grace', 'blocked'] %}
        <option value="{{ s }}" {% if state == s %}selected{% endif %}>{{ t('common.billing.access.' + s) }}</option>
      {% endfor %}
    </select>
  </div>
  <button type="submit" class="inline-flex min-h-11 items-center rounded-md border border-border-strong px-4 text-sm font-medium text-text hover:bg-muted-surface">{{ t('common.super.filter') }}</button>
</form>

{% if rows.length %}
  <ul class="mt-4 divide-y divide-border rounded-card border border-border bg-surface">
    {% for row in rows %}
      <li class="flex flex-wrap items-center justify-between gap-3 px-4 py-3">
        <div class="min-w-0">
          <a href="/super/restaurants/{{ row.id }}" class="inline-flex min-h-11 items-center font-medium text-primary hover:underline">{{ row.nameEn }} <span class="ms-2 font-normal text-muted-text">{{ row.nameAr }}</span></a>
          <p class="text-xs text-muted-text" dir="ltr">/m/{{ row.slug }}</p>
        </div>
        <div class="flex flex-wrap items-center gap-x-4 gap-y-1 text-sm">
          <span class="text-muted-text">{% if row.planName %}{{ row.planName.en if locale == 'en' else row.planName.ar }}{% else %}{{ t('common.super.tenants.noPlan') }}{% endif %}</span>
          <span class="inline-flex items-center rounded-sm px-2 py-0.5 text-xs font-medium {{ 'bg-success/10 text-success' if row.state == 'ok' else ('bg-primary-soft text-primary-text' if row.state == 'trial' else ('bg-warning/10 text-warning-text' if row.state == 'grace' else 'bg-danger/10 text-danger')) }}">{{ t('common.billing.access.' + row.state) }}</span>
          <span class="text-muted-text" dir="ltr">{% if row.endsAt %}{{ row.endsAt | isoDate }}{% else %}-{% endif %}</span>
        </div>
      </li>
    {% endfor %}
  </ul>
{% else %}
  <p class="mt-6 rounded-card border border-border bg-surface p-6 text-sm text-muted-text">{{ t('common.super.tenants.none') }}</p>
{% endif %}
{% endblock %}
