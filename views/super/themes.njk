{% extends "layouts/super.njk" %}
{% set section = 'themes' %}

{% block title %}{{ t('common.super.nav.themes') }}{% endblock %}

{% block content %}
<div class="flex flex-wrap items-center justify-between gap-3">
  <h1 class="font-display text-2xl font-bold text-text">{{ t('common.super.nav.themes') }}</h1>
  <a href="/super/themes/new" class="inline-flex min-h-11 items-center rounded-md bg-primary px-4 text-sm font-medium text-primary-on hover:bg-primary-hover">{{ t('common.super.themes.add') }}</a>
</div>
<p class="mt-2 max-w-2xl text-sm text-muted-text">{{ t('common.super.themes.intro') }}</p>

<ul class="mt-4 grid gap-4 sm:grid-cols-2 xl:grid-cols-3">
  {% for theme in themes %}
    <li class="flex flex-col rounded-card border border-border bg-surface p-4 {{ 'bg-muted-surface' if not theme.isActive }}">
      <div class="flex items-start justify-between gap-3">
        <div>
          <h2 class="font-display text-lg font-bold text-text">{{ theme.nameEn if locale == 'en' else theme.nameAr }}</h2>
          <p class="text-xs text-muted-text" dir="ltr">{{ theme.key }}</p>
        </div>
        {% if not theme.isActive %}<span class="rounded-sm bg-muted-surface px-2 py-0.5 text-xs text-muted-text">{{ t('common.super.themes.archived') }}</span>{% endif %}
      </div>
      <span class="mt-3 flex w-fit overflow-hidden rounded-full border border-border" aria-hidden="true" dir="ltr">
        <span class="h-7 w-9" style="background: {{ theme.primaryColor }}"></span>
        <span class="h-7 w-9" style="background: {{ theme.secondaryColor }}"></span>
        <span class="h-7 w-9" style="background: {{ theme.backgroundColor }}"></span>
      </span>
      <p class="mt-3 text-sm text-muted-text">{{ (theme.descriptionEn if locale == 'en' else theme.descriptionAr) or '' }}</p>
      <p class="mt-2 text-xs text-muted-text" dir="ltr">{{ theme.fontTheme }} · {{ theme.cardStyle }} · {{ theme.themeDecor }}</p>
      <div class="mt-4 flex flex-wrap gap-2">
        <a href="/super/themes/{{ theme.id }}" class="inline-flex min-h-11 items-center rounded-md border border-border-strong px-4 text-sm font-medium text-text hover:bg-muted-surface">{{ t('common.admin.form.edit') }}</a>
        <form method="post" action="/super/themes/{{ theme.id }}/{{ 'archive' if theme.isActive else 'restore' }}">
          <input type="hidden" name="csrf_token" value="{{ csrfToken }}">
          <button type="submit" class="inline-flex min-h-11 items-center rounded-md border border-border-strong px-4 text-sm font-medium text-text hover:bg-muted-surface">{{ t('common.super.themes.archive') if theme.isActive else t('common.super.themes.restore') }}</button>
        </form>
      </div>
    </li>
  {% endfor %}
</ul>
{% endblock %}
