{% macro emptyState(title, description, actionLabel=none, actionHref=none) %}
  <div class="flex flex-col items-center gap-2 rounded-lg border border-dashed border-border p-8 text-center">
    <h3 class="font-display text-lg font-semibold text-text">{{ title }}</h3>
    <p class="max-w-sm text-sm text-muted-text">{{ description }}</p>
    {% if actionLabel and actionHref %}
      <a
        href="{{ actionHref }}"
        class="mt-2 inline-flex min-h-11 items-center justify-center rounded-md bg-primary px-4 text-sm font-medium text-primary-on hover:bg-primary-hover focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary"
      >
        {{ actionLabel }}
      </a>
    {% endif %}
  </div>
{% endmacro %}
