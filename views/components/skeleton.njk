{#
  Skeleton loading placeholders. Use skeletonLine for a single text line,
  skeletonCard for a menu-item-card-shaped placeholder.
#}
{% macro skeletonLine(widthClass='w-full') %}
  <span class="block h-4 {{ widthClass }} animate-pulse rounded-sm bg-muted-surface" aria-hidden="true"></span>
{% endmacro %}

{% macro skeletonCard() %}
  <div class="flex w-full items-start gap-3 rounded-lg border border-border bg-surface p-3" aria-hidden="true">
    <span class="h-20 w-20 shrink-0 animate-pulse rounded-md bg-muted-surface"></span>
    <span class="flex min-w-0 flex-1 flex-col gap-2 pt-1">
      <span class="h-4 w-2/3 animate-pulse rounded-sm bg-muted-surface"></span>
      <span class="h-3 w-full animate-pulse rounded-sm bg-muted-surface"></span>
      <span class="h-3 w-5/6 animate-pulse rounded-sm bg-muted-surface"></span>
    </span>
  </div>
{% endmacro %}
