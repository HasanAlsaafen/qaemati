{#
  Toggle switch built on a native checkbox for built-in keyboard and screen
  reader support, visually styled as a track/thumb switch.
#}
{% macro toggle(name, label, checked=false, attrs='') %}
  {% set fieldId = 'field-' + name %}
  <label for="{{ fieldId }}" class="inline-flex min-h-11 cursor-pointer items-center gap-3">
    <span class="relative inline-flex h-6 w-11 shrink-0 items-center">
      <input
        type="checkbox"
        id="{{ fieldId }}"
        name="{{ name }}"
        role="switch"
        {% if checked %}checked{% endif %}
        class="peer sr-only"
        {{ attrs | safe }}
      >
      <span class="pointer-events-none absolute inset-0 rounded-full bg-border-strong transition-colors duration-fast ease-standard peer-checked:bg-primary peer-focus-visible:outline peer-focus-visible:outline-2 peer-focus-visible:outline-offset-2 peer-focus-visible:outline-primary"></span>
      <span class="pointer-events-none absolute start-0.5 top-0.5 h-5 w-5 rounded-full bg-surface shadow-raised transition-transform duration-fast ease-standard peer-checked:translate-x-5 rtl:peer-checked:-translate-x-5"></span>
    </span>
    <span class="text-sm font-medium text-text">{{ label }}</span>
  </label>
{% endmacro %}
