{% from "components/badge.njk" import badge %}

{#
  item: { id, name, description, priceFormatted, currency, imageUrl, tags: [{label, variant}], available }
  Tapping the main area dispatches "open-item-sheet" on window with the
  full item as the event payload; components/item-detail-sheet.njk
  (included once per page) listens for it and renders the shared bottom
  sheet. data-item holds the same payload as JSON so the client-side
  search script (public/js/menu.js) doesn't need a second data source.

  The root changed from a single <button> to a <div> (A1) so a separate
  "+" add-to-selection button can sit beside the detail-opening button
  without nesting one button inside another (invalid HTML). Hidden
  entirely when the restaurant has no WhatsApp number or the item is
  unavailable -- there'd be nothing to add it *to* send, and nothing to
  add if it can't be served.
#}
{% macro menuItemCard(item, unavailableLabel, selectionLabels, hasWhatsapp, fromPriceLabel, placeholderUrl=none) %}
  {# The search script hides whole cells by [data-menu-item], so everything
     that belongs to a dish lives inside this wrapper. #}
  <div data-menu-item="true" data-search-text="{{ item.searchText }}" data-tags="{{ item.tagCodes }}">
  <div class="menu-item-card relative flex h-full flex-col overflow-hidden rounded-card border border-border bg-surface {{ 'opacity-60' if not item.available }}">
    <button
      type="button"
      x-data
      x-on:click="$dispatch('open-item-sheet', JSON.parse($el.dataset.item))"
      class="flex flex-1 flex-col text-start focus-visible:outline focus-visible:outline-2 focus-visible:-outline-offset-2 focus-visible:outline-primary"
      data-item="{{ item | dump }}"
      {% if not item.available %}aria-disabled="true"{% endif %}
    >
      <span class="menu-item-card__image {{ 'menu-item-card__image--empty' if not item.imageUrl }} relative block aspect-[4/3] w-full overflow-hidden bg-muted-surface">
        {% if item.imageUrl %}
          <img src="{{ item.imageUrl }}" alt="" loading="lazy" decoding="async" width="400" height="300" class="h-full w-full object-cover">
        {% elif placeholderUrl %}
          <img src="{{ placeholderUrl }}" alt="" loading="lazy" decoding="async" width="400" height="300" class="h-full w-full object-contain p-6 opacity-80">
        {% else %}
          <span class="flex h-full w-full items-center justify-center text-muted-text">
            <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M7 3v8a2 2 0 0 0 2 2v8M11 3v6M7 7h4M17 3c-2 2-3 5-3 8h3v10" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </span>
        {% endif %}
      </span>
      <span class="flex flex-1 flex-col gap-1 p-3 sm:p-4">
        <span class="line-clamp-2 font-display text-sm font-bold leading-heading text-text">{{ item.name }}</span>
        {% if item.fromPriceFormatted %}
          <span dir="ltr" class="menu-price text-start font-display text-sm font-bold text-primary">{{ fromPriceLabel }} {{ item.fromPriceFormatted }} {{ item.currencySymbol }}</span>
        {% else %}
          <span dir="ltr" class="menu-price text-start font-display text-sm font-bold text-primary">{{ item.priceFormatted }} {{ item.currencySymbol }}</span>
        {% endif %}
        {% if item.description %}
          <span class="menu-item-card__description line-clamp-2 text-xs leading-body text-muted-text">{{ item.description }}</span>
        {% endif %}
        {% if item.tags and item.tags.length or not item.available %}
          <span class="mt-1 flex flex-wrap gap-1">
            {% if not item.available %}
              {{ badge(unavailableLabel, 'neutral') }}
            {% endif %}
            {% for tag in item.tags %}
              {{ badge(tag.label, tag.variant) }}
            {% endfor %}
          </span>
        {% endif %}
      </span>
    </button>

    {% if hasWhatsapp and item.available %}
      {# Sits on the photo corner so it never collides with the name or price. #}
      {% set addButtonClass = 'absolute end-2 top-2 inline-flex h-11 w-11 items-center justify-center rounded-full border border-border bg-surface text-text hover:bg-muted-surface focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary' %}
      {% if item.variants.length %}
        {# A2: an item with sizes has no single price to quick-add at, so
           the plus opens the detail sheet to pick one, same destination as
           tapping the card. #}
        <button
          type="button"
          x-data
          x-on:click="$dispatch('open-item-sheet', JSON.parse($el.closest('[data-menu-item]').querySelector('[data-item]').dataset.item))"
          aria-label="{{ item.addAriaLabel }}"
          class="{{ addButtonClass }}"
        >
          <svg width="18" height="18" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M8 3v10M3 8h10" stroke-linecap="round"/></svg>
        </button>
      {% else %}
        <button
          type="button"
          x-data
          x-on:click="$store.selection.add({
            id: {{ item.id | dump }},
            name: {{ item.name | dump }},
            price: {{ item.price | dump }},
            priceFormatted: {{ item.priceFormatted | dump }},
            currency: {{ item.currency | dump }},
            currencySymbol: {{ item.currencySymbol | dump }},
            addedToastMessage: {{ selectionLabels.addedToast | dump }},
          })"
          aria-label="{{ item.addAriaLabel }}"
          class="{{ addButtonClass }}"
        >
          <svg width="18" height="18" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M8 3v10M3 8h10" stroke-linecap="round"/></svg>
        </button>
      {% endif %}
    {% endif %}
  </div>
  </div>
{% endmacro %}
