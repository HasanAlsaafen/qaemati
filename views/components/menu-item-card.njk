{% from "components/badge.njk" import badge %}

{#
  item: { id, name, description, priceFormatted, currency, imageUrl, tags: [{label, variant}], available }
  Tapping the card dispatches "open-item-sheet" on window with the full item
  as the event payload; components/item-detail-sheet.njk (included once per
  page) listens for it and renders the shared bottom sheet. data-item holds
  the same payload as JSON so the client-side search script
  (public/js/menu.js) doesn't need a second data source.
#}
{% macro menuItemCard(item, unavailableLabel) %}
  <button
    type="button"
    x-data
    x-on:click="$dispatch('open-item-sheet', JSON.parse($el.dataset.item))"
    class="flex w-full items-start gap-3 rounded-lg border border-border bg-surface p-3 text-start transition-colors duration-fast ease-standard hover:bg-muted-surface focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary {{ 'opacity-60' if not item.available }}"
    data-menu-item="true"
    data-search-text="{{ item.searchText }}"
    data-item="{{ item | dump }}"
    {% if not item.available %}aria-disabled="true"{% endif %}
  >
    <span class="relative h-20 w-20 shrink-0 overflow-hidden rounded-md bg-muted-surface">
      <img
        src="{{ item.imageUrl }}"
        alt=""
        loading="lazy"
        width="80"
        height="80"
        class="h-full w-full object-cover"
      >
    </span>
    <span class="flex min-w-0 flex-1 flex-col gap-1">
      <span class="flex items-start justify-between gap-2">
        <span class="truncate font-sans text-base font-bold leading-heading text-text">{{ item.name }}</span>
        <span dir="ltr" class="shrink-0 text-base font-bold text-text">{{ item.priceFormatted }} {{ item.currency }}</span>
      </span>
      {% if item.description %}
        <span class="line-clamp-2 text-sm leading-body text-muted-text">{{ item.description }}</span>
      {% endif %}
      {% if item.tags and item.tags.length or not item.available %}
        <span class="mt-1 flex flex-wrap gap-1.5">
          {% if not item.available %}
            {{ badge(unavailableLabel, 'neutral') }}
          {% endif %}
          {% for tag in item.tags %}
            {{ badge(tag.label, tag.variant) }}
          {% endfor %}
        </span>
      {% endif %}
    </span>
  </button>
{% endmacro %}
