{% from "components/badge.njk" import badge %}

{#
  item: { id, name, description, priceFormatted, currency, imageUrl, tags: [{label, variant}], available }
  Tapping the main area dispatches "open-item-sheet" on window with the
  full item as the event payload; components/item-detail-sheet.njk
  (included once per page) listens for it and renders the shared bottom
  sheet. data-item holds the same payload as JSON so the client-side
  search script (public/js/menu.js) doesn't need a second data source.

  The root changed from a single <button> to a <div> (A1) so a separate
  "+" add-to-selection button can sit beside the detail-opening button
  without nesting one button inside another (invalid HTML). Hidden
  entirely when the restaurant has no WhatsApp number or the item is
  unavailable -- there'd be nothing to add it *to* send, and nothing to
  add if it can't be served.
#}
{% macro menuItemCard(item, unavailableLabel, selectionLabels, hasWhatsapp, fromPriceLabel) %}
  <div
    class="menu-item-card flex w-full items-start gap-3 rounded-lg border border-border bg-surface p-3 {{ 'opacity-60' if not item.available }}"
    data-menu-item="true"
    data-search-text="{{ item.searchText }}"
  >
    <button
      type="button"
      x-data
      x-on:click="$dispatch('open-item-sheet', JSON.parse($el.dataset.item))"
      class="flex min-w-0 flex-1 items-start gap-3 rounded-md text-start transition-colors duration-fast ease-standard hover:bg-muted-surface focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary"
      data-item="{{ item | dump }}"
      {% if not item.available %}aria-disabled="true"{% endif %}
    >
      <span class="menu-item-card__image relative h-20 w-20 shrink-0 overflow-hidden rounded-md bg-muted-surface">
        <img
          src="{{ item.imageUrl }}"
          alt=""
          loading="lazy"
          width="80"
          height="80"
          class="h-full w-full object-cover"
        >
      </span>
      <span class="flex min-w-0 flex-1 flex-col gap-1">
        <span class="flex items-start justify-between gap-2">
          <span class="truncate font-sans text-base font-bold leading-heading text-text">{{ item.name }}</span>
          {% if item.fromPriceFormatted %}
            <span dir="ltr" class="shrink-0 text-base font-bold text-text">{{ fromPriceLabel }} {{ item.fromPriceFormatted }} {{ item.currency }}</span>
          {% else %}
            <span dir="ltr" class="shrink-0 text-base font-bold text-text">{{ item.priceFormatted }} {{ item.currency }}</span>
          {% endif %}
        </span>
        {% if item.description %}
          <span class="menu-item-card__description line-clamp-2 text-sm leading-body text-muted-text">{{ item.description }}</span>
        {% endif %}
        {% if item.tags and item.tags.length or not item.available %}
          <span class="mt-1 flex flex-wrap gap-1.5">
            {% if not item.available %}
              {{ badge(unavailableLabel, 'neutral') }}
            {% endif %}
            {% for tag in item.tags %}
              {{ badge(tag.label, tag.variant) }}
            {% endfor %}
          </span>
        {% endif %}
      </span>
    </button>

    {% if hasWhatsapp and item.available %}
      {% if item.variants.length %}
        {# A2: an item with sizes has no single price to quick-add at --
           tapping "+" opens the detail sheet to pick one instead, same
           destination as tapping the card itself. #}
        <button
          type="button"
          x-data
          x-on:click="$dispatch('open-item-sheet', JSON.parse($el.closest('[data-menu-item]').querySelector('[data-item]').dataset.item))"
          aria-label="{{ item.addAriaLabel }}"
          class="inline-flex h-11 w-11 shrink-0 items-center justify-center self-center rounded-full border border-border-strong text-text hover:bg-muted-surface focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary"
        >
          <svg width="18" height="18" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M8 3v10M3 8h10" stroke-linecap="round"/></svg>
        </button>
      {% else %}
        <button
          type="button"
          x-data
          x-on:click="$store.selection.add({
            id: {{ item.id | dump }},
            name: {{ item.name | dump }},
            price: {{ item.price | dump }},
            priceFormatted: {{ item.priceFormatted | dump }},
            currency: {{ item.currency | dump }},
            addedToastMessage: {{ selectionLabels.addedToast | dump }},
          })"
          aria-label="{{ item.addAriaLabel }}"
          class="inline-flex h-11 w-11 shrink-0 items-center justify-center self-center rounded-full border border-border-strong text-text hover:bg-muted-surface focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary"
        >
          <svg width="18" height="18" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M8 3v10M3 8h10" stroke-linecap="round"/></svg>
        </button>
      {% endif %}
    {% endif %}
  </div>
{% endmacro %}
