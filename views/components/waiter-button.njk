{#
  "Call waiter": always in reach on a table menu, above the selection bar when
  that is showing. It posts to the server, which checks the table and where the
  guest is, and the staff screen sounds an alarm until someone answers.
#}
{% macro waiterButton(tableOrder, tableLabel, orderLabels, lang) %}
  <div
    class="print:hidden"
    x-data="{ ...tableOrderState({{ { slug: tableOrder.slug, token: tableOrder.token, locationCheck: tableOrder.locationCheck, tableLabel: tableLabel, labels: orderLabels, live: true, lang: lang } | dump }}) }"
  >
    <button
      type="button"
      x-on:click="callWaiter()"
      x-bind:disabled="calling"
      x-bind:class="$store.selection.count > 0 ? 'bottom-20' : 'bottom-4'"
      class="fixed end-4 z-30 inline-flex min-h-11 items-center gap-2 rounded-full border border-border-strong bg-surface px-4 text-sm font-medium text-text shadow-overlay hover:bg-muted-surface focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary disabled:opacity-60"
    >
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 17h12l-1.5-2V10a4.5 4.5 0 0 0-9 0v5z"/><path d="M10 20a2 2 0 0 0 4 0"/></svg>
      <span x-text="orderText.callWaiter"></span>
    </button>

    <button
      type="button"
      x-on:click="openBill()"
      x-bind:class="$store.selection.count > 0 ? 'bottom-20' : 'bottom-4'"
      class="fixed start-4 z-30 inline-flex min-h-11 items-center gap-2 rounded-full border border-border-strong bg-surface px-4 text-sm font-medium text-text shadow-overlay hover:bg-muted-surface focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary"
    >
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 3h12v18l-3-2-3 2-3-2-3 2z"/><path d="M9 8h6M9 12h6"/></svg>
      <span x-text="orderText.myBill"></span>
    </button>

    <div
      x-show="billOpen"
      x-cloak
      x-on:keydown.escape.window="closeBill()"
      class="fixed inset-0 z-50 flex items-end justify-center bg-black/40 sm:items-center"
      x-on:click.self="closeBill()"
    >
      <div role="dialog" aria-modal="true" aria-labelledby="bill-title" class="flex max-h-[85vh] w-full max-w-md flex-col rounded-t-2xl bg-surface p-5 shadow-overlay sm:rounded-2xl">
        <div class="flex items-center justify-between gap-3">
          <h2 id="bill-title" class="font-sans text-lg font-bold text-text">{{ orderLabels.billTitle }} · {{ orderLabels.tableLine | replace('{label}', tableLabel) }}</h2>
          <button type="button" x-on:click="closeBill()" aria-label="{{ orderLabels.done }}" class="inline-flex h-11 w-11 items-center justify-center rounded-full text-text hover:bg-muted-surface focus-visible:outline focus-visible:outline-2 focus-visible:outline-primary">×</button>
        </div>

        <div class="mt-3 min-h-0 flex-1 overflow-y-auto" aria-live="polite">
          <p x-show="billClosed" x-cloak class="rounded-md bg-muted-surface p-3 text-sm text-text">{{ orderLabels.billClosed }}</p>
          <p x-show="!billClosed && !bill" class="text-sm text-muted-text">{{ orderLabels.billLoading }}</p>
          <p x-show="!billClosed && bill && bill.orders.length === 0" x-cloak class="text-sm text-muted-text">{{ orderLabels.billEmpty }}</p>
          <template x-if="!billClosed && bill && bill.orders.length > 0">
            <ul class="flex flex-col gap-4">
              <template x-for="order in bill.orders" x-bind:key="order.number">
                <li>
                  <p class="text-sm font-medium text-text" x-text="orderText.billOrder.split('{number}').join(order.number)"></p>
                  <ul class="mt-1 flex flex-col gap-1 text-sm text-text">
                    <template x-for="(line, i) in order.items" x-bind:key="i">
                      <li class="flex justify-between gap-3"><span><span dir="ltr" x-text="line.quantity + ' ×'"></span> <span x-text="itemName(line)"></span></span><span dir="ltr" x-text="line.lineTotal"></span></li>
                    </template>
                  </ul>
                </li>
              </template>
            </ul>
          </template>
        </div>

        <div x-show="!billClosed && bill && bill.orders.length > 0" x-cloak class="mt-4 border-t border-border pt-3">
          <p class="flex justify-between font-sans text-lg font-bold text-text"><span>{{ orderLabels.billTotal }}</span><span dir="ltr" x-text="bill ? bill.total + ' ' + bill.currency : ''"></span></p>
          <p x-show="bill && bill.billRequested" x-cloak class="mt-3 rounded-md bg-success/10 p-3 text-sm text-text">{{ orderLabels.billAsked }}</p>
          <button type="button" x-show="bill && !bill.billRequested" x-cloak x-on:click="askBill()" x-bind:disabled="billBusy" class="mt-3 inline-flex min-h-11 w-full items-center justify-center rounded-md bg-primary px-4 text-sm font-medium text-primary-on hover:bg-primary-hover focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary disabled:opacity-60">{{ orderLabels.askBill }}</button>
        </div>
      </div>
    </div>
  </div>
{% endmacro %}
