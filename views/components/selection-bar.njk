{% from "components/empty-state.njk" import emptyState %}

{#
  A1: "My selection" -- a floating bar (shown once the customer has added
  at least one item) that opens a bottom sheet listing the selection, with
  a note field and a "Send on WhatsApp" link. Entirely client-side
  (Alpine store in public/js/selection.js, backed by localStorage) except
  for the static labels/restaurant data threaded in here -- there's
  nothing to render server-side since the selection doesn't exist until
  the customer builds it in their own browser.

  Not rendered at all when the restaurant has no WhatsApp number (checked
  by the caller, views/pages/menu.njk) -- there would be nothing to send
  the selection to, and `+` buttons that build a list going nowhere would
  violate the brief's "hide gracefully" requirement more than just not
  showing the feature does.
#}
{% macro selectionBar(labels, restaurantName, whatsappUrl, tableLabel) %}
  <div
    x-data="{
      open: false,
      labels: {{ labels | dump }},
      tableLabel: {{ tableLabel | dump }},
      restaurantName: {{ restaurantName | dump }},
      whatsappUrl: {{ whatsappUrl | dump }},
      get whatsappHref() {
        const message = buildWhatsAppMessage({
          restaurantName: this.restaurantName,
          tableLabel: this.tableLabel,
          items: $store.selection.list.map((item) => ({
            name: item.name,
            quantity: item.quantity,
            priceFormatted: item.priceFormatted,
            currency: item.currency,
          })),
          note: $store.selection.note,
          totalFormatted: $store.selection.total.toFixed(2),
          currency: $store.selection.currency,
          labels: this.labels,
        });
        return buildWhatsAppUrl(this.whatsappUrl, message);
      },
    }"
    x-show="$store.selection.count > 0"
    x-cloak
  >
    <button
      type="button"
      x-on:click="open = true"
      class="fixed inset-x-4 bottom-4 z-40 flex min-h-11 items-center justify-between gap-3 rounded-full bg-primary px-5 text-sm font-medium text-primary-on shadow-overlay focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary"
    >
      <span x-text="labels.barLabel"></span>
      <span class="flex items-center gap-2">
        <span x-text="$store.selection.count"></span>
        <span dir="ltr" x-text="$store.selection.total.toFixed(2) + ' ' + $store.selection.currency"></span>
      </span>
    </button>

    <div
      x-show="open"
      x-cloak
      x-on:keydown.escape.window="open = false"
      class="fixed inset-0 z-50"
      role="presentation"
    >
      <div
        class="absolute inset-0 bg-text/40"
        x-show="open"
        x-transition:enter="transition-opacity duration-base ease-standard"
        x-transition:enter-start="opacity-0"
        x-transition:enter-end="opacity-100"
        x-transition:leave="transition-opacity duration-fast ease-standard"
        x-transition:leave-start="opacity-100"
        x-transition:leave-end="opacity-0"
        x-on:click="open = false"
      ></div>
      <div
        role="dialog"
        aria-modal="true"
        aria-labelledby="selection-sheet-title"
        class="absolute inset-x-0 bottom-0 flex max-h-[85vh] flex-col overflow-y-auto rounded-t-lg bg-surface shadow-overlay"
        x-show="open"
        x-transition:enter="transition-transform duration-base ease-standard"
        x-transition:enter-start="translate-y-full"
        x-transition:enter-end="translate-y-0"
        x-transition:leave="transition-transform duration-fast ease-standard"
        x-transition:leave-start="translate-y-0"
        x-transition:leave-end="translate-y-full"
      >
        <div class="sticky top-0 flex items-center justify-between border-b border-border bg-surface p-4">
          <h2 id="selection-sheet-title" class="font-sans text-lg font-bold text-text" x-text="labels.title"></h2>
          <button
            type="button"
            aria-label="Close"
            class="inline-flex h-11 w-11 items-center justify-center rounded-full text-text hover:bg-muted-surface focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary"
            x-on:click="open = false"
          >&times;</button>
        </div>

        <div class="flex flex-col gap-4 p-4">
          <template x-if="$store.selection.list.length === 0">
            <p class="py-6 text-center text-sm text-muted-text" x-text="labels.emptyDescription"></p>
          </template>

          <template x-for="item in $store.selection.list" x-bind:key="item.id">
            <div class="flex items-center justify-between gap-3 border-b border-border pb-3 last:border-b-0">
              <div class="min-w-0 flex-1">
                <p class="truncate text-sm font-bold text-text" x-text="item.name"></p>
                <p dir="ltr" class="text-sm text-muted-text" x-text="item.priceFormatted + ' ' + item.currency"></p>
              </div>
              <div class="flex shrink-0 items-center gap-2">
                <button
                  type="button"
                  x-bind:aria-label="labels.decreaseAriaLabel"
                  x-on:click="$store.selection.setQuantity(item.id, item.quantity - 1)"
                  class="inline-flex h-9 w-9 items-center justify-center rounded-full border border-border-strong text-text hover:bg-muted-surface focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary"
                >&minus;</button>
                <span class="w-6 text-center text-sm font-medium text-text" x-text="item.quantity"></span>
                <button
                  type="button"
                  x-bind:aria-label="labels.increaseAriaLabel"
                  x-on:click="$store.selection.setQuantity(item.id, item.quantity + 1)"
                  class="inline-flex h-9 w-9 items-center justify-center rounded-full border border-border-strong text-text hover:bg-muted-surface focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary"
                >+</button>
              </div>
            </div>
          </template>

          <div x-show="$store.selection.list.length > 0" class="flex flex-col gap-1.5">
            <label for="selection-note" class="text-sm font-medium text-text" x-text="labels.noteLabel"></label>
            <textarea
              id="selection-note"
              rows="2"
              x-bind:placeholder="labels.notePlaceholder"
              x-model="$store.selection.note"
              x-on:input="$store.selection.setNote($event.target.value)"
              class="rounded-md border border-border-strong bg-surface px-3 py-2 text-base text-text focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary"
            ></textarea>
          </div>

          <div x-show="$store.selection.list.length > 0" class="flex items-center justify-between text-base font-bold text-text">
            <span x-text="labels.totalLabel"></span>
            <span dir="ltr" x-text="$store.selection.total.toFixed(2) + ' ' + $store.selection.currency"></span>
          </div>

          <p x-show="$store.selection.list.length > 0" class="text-xs text-muted-text" x-text="labels.disclaimer"></p>

          <div x-show="$store.selection.list.length > 0" class="flex flex-col gap-2">
            <a
              x-bind:href="whatsappHref"
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex min-h-11 items-center justify-center gap-2 rounded-button bg-primary px-4 text-sm font-medium text-primary-on hover:bg-primary-hover focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary"
            >
              <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413"/></svg>
              <span x-text="labels.sendButton"></span>
            </a>
            <button
              type="button"
              x-on:click="$store.selection.clear()"
              class="inline-flex min-h-11 items-center justify-center rounded-button border border-border px-4 text-sm font-medium text-text hover:bg-muted-surface focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary"
              x-text="labels.clearButton"
            ></button>
          </div>
        </div>
      </div>
    </div>
  </div>
{% endmacro %}
