{#
  Single shared bottom sheet for item details, reused across the whole
  menu instead of one sheet per item (would mean 30+ hidden dialogs in the
  DOM). A menu item card dispatches "open-item-sheet" on window with the
  item's data as the event detail (see menu-item-trigger.njk); this sheet
  listens and renders whatever it receives. Tag color mapping duplicates
  components/badge.njk's variant classes, since this content is rendered
  client-side from dynamic data rather than by Nunjucks.
#}
{% macro itemDetailSheet(unavailableLabel, hasWhatsapp, addButtonLabel, addedToastMessage) %}
  <div
    x-data="{ open: false, item: null, unavailableLabel: {{ unavailableLabel | dump }}, hasWhatsapp: {{ hasWhatsapp | dump }}, addButtonLabel: {{ addButtonLabel | dump }}, addedToastMessage: {{ addedToastMessage | dump }} }"
    x-on:open-item-sheet.window="item = $event.detail; open = true"
    x-on:keydown.escape.window="open = false"
    x-show="open"
    x-cloak
    class="fixed inset-0 z-50"
    role="presentation"
  >
    <div
      class="absolute inset-0 bg-text/40"
      x-show="open"
      x-transition:enter="transition-opacity duration-base ease-standard"
      x-transition:enter-start="opacity-0"
      x-transition:enter-end="opacity-100"
      x-transition:leave="transition-opacity duration-fast ease-standard"
      x-transition:leave-start="opacity-100"
      x-transition:leave-end="opacity-0"
      x-on:click="open = false"
    ></div>
    <div
      role="dialog"
      aria-modal="true"
      aria-labelledby="item-sheet-title"
      class="absolute inset-x-0 bottom-0 max-h-[85vh] overflow-y-auto rounded-t-lg bg-surface shadow-overlay"
      x-show="open"
      x-transition:enter="transition-transform duration-base ease-standard"
      x-transition:enter-start="translate-y-full"
      x-transition:enter-end="translate-y-0"
      x-transition:leave="transition-transform duration-fast ease-standard"
      x-transition:leave-start="translate-y-0"
      x-transition:leave-end="translate-y-full"
    >
      <template x-if="item">
        <div>
          <div class="relative">
            <img
              x-show="item.imageUrl"
              x-bind:src="item.imageUrl"
              alt=""
              class="h-48 w-full object-cover"
            >
            <button
              type="button"
              aria-label="Close"
              class="absolute end-3 top-3 inline-flex h-11 w-11 items-center justify-center rounded-full bg-surface text-text shadow-raised hover:bg-muted-surface focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary"
              x-on:click="open = false"
            >
              &times;
            </button>
          </div>
          <div class="p-4">
            <h2 id="item-sheet-title" class="font-sans text-xl font-bold text-text" x-text="item.name"></h2>
            <p class="mt-2 text-sm leading-body text-muted-text" x-show="item.description" x-text="item.description"></p>

            <div class="mt-3 flex flex-wrap gap-1.5">
              <span
                class="inline-flex items-center rounded-sm px-2 py-0.5 text-xs font-medium bg-muted-surface text-muted-text"
                x-show="!item.available"
                x-text="unavailableLabel"
              ></span>
              <template x-for="tag in item.tags" x-bind:key="tag.code">
                <span
                  class="inline-flex items-center rounded-sm px-2 py-0.5 text-xs font-medium"
                  x-bind:class="{
                    'bg-primary-soft text-primary': tag.variant === 'primary',
                    'bg-secondary-soft text-secondary-text': tag.variant === 'secondary',
                    'bg-gold text-on-gold': tag.variant === 'popular',
                    'bg-danger text-white': tag.variant === 'danger',
                  }"
                  x-text="tag.label"
                ></span>
              </template>
            </div>

            <p class="mt-4 text-lg font-bold text-text" dir="ltr">
              <span x-text="item.priceFormatted"></span> <span x-text="item.currency"></span>
            </p>

            <button
              type="button"
              x-show="hasWhatsapp && item.available"
              x-on:click="$store.selection.add({
                id: item.id,
                name: item.name,
                price: item.price,
                priceFormatted: item.priceFormatted,
                currency: item.currency,
                addedToastMessage: addedToastMessage,
              }); open = false"
              x-bind:aria-label="item.addAriaLabel"
              class="mt-4 inline-flex min-h-11 w-full items-center justify-center gap-2 rounded-md bg-primary px-4 text-sm font-medium text-primary-on hover:bg-primary-hover focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary"
            >
              <svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M8 3v10M3 8h10" stroke-linecap="round"/></svg>
              <span x-text="addButtonLabel"></span>
            </button>
          </div>
        </div>
      </template>
    </div>
  </div>
{% endmacro %}
