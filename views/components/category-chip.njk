{#
  Round category chips in the sticky bar: a 56px circle with the category's
  photo (or the restaurant logo, or an icon) and a label below. The active
  chip gets a primary ring. State is toggled client side by public/js/menu.js,
  which swaps the same classes, so keep the two in sync.
#}

{#
  The first chip of the bar. It scrolls back to the start of the menu and is
  the active chip until the reader scrolls into the first category.
#}
{% macro categoryAllChip(label, active=false) %}
  <a
    href="#main-content"
    data-category-chip="#all"
    class="flex w-16 shrink-0 flex-col items-center gap-1.5 rounded-md py-1 text-center focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary"
    {% if active %}aria-current="true"{% endif %}
  >
    <span
      data-chip-circle
      class="flex h-14 w-14 items-center justify-center overflow-hidden rounded-full border-2 p-0.5 {{ 'border-primary' if active else 'border-transparent' }}"
    >
      {# Four squares: "everything". It takes the restaurant's own accent, like the ring around it. #}
      <span class="flex h-full w-full items-center justify-center rounded-full bg-primary-soft text-primary-text" data-all-icon>
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round" aria-hidden="true"><rect x="4" y="4" width="6.5" height="6.5" rx="1.5"/><rect x="13.5" y="4" width="6.5" height="6.5" rx="1.5"/><rect x="4" y="13.5" width="6.5" height="6.5" rx="1.5"/><rect x="13.5" y="13.5" width="6.5" height="6.5" rx="1.5"/></svg>
      </span>
    </span>
    <span data-chip-label class="line-clamp-2 text-xs font-medium leading-tight {{ 'text-text' if active else 'text-muted-text' }}">{{ label }}</span>
  </a>
{% endmacro %}

{% macro categoryChip(label, href, active=false, imageUrl=none, fallbackUrl=none) %}
  <a
    href="{{ href }}"
    data-category-chip="{{ href }}"
    class="flex w-16 shrink-0 flex-col items-center gap-1.5 rounded-md py-1 text-center focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary"
    {% if active %}aria-current="true"{% endif %}
  >
    <span
      data-chip-circle
      class="flex h-14 w-14 items-center justify-center overflow-hidden rounded-full border-2 p-0.5 {{ 'border-primary' if active else 'border-transparent' }}"
    >
      {# Own picture, else the restaurant logo, else the built in image. #}
      <img src="{{ imageUrl or fallbackUrl or '/images/category-fallback.svg' }}" alt="" width="52" height="52" loading="lazy" decoding="async" class="h-full w-full rounded-full object-cover">
    </span>
    <span data-chip-label class="line-clamp-2 text-xs font-medium leading-tight {{ 'text-text' if active else 'text-muted-text' }}">{{ label }}</span>
  </a>
{% endmacro %}
