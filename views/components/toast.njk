{#
  Single toast host, included once per page (e.g. in the base layout).
  Anything can trigger a toast by dispatching a window CustomEvent named
  "toast" with detail { message, variant }, e.g.:
    $dispatch('toast', { message: 'Saved', variant: 'success' })
  variant: 'success' | 'warning' | 'danger' | 'neutral'
#}
{% macro toastHost() %}
  <div
    x-data="{
      toasts: [],
      add(detail) {
        const id = Date.now() + Math.random();
        this.toasts.push({ id, message: detail.message, variant: detail.variant || 'neutral' });
        setTimeout(() => { this.toasts = this.toasts.filter((t) => t.id !== id); }, 4000);
      },
    }"
    x-on:toast.window="add($event.detail)"
    class="pointer-events-none fixed inset-x-0 bottom-4 z-50 flex flex-col items-center gap-2 px-4"
    aria-live="polite"
    aria-atomic="true"
  >
    <template x-for="toast in toasts" x-bind:key="toast.id">
      <div
        x-show="true"
        x-transition:enter="transition duration-base ease-standard"
        x-transition:enter-start="opacity-0 translate-y-2"
        x-transition:enter-end="opacity-100 translate-y-0"
        x-transition:leave="transition duration-fast ease-standard"
        x-transition:leave-start="opacity-100"
        x-transition:leave-end="opacity-0"
        class="pointer-events-auto rounded-md px-4 py-3 text-sm font-medium shadow-overlay"
        x-bind:class="{
          'bg-text text-white': toast.variant === 'neutral',
          'bg-success text-white': toast.variant === 'success',
          'bg-warning text-white': toast.variant === 'warning',
          'bg-danger text-white': toast.variant === 'danger',
        }"
        x-text="toast.message"
      ></div>
    </template>
  </div>
{% endmacro %}
