{#
  restaurant: { name, description, logoUrl, whatsappUrl, instagramUrl, workingHours }
  The language switcher lives in the sticky bar (views/pages/menu.njk), not
  here: this header scrolls away, and a control the user can only reach by
  scrolling back to the top isn't actually reachable mid-scroll.
#}
{% macro restaurantHeader(restaurant, whatsappLabel, instagramLabel, openStatusLabels, callLabel) %}
  <header class="border-b border-border bg-surface">
    {% if restaurant.coverImageUrl %}
      <img
        src="{{ restaurant.coverImageUrl }}"
        alt=""
        width="800"
        height="200"
        class="h-32 w-full object-cover sm:h-44"
      >
    {% endif %}
    <div class="mx-auto max-w-2xl px-4 py-6">
      <div class="flex items-start gap-4">
        {% if restaurant.logoUrl %}
          <img
            src="{{ restaurant.logoUrl }}"
            alt=""
            width="64"
            height="64"
            class="h-16 w-16 shrink-0 rounded-full object-cover"
          >
        {% endif %}
        <div class="min-w-0">
          <h1 class="font-display text-3xl font-bold leading-heading text-text">{{ restaurant.name }}</h1>
          {% if restaurant.tagline %}
            <p class="mt-1 text-base font-medium leading-body text-text">{{ restaurant.tagline }}</p>
          {% endif %}
          {% if restaurant.description %}
            <p class="mt-1 text-sm leading-body text-muted-text">{{ restaurant.description }}</p>
          {% endif %}
          {% if restaurant.workingHours %}
            <p class="mt-2 text-xs text-muted-text">{{ restaurant.workingHours }}</p>
          {% endif %}
          {% if restaurant.openStatus %}
            {#
              A3: live open/closed badge. Server-rendered at the correct
              value for the request's own moment; the x-data below
              re-ticks every 60s client-side (mirroring
              src/common/open-status.ts in public/js/open-status.js) so
              the badge flips from "Open" to "Closed" live, without a
              page reload, right as the restaurant's own closing time
              passes -- not just whatever was true when the page loaded.
            #}
            <div
              x-data="{
                isOpen: {{ restaurant.openStatus.isOpen | dump }},
                label: {{ restaurant.openStatus.label | dump }},
                openTime: {{ restaurant.openStatus.openTime | dump }},
                closeTime: {{ restaurant.openStatus.closeTime | dump }},
                openTemplate: {{ openStatusLabels.openUntil | dump }},
                closedTemplate: {{ openStatusLabels.closedUntil | dump }},
                recompute() {
                  const status = computeOpenStatusLive(this.openTime, this.closeTime);
                  this.isOpen = status.isOpen;
                  const template = status.isOpen ? this.openTemplate : this.closedTemplate;
                  this.label = template.replace('{time}', status.nextChangeTime);
                },
              }"
              x-init="setInterval(() => recompute(), 60000)"
              class="mt-2 inline-flex items-center gap-1.5 rounded-full px-2 py-0.5 text-xs font-medium"
              x-bind:class="isOpen ? 'bg-success/10 text-success' : 'bg-danger/10 text-danger'"
            >
              <span class="h-1.5 w-1.5 rounded-full" x-bind:class="isOpen ? 'bg-success' : 'bg-danger'"></span>
              <span x-text="label"></span>
            </div>
          {% endif %}
        </div>
      </div>

      {% if restaurant.phoneUrl or restaurant.whatsappUrl or restaurant.instagramUrl %}
        <div class="mt-4 flex flex-wrap gap-2">
          {% if restaurant.phoneUrl %}
            <a
              href="{{ restaurant.phoneUrl }}"
              class="inline-flex min-h-11 items-center gap-2 rounded-button bg-primary px-4 text-sm font-medium text-primary-on hover:bg-primary-hover focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary"
            >
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M5 4h4l2 5-2.5 1.5a11 11 0 0 0 5 5L15 13l5 2v4a2 2 0 0 1-2 2A16 16 0 0 1 3 6a2 2 0 0 1 2-2Z" stroke-linecap="round" stroke-linejoin="round"/></svg>
              {{ callLabel }}
            </a>
          {% endif %}          {% if restaurant.whatsappUrl %}
            <a
              href="{{ restaurant.whatsappUrl }}"
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex min-h-11 items-center gap-2 rounded-button bg-primary-soft px-4 text-sm font-medium text-primary hover:opacity-90 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary"
            >
              <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413"/></svg>
              {{ whatsappLabel }}
            </a>
          {% endif %}
          {% if restaurant.instagramUrl %}
            <a
              href="{{ restaurant.instagramUrl }}"
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex min-h-11 items-center gap-2 rounded-button bg-secondary-soft px-4 text-sm font-medium text-secondary-text hover:opacity-90 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary"
            >
              <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 0C8.74 0 8.333.015 7.053.072 5.775.132 4.905.333 4.14.63c-.789.306-1.459.717-2.126 1.384S.935 3.35.63 4.14C.333 4.905.131 5.775.072 7.053.012 8.333 0 8.74 0 12s.015 3.667.072 4.947c.06 1.277.261 2.148.558 2.913.306.788.717 1.459 1.384 2.126.667.666 1.336 1.079 2.126 1.384.766.296 1.636.499 2.913.558C8.333 23.988 8.74 24 12 24s3.667-.015 4.947-.072c1.277-.06 2.148-.262 2.913-.558.788-.306 1.459-.718 2.126-1.384.666-.667 1.079-1.335 1.384-2.126.296-.765.499-1.636.558-2.913.06-1.28.072-1.687.072-4.947s-.015-3.667-.072-4.947c-.06-1.277-.262-2.149-.558-2.913-.306-.789-.718-1.459-1.384-2.126C21.319 1.347 20.651.935 19.86.63c-.765-.297-1.636-.499-2.913-.558C15.667.012 15.26 0 12 0m0 2.16c3.203 0 3.585.016 4.85.071 1.17.055 1.805.249 2.227.415.562.217.96.477 1.382.896.419.42.679.819.896 1.381.164.422.36 1.057.413 2.227.057 1.266.07 1.646.07 4.85s-.015 3.585-.074 4.85c-.061 1.17-.256 1.805-.421 2.227-.224.562-.479.96-.899 1.382-.419.419-.824.679-1.38.896-.42.164-1.065.36-2.235.413-1.274.057-1.649.07-4.859.07-3.211 0-3.586-.015-4.859-.074-1.171-.061-1.816-.256-2.236-.421-.569-.224-.96-.479-1.379-.899-.421-.419-.69-.824-.9-1.38-.165-.42-.359-1.065-.42-2.235-.045-1.26-.061-1.649-.061-4.844 0-3.196.016-3.586.061-4.861.061-1.17.255-1.814.42-2.234.21-.57.479-.96.9-1.381.419-.419.81-.689 1.379-.898.42-.166 1.051-.361 2.221-.421 1.275-.045 1.65-.06 4.859-.06M12 5.838a6.162 6.162 0 1 0 0 12.324 6.162 6.162 0 0 0 0-12.324M12 16a4 4 0 1 1 0-8 4 4 0 0 1 0 8m7.846-10.405a1.44 1.44 0 1 1-2.88 0 1.44 1.44 0 0 1 2.88 0"/></svg>
              {{ instagramLabel }}
            </a>
          {% endif %}
        </div>
      {% endif %}
    </div>
  </header>
{% endmacro %}
