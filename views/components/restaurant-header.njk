{#
  restaurant: { name, description, logoUrl, whatsappUrl, instagramUrl, workingHours }
  The language switcher lives in the sticky bar (views/pages/menu.njk), not
  here: this header scrolls away, and a control the user can only reach by
  scrolling back to the top isn't actually reachable mid-scroll.
#}
{% macro restaurantHeader(restaurant, whatsappLabel, instagramLabel) %}
  <header class="border-b border-border bg-surface">
    <div class="mx-auto max-w-2xl px-4 py-6">
      <div class="flex items-start gap-4">
        {% if restaurant.logoUrl %}
          <img
            src="{{ restaurant.logoUrl }}"
            alt=""
            width="64"
            height="64"
            class="h-16 w-16 shrink-0 rounded-full object-cover"
          >
        {% endif %}
        <div class="min-w-0">
          <h1 class="font-display text-3xl font-bold leading-heading text-text">{{ restaurant.name }}</h1>
          {% if restaurant.description %}
            <p class="mt-1 text-sm leading-body text-muted-text">{{ restaurant.description }}</p>
          {% endif %}
          {% if restaurant.workingHours %}
            <p class="mt-2 text-xs text-muted-text">{{ restaurant.workingHours }}</p>
          {% endif %}
        </div>
      </div>

      {% if restaurant.whatsappUrl or restaurant.instagramUrl %}
        <div class="mt-4 flex flex-wrap gap-2">
          {% if restaurant.whatsappUrl %}
            <a
              href="{{ restaurant.whatsappUrl }}"
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex min-h-11 items-center gap-2 rounded-md bg-primary-soft px-4 text-sm font-medium text-primary hover:opacity-90 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary"
            >
              <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12.04 2c-5.52 0-10 4.48-10 10 0 1.76.46 3.48 1.34 5L2 22l5.14-1.35A9.96 9.96 0 0 0 12.04 22c5.52 0 10-4.48 10-10s-4.48-10-10-10Zm0 18.2c-1.6 0-3.17-.43-4.54-1.24l-.33-.19-3.05.8.81-2.97-.21-.31a8.18 8.18 0 0 1-1.26-4.3c0-4.53 3.68-8.21 8.21-8.21 4.53 0 8.21 3.68 8.21 8.21 0 4.53-3.68 8.21-8.21 8.21Z"/></svg>
              {{ whatsappLabel }}
            </a>
          {% endif %}
          {% if restaurant.instagramUrl %}
            <a
              href="{{ restaurant.instagramUrl }}"
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex min-h-11 items-center gap-2 rounded-md bg-secondary-soft px-4 text-sm font-medium text-secondary-text hover:opacity-90 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary"
            >
              <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2.2c2.67 0 2.99.01 4.04.06 2.67.12 3.92 1.39 4.04 4.04.05 1.05.06 1.37.06 4.04v.01c0 2.67-.01 2.99-.06 4.04-.12 2.65-1.37 3.92-4.04 4.04-1.05.05-1.37.06-4.04.06h-.01c-2.67 0-2.99-.01-4.04-.06-2.68-.12-3.92-1.39-4.04-4.04-.05-1.05-.06-1.37-.06-4.04v-.01c0-2.67.01-2.99.06-4.04C4.03 3.6 5.28 2.33 7.96 2.21 9.01 2.16 9.33 2.15 12 2.15Zm0 1.98c-2.63 0-2.92.01-3.95.06-2.05.1-2.93.99-3.03 3.03-.05 1.03-.06 1.33-.06 3.93v.01c0 2.6.01 2.9.06 3.93.1 2.03.98 2.93 3.03 3.03 1.03.05 1.33.06 3.95.06h.01c2.63 0 2.92-.01 3.95-.06 2.04-.1 2.93-.99 3.03-3.03.05-1.03.06-1.33.06-3.93v-.01c0-2.6-.01-2.9-.06-3.93-.1-2.04-.99-2.93-3.03-3.03-1.03-.05-1.32-.06-3.95-.06ZM12 7a5 5 0 1 1 0 10 5 5 0 0 1 0-10Zm0 1.98a3.02 3.02 0 1 0 0 6.04 3.02 3.02 0 0 0 0-6.04Zm5.2-2.2a1.17 1.17 0 1 1 0 2.34 1.17 1.17 0 0 1 0-2.34Z"/></svg>
              {{ instagramLabel }}
            </a>
          {% endif %}
        </div>
      {% endif %}
    </div>
  </header>
{% endmacro %}
