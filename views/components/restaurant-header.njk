{% from "components/language-switcher.njk" import languageSwitcher %}

{#
  restaurant: the public menu view model. Logo and name at the start, the
  AR | EN pill at the end, an optional full width cover above. Contact
  details live in the footer, not here, so this stays one calm row.
  placeholder: the logo when there is one, otherwise a fork and knife icon.
#}
{% macro restaurantHeader(restaurant, openStatusLabels, otherLocale, languageLabel) %}
  <header class="bg-surface">
    {% if restaurant.coverImageUrl %}
      <img
        src="{{ restaurant.coverImageUrl }}"
        alt=""
        width="800"
        height="200"
        fetchpriority="high"
        class="h-44 w-full object-cover"
      >
    {% endif %}
    <div class="mx-auto max-w-4xl px-4 pb-3 pt-4 sm:px-6">
      <div class="flex items-center justify-between gap-3">
        <div class="flex min-w-0 items-center gap-3">
          <span class="flex h-11 w-11 shrink-0 items-center justify-center overflow-hidden rounded-card border border-border bg-muted-surface text-muted-text">
            {% if restaurant.logoUrl %}
              <img src="{{ restaurant.logoUrl }}" alt="" width="44" height="44" class="h-full w-full object-cover">
            {% else %}
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M7 3v8a2 2 0 0 0 2 2v8M11 3v6M7 7h4M17 3c-2 2-3 5-3 8h3v10" stroke-linecap="round" stroke-linejoin="round"/></svg>
            {% endif %}
          </span>
          <div class="min-w-0 text-start">
            <h1 class="truncate font-display text-lg font-bold leading-heading text-text sm:text-xl">{{ restaurant.name }}</h1>
            {% if restaurant.tagline or restaurant.description %}
              <p class="line-clamp-2 text-xs leading-body text-muted-text">{{ restaurant.tagline or restaurant.description }}</p>
            {% endif %}
          </div>
        </div>
        {{ languageSwitcher(otherLocale, languageLabel, 'data-preserve-scroll') }}
      </div>
      {% if restaurant.workingHours or restaurant.openStatus %}
        <div class="mt-3 flex flex-wrap items-center gap-x-3 gap-y-1">
          {% if restaurant.openStatus %}
            {#
              A3: live open/closed badge. Server-rendered at the correct
              value for the request's own moment; the x-data below
              re-ticks every 60s client-side (mirroring
              src/common/open-status.ts in public/js/open-status.js) so
              the badge flips from "Open" to "Closed" live, without a
              page reload, right as the restaurant's own closing time
              passes -- not just whatever was true when the page loaded.
            #}
            <div
              x-data="{
                isOpen: {{ restaurant.openStatus.isOpen | dump }},
                label: {{ restaurant.openStatus.label | dump }},
                openTime: {{ restaurant.openStatus.openTime | dump }},
                closeTime: {{ restaurant.openStatus.closeTime | dump }},
                openTemplate: {{ openStatusLabels.openUntil | dump }},
                closedTemplate: {{ openStatusLabels.closedUntil | dump }},
                recompute() {
                  const status = computeOpenStatusLive(this.openTime, this.closeTime);
                  this.isOpen = status.isOpen;
                  const template = status.isOpen ? this.openTemplate : this.closedTemplate;
                  this.label = template.replace('{time}', status.nextChangeTime);
                },
              }"
              x-init="setInterval(() => recompute(), 60000)"
              class="inline-flex items-center gap-1.5 rounded-full px-2 py-0.5 text-xs font-medium"
              x-bind:class="isOpen ? 'bg-success/10 text-success' : 'bg-danger/10 text-danger'"
            >
              <span class="h-1.5 w-1.5 rounded-full" x-bind:class="isOpen ? 'bg-success' : 'bg-danger'"></span>
              <span x-text="label"></span>
            </div>
          {% endif %}
          {% if restaurant.workingHours %}
            <p class="text-xs text-muted-text">{{ restaurant.workingHours }}</p>
          {% endif %}
        </div>
      {% endif %}
    </div>
  </header>
{% endmacro %}
