{#
  Menu tabs (Breakfast, All day) plus the serving hours of the one on
  screen. Tabs are plain links so each menu has its own address and works
  without JavaScript. Sits above the sticky search bar on purpose: switching
  menu is rare, and a second sticky row would eat the phone screen.
#}
{% macro menuSwitcher(menu, label, tableLabel) %}
  {% if menu.menus.length > 1 or (menu.activeMenu and menu.activeMenu.hoursNote) %}
    <div class="print:hidden border-b border-border bg-surface">
      {% if menu.menus.length > 1 %}
        <nav aria-label="{{ label }}" class="mx-auto flex max-w-2xl gap-2 overflow-x-auto px-4 py-3">
          {% for entry in menu.menus %}
            <a
              href="/m/{{ menu.slug }}?menu={{ entry.id }}{% if tableLabel %}&table={{ tableLabel | urlencode }}{% endif %}"
              {% if entry.active %}aria-current="page"{% endif %}
              class="inline-flex min-h-11 shrink-0 items-center rounded-button px-4 text-sm font-medium focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary {{ 'bg-primary text-primary-on' if entry.active else 'border border-border-strong text-text hover:bg-muted-surface' }}"
            >{{ entry.name }}</a>
          {% endfor %}
        </nav>
      {% endif %}
      {% if menu.activeMenu and menu.activeMenu.hoursNote %}
        <p class="mx-auto max-w-2xl px-4 pb-3 text-sm text-muted-text {{ 'pt-3' if menu.menus.length <= 1 }}">{{ menu.activeMenu.hoursNote }}</p>
      {% endif %}
    </div>
  {% endif %}
{% endmacro %}
