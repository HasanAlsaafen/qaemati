{#
  AR | EN segmented pill. Both are plain links so it works without script and
  keeps its place when the page reloads. otherLocale is the language the
  visitor is NOT reading, which is what the active segment is derived from.
#}
{% macro languageSwitcher(otherLocale, label, attrs='') %}
  {% set current = 'en' if otherLocale == 'ar' else 'ar' %}
  <div role="group" dir="ltr" aria-label="{{ label }}" class="inline-flex shrink-0 items-center rounded-full border border-border bg-surface p-px">
    {% for code in ['ar', 'en'] %}
      <a
        href="/lang/{{ code }}"
        lang="{{ code }}"
        {% if code == current %}aria-current="true"{% endif %}
        class="inline-flex min-h-11 min-w-11 items-center justify-center rounded-full px-3 text-xs font-bold focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary {{ 'bg-primary text-primary-on' if code == current else 'text-muted-text hover:text-text' }}"
        {{ attrs | safe }}
      >{{ code | upper }}</a>
    {% endfor %}
  </div>
{% endmacro %}
