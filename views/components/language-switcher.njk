{% macro languageSwitcher(otherLocale, label, attrs='') %}
  <a
    href="/lang/{{ otherLocale }}"
    class="inline-flex min-h-11 items-center rounded-md border border-border px-3 text-sm font-medium text-text hover:bg-muted-surface focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary"
    {{ attrs | safe }}
  >
    {{ label }}
  </a>
{% endmacro %}
