{#
  Confirmation dialog for destructive or important actions. Opened by
  dispatching "open-confirm-<id>" on window. confirmAttrs lets the caller
  attach htmx attributes (hx-delete, hx-post, ...) directly to the confirm
  button, so confirming performs the real action.
#}
{% macro confirmDialog(id, title, body, confirmLabel, cancelLabel, destructive=true, confirmAttrs='') %}
  <div
    x-data="{ open: false }"
    x-on:open-confirm-{{ id }}.window="open = true"
    x-on:keydown.escape.window="open = false"
    x-show="open"
    x-cloak
    class="fixed inset-0 z-50 flex items-center justify-center p-4"
    role="presentation"
  >
    <div class="absolute inset-0 bg-text/40" x-show="open" x-on:click="open = false"></div>
    <div
      role="alertdialog"
      aria-modal="true"
      aria-labelledby="{{ id }}-title"
      aria-describedby="{{ id }}-body"
      class="relative w-full max-w-sm rounded-lg bg-surface p-5 shadow-overlay"
      x-show="open"
      x-transition:enter="transition duration-base ease-standard"
      x-transition:enter-start="opacity-0 scale-95"
      x-transition:enter-end="opacity-100 scale-100"
    >
      <h2 id="{{ id }}-title" class="font-display text-lg font-semibold text-text">{{ title }}</h2>
      <p id="{{ id }}-body" class="mt-2 text-sm text-muted-text">{{ body }}</p>
      <div class="mt-5 flex justify-end gap-2">
        <button
          type="button"
          class="inline-flex min-h-11 items-center justify-center rounded-md border border-border px-4 text-sm font-medium text-text hover:bg-muted-surface focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary"
          x-on:click="open = false"
        >
          {{ cancelLabel }}
        </button>
        <button
          type="button"
          class="inline-flex min-h-11 items-center justify-center rounded-md px-4 text-sm font-medium text-white focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary {{ 'bg-danger hover:opacity-90' if destructive else 'bg-primary hover:bg-primary-hover' }}"
          x-on:click="open = false"
          {{ confirmAttrs | safe }}
        >
          {{ confirmLabel }}
        </button>
      </div>
    </div>
  </div>
{% endmacro %}
