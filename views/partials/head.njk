<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<link rel="icon" type="image/svg+xml" href="/favicon.svg">

{# Preload only what the first paint uses: the two Tajawal weights for the
   language of the page. The other files load when text needs them. #}
{% if locale == 'ar' %}
<link rel="preload" href="/fonts/tajawal/tajawal-500-arabic.woff2" as="font" type="font/woff2" crossorigin>
<link rel="preload" href="/fonts/tajawal/tajawal-700-arabic.woff2" as="font" type="font/woff2" crossorigin>
{% else %}
<link rel="preload" href="/fonts/tajawal/tajawal-500-latin.woff2" as="font" type="font/woff2" crossorigin>
<link rel="preload" href="/fonts/tajawal/tajawal-700-latin.woff2" as="font" type="font/woff2" crossorigin>
{% endif %}

<link rel="stylesheet" href="{{ asset('/css/app.css') }}">
<script defer src="{{ asset('/js/vendor/htmx.min.js') }}"></script>
{# Alpine's CDN build starts via a queued microtask right after its own
   script executes, not on DOMContentLoaded -- so a later <script defer>
   that calls Alpine.store()/registers an alpine:init listener runs too
   late and finds Alpine already started (every $store.* reference then
   throws "Cannot read properties of undefined"). Any page that needs to
   register a store or plugin before Alpine scans the DOM must inject its
   script tags earlier via a `pre_alpine_scripts` block defined directly
   in that page's *layout* file (e.g. layouts/menu.njk), not here --
   a block defined inside this included partial isn't reachable from a
   page template that extends a different layout (verified empirically;
   Nunjucks blocks resolve against the direct extends chain only, not
   through an unrelated {% include %}). #}
<script defer src="{{ asset('/js/vendor/alpine.min.js') }}"></script>
<style>[x-cloak] { display: none !important; }</style>
