{% from "components/language-switcher.njk" import languageSwitcher %}
<!DOCTYPE html>
<html lang="{{ locale }}" dir="{{ dir }}">
<head>
  <title>{{ t('common.home.landing.metaTitle') }}</title>
  <meta name="description" content="{{ t('common.home.landing.metaDescription') }}">
  {% include "partials/head.njk" %}
  {% if thmanyah %}
    {# Landing page type. Only when thmanyahEnabled(): the font license does not
       allow serving the files publicly without permission. #}
    <link rel="preload" href="/fonts/thmanyah/thmanyahsans-Regular.woff2" as="font" type="font/woff2" crossorigin>
    <link rel="preload" href="/fonts/thmanyah/thmanyahserifdisplay-Bold.woff2" as="font" type="font/woff2" crossorigin>
    <link rel="stylesheet" href="{{ asset('/css/thmanyah.css') }}">
  {% endif %}
  <style>
    body.landing {
      --font-sans: 'Thmanyah Sans', 'Tajawal', 'IBM Plex Sans Arabic', 'Inter', 'Segoe UI', Tahoma, sans-serif;
      --font-display: 'Thmanyah Serif Display', 'Thmanyah Sans', 'Tajawal', 'IBM Plex Sans Arabic', 'Inter', Tahoma, serif;
    }
    /* The phone is drawn at real size (414 x 868) and scaled; --s is that scale. */
    .iphone { --s: .66; position: relative; width: calc(414px * var(--s)); height: calc(868px * var(--s)); margin-inline: auto; }
    @media (min-width: 640px) { .iphone { --s: .76; } }
    @media (min-width: 1024px) { .iphone { --s: .82; } }
    .iphone__body { position: absolute; top: 0; left: 0; width: 414px; height: 868px; transform: scale(var(--s)); transform-origin: top left; border-radius: 64px; background: #1d1e21; box-shadow: inset 0 0 0 2px #5b5e64, inset 0 0 0 4px #0c0d0e, 0 30px 60px -20px rgba(15, 25, 35, .45); }
    .iphone__button { position: absolute; left: -3px; width: 4px; border-radius: 2px 0 0 2px; background: #2a2c30; }
    .iphone__button--right { left: auto; right: -3px; border-radius: 0 2px 2px 0; }
    .iphone__screen { position: absolute; inset: 12px; overflow: hidden; border-radius: 52px; background: rgb(var(--color-surface)); }
    .iphone__status { position: absolute; inset: 0 0 auto 0; height: 54px; display: flex; align-items: center; justify-content: space-between; padding: 6px 32px 0 40px; color: #111; font: 600 17px/1 system-ui, -apple-system, 'Segoe UI', sans-serif; z-index: 2; }
    .iphone__icons { display: inline-flex; align-items: center; gap: 6px; }
    .iphone__island { position: absolute; top: 11px; left: 50%; width: 122px; height: 36px; margin-left: -61px; border-radius: 20px; background: #000; z-index: 3; }
    .iphone__page { position: absolute; top: 54px; left: 0; width: 390px; height: 790px; border: 0; background: rgb(var(--color-bg)); }
    .iphone__cover { position: absolute; inset: 0; z-index: 4; }
    @media (min-width: 1024px) { .iphone__cover { display: none; } }
    .iphone__home { position: absolute; bottom: 8px; left: 50%; width: 134px; height: 5px; margin-left: -67px; border-radius: 3px; background: rgba(0, 0, 0, .85); z-index: 3; pointer-events: none; }
    html { scroll-behavior: smooth; }
    @media (prefers-reduced-motion: reduce) { html { scroll-behavior: auto; } }
  </style>
  <link rel="canonical" href="{{ seo.canonicalUrl }}">
  <meta property="og:type" content="website">
  <meta property="og:title" content="{{ t('common.home.landing.metaTitle') }}">
  <meta property="og:description" content="{{ t('common.home.landing.metaDescription') }}">
  <meta property="og:url" content="{{ seo.canonicalUrl }}">
  <script type="application/ld+json">{{ seo.jsonLd | safe }}</script>
</head>
<body class="landing min-h-screen bg-bg text-text font-sans antialiased" x-data="{ navOpen: false }">
  {% include "partials/skip-link.njk" %}
  {% block body %}{% endblock %}
  {% block scripts %}{% endblock %}
</body>
</html>
