{% from "components/toast.njk" import toastHost %}
{% from "components/language-switcher.njk" import languageSwitcher %}
<!DOCTYPE html>
<html lang="{{ locale }}" dir="{{ dir }}">
<head>
  <title>{% block title %}{{ t('common.super.nav.dashboard') }}{% endblock %} | {{ t('common.super.platform') }}</title>
  <meta name="robots" content="noindex, nofollow">
  {% include "partials/head.njk" %}
</head>
<body class="min-h-screen bg-bg text-text font-sans antialiased" x-data="{ navOpen: false }">
  {% include "partials/skip-link.njk" %}
  {% set navItems = [
    { href: '/super', label: t('common.super.nav.dashboard'), match: 'dashboard' },
    { href: '/super/restaurants', label: t('common.super.nav.restaurants'), match: 'restaurants' },
    { href: '/super/plans', label: t('common.super.nav.plans'), match: 'plans' },
    { href: '/super/themes', label: t('common.super.nav.themes'), match: 'themes' },
    { href: '/super/payments', label: t('common.super.nav.payments'), match: 'payments' },
    { href: '/super/reports', label: t('common.super.nav.reports'), match: 'reports' },
    { href: '/super/audit', label: t('common.super.nav.audit'), match: 'audit' },
    { href: '/super/security', label: t('common.super.nav.security'), match: 'security' }
  ] %}
  <div class="flex min-h-screen">
    <aside class="hidden w-56 shrink-0 flex-col border-e border-border bg-surface sm:flex">
      <div class="flex h-14 items-center px-4">
        <a href="/super" class="inline-flex min-h-11 items-center font-display text-lg font-bold">{{ t('common.super.platform') }}</a>
      </div>
      <nav class="flex flex-1 flex-col gap-1 px-2 py-2 text-sm" aria-label="{{ t('common.super.platform') }}">
        {% for item in navItems %}
          <a href="{{ item.href }}" {% if section == item.match %}aria-current="page"{% endif %} class="flex min-h-11 items-center rounded-md px-3 {{ 'bg-primary-soft font-bold text-primary-text' if section == item.match else 'hover:bg-muted-surface' }}">{{ item.label }}</a>
        {% endfor %}
      </nav>
      <div class="border-t border-border p-2">
        {% if superAdminName %}<p class="truncate px-3 pb-1 text-xs text-muted-text">{{ t('common.admin.auth.loggedInAs', { name: superAdminName }) }}</p>{% endif %}
        <div class="px-1 pb-2">{{ languageSwitcher(otherLocale, t('common.nav.language')) }}</div>
        <form method="post" action="/super/logout">
          <input type="hidden" name="csrf_token" value="{{ csrfToken }}">
          <button type="submit" class="flex min-h-11 w-full items-center justify-center rounded-md border border-border px-3 text-sm font-medium hover:bg-muted-surface">{{ t('common.admin.auth.logout') }}</button>
        </form>
      </div>
    </aside>

    <div class="flex min-w-0 flex-1 flex-col">
      <header class="border-b border-border bg-surface sm:hidden">
        <div class="flex items-center justify-between gap-3 px-4 py-3">
          <a href="/super" class="inline-flex min-h-11 items-center text-lg font-bold">{{ t('common.super.platform') }}</a>
          <div class="ms-auto">{{ languageSwitcher(otherLocale, t('common.nav.language')) }}</div>
          <button type="button" class="inline-flex h-11 w-11 items-center justify-center rounded-md hover:bg-muted-surface" aria-label="{{ t('common.admin.nav.toggleMenu') }}" x-bind:aria-expanded="navOpen.toString()" aria-controls="super-mobile-nav" x-on:click="navOpen = !navOpen">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16" stroke-linecap="round"/></svg>
          </button>
        </div>
        <div id="super-mobile-nav" x-show="navOpen" x-cloak class="border-t border-border px-4 py-3">
          <nav class="flex flex-col gap-1 text-sm">
            {% for item in navItems %}
              <a href="{{ item.href }}" class="inline-flex min-h-11 items-center rounded-md px-3 hover:bg-muted-surface">{{ item.label }}</a>
            {% endfor %}
          </nav>
          <form method="post" action="/super/logout" class="mt-3 border-t border-border pt-3">
            <input type="hidden" name="csrf_token" value="{{ csrfToken }}">
            <button type="submit" class="flex min-h-11 w-full items-center justify-center rounded-md border border-border px-3 text-sm font-medium">{{ t('common.admin.auth.logout') }}</button>
          </form>
        </div>
      </header>

      <main id="main-content" tabindex="-1" class="mx-auto w-full max-w-5xl px-4 py-8 focus:outline-none">
        {% include "super/partials/flash.njk" %}
        {% block content %}{% endblock %}
      </main>
    </div>
  </div>
  {{ toastHost() }}
  <script defer src="{{ asset('/js/password-toggle.js') }}"></script>
</body>
</html>
