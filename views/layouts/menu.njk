{% from "components/toast.njk" import toastHost %}
<!DOCTYPE html>
<html lang="{{ locale }}" dir="{{ dir }}" class="{{ 'embed-frame' if embed }}">
<head>
  <title>{% block title %}{{ t('common.app.name') }}{% endblock %}</title>
  <meta name="description" content="{% block meta_description %}{{ t('common.home.subtitle') }}{% endblock %}">
  {# Must load before partials/head.njk's alpine.min.js tag -- Alpine's
     CDN build starts on a queued microtask right after its own script
     runs, not on DOMContentLoaded, so a store registered any later than
     this finds Alpine already started. See the comment in
     partials/head.njk for the full explanation. #}
  {% if menu.whatsappUrl %}
    <script defer src="/js/whatsapp-message.js"></script>
    <script defer src="/js/selection.js"></script>
  {% endif %}
  {% include "partials/head.njk" %}
  {# A4: a restaurant's own brand color overrides the Zaytoun default
     tokens (src/styles/tokens.css) for this page only -- scoped here
     via inline :root, not by editing the shared stylesheet, so every
     other restaurant's menu keeps the default palette. #}
  {% if menu.primaryColorCss or menu.secondaryColorCss or menu.fontTheme == 'modern' or menu.cornerStyleCss or menu.backgroundColorCss or menu.buttonShapeCss %}
    <style>
      :root {
        {% if menu.primaryColorCss %}
        --color-primary: {{ menu.primaryColorCss.primary }};
        --color-primary-hover: {{ menu.primaryColorCss.primaryHover }};
        --color-primary-soft: {{ menu.primaryColorCss.primarySoft }};
        {% endif %}
        {% if menu.secondaryColorCss %}
        --color-secondary: {{ menu.secondaryColorCss.secondary }};
        --color-secondary-hover: {{ menu.secondaryColorCss.secondaryHover }};
        --color-secondary-text: {{ menu.secondaryColorCss.secondaryText }};
        --color-secondary-soft: {{ menu.secondaryColorCss.secondarySoft }};
        {% endif %}
        {% if menu.fontTheme == 'modern' %}
        {# IBM Plex Sans Arabic is already self-hosted as the Arabic
           fallback face (src/styles/fonts.css); the "modern" theme just
           promotes it ahead of Thmanyah rather than loading anything
           new. It has no serif display face, so --font-display reuses
           the same sans stack instead of falling back to Thmanyah's. #}
        --font-sans: 'IBM Plex Sans Arabic', 'Inter', 'Thmanyah', 'Segoe UI', Tahoma, sans-serif;
        --font-display: 'IBM Plex Sans Arabic', 'Inter', 'Segoe UI', Tahoma, sans-serif;
        {% endif %}
        {% if menu.cornerStyleCss %}
        --radius-sm: {{ menu.cornerStyleCss.radiusSm }};
        --radius-md: {{ menu.cornerStyleCss.radiusMd }};
        --radius-lg: {{ menu.cornerStyleCss.radiusLg }};
        {% endif %}
        {% if menu.backgroundColorCss %}
        --color-bg: {{ menu.backgroundColorCss }};
        {% endif %}
        {% if menu.buttonShapeCss %}
        --radius-button: {{ menu.buttonShapeCss.radiusButton }};
        {% endif %}
      }
    </style>
  {% endif %}
</head>
<body
  class="min-h-screen bg-bg text-text font-sans antialiased {{ 'embed-frame' if embed }}"
  data-restaurant-slug="{{ menu.slug }}"
  data-menu-density="{{ menu.menuDensity }}"
  data-card-style="{{ menu.cardStyle }}"
  data-category-divider="{{ menu.categoryDivider }}"
  data-background-style="{{ menu.backgroundStyle }}"
  data-background-pattern="{{ menu.backgroundPattern }}"
  {% if menu.backgroundStyle == 'image' and menu.backgroundImageUrl %}
  style="background-image: url('{{ menu.backgroundImageUrl }}'); background-size: cover; background-position: top center; background-repeat: no-repeat;"
  {% endif %}
>
  {% block content %}{% endblock %}

  {{ toastHost() }}

  <script defer src="/js/scroll-restore.js"></script>
  {% block scripts %}{% endblock %}
</body>
</html>
