{% from "components/toast.njk" import toastHost %}
<!DOCTYPE html>
<html lang="{{ locale }}" dir="{{ dir }}" class="{{ 'embed-frame' if embed }}">
<head>
  <title>{% block title %}{{ t('common.app.name') }}{% endblock %}</title>
  <meta name="description" content="{% block meta_description %}{{ t('common.home.subtitle') }}{% endblock %}">
  {# Must load before partials/head.njk's alpine.min.js tag -- Alpine's
     CDN build starts on a queued microtask right after its own script
     runs, not on DOMContentLoaded, so a store registered any later than
     this finds Alpine already started. See the comment in
     partials/head.njk for the full explanation. #}
  {% if (menu.whatsappUrl and menu.orderingEnabled) or tableOrder %}
    <script defer src="{{ asset('/js/whatsapp-message.js') }}"></script>
    {% if not tableOrder %}<script defer src="{{ asset('/js/guest-contact.js') }}"></script>{% endif %}
    <script defer src="{{ asset('/js/selection.js') }}"></script>
  {% endif %}
  <script defer src="{{ asset('/js/suggestions.js') }}"></script>
  {% if tableOrder %}
    <meta name="csrf-token" content="{{ csrfToken }}">
    <script defer src="{{ asset('/js/vendor/socket.io.min.js') }}"></script>
    <script defer src="{{ asset('/js/table-order.js') }}"></script>
  {% endif %}
  {% include "partials/head.njk" %}
  {% if seo and not embed %}
    <link rel="canonical" href="{{ seo.canonicalUrl }}">
    <meta property="og:type" content="restaurant.restaurant">
    <meta property="og:title" content="{{ menu.name }}">
    <meta property="og:description" content="{{ menu.description or menu.name }}">
    <meta property="og:url" content="{{ seo.canonicalUrl }}">
    <meta property="og:locale" content="{{ 'ar_AR' if locale == 'ar' else 'en_US' }}">
    <meta name="twitter:card" content="{{ 'summary_large_image' if seo.imageUrl else 'summary' }}">
    {% if seo.imageUrl %}
      <meta property="og:image" content="{{ seo.imageUrl }}">
      <meta name="twitter:image" content="{{ seo.imageUrl }}">
    {% endif %}
    <script type="application/ld+json">{{ seo.jsonLd | safe }}</script>
  {% endif %}
  {# B4: per-restaurant manifest, not a site-wide one -- start_url/scope
     need to point at this exact slug so "Add to Home Screen" installs a
     shortcut to this menu specifically. Skipped entirely in the
     branding page's own iframe preview (embed=1): an iframe can't be
     "installed," and a nested manifest link there would just be dead
     weight. #}
  {% if menu and not embed %}
    <link rel="manifest" href="/m/{{ menu.slug }}/manifest.webmanifest">
    {% if menu.primaryColorCss %}
      <meta name="theme-color" content="{{ menu.primaryColorCss.primary }}">
    {% endif %}
  {% endif %}
  {# A4: a restaurant's own brand color overrides the Zaytoun default
     tokens (src/styles/tokens.css) for this page only -- scoped here
     via inline :root, not by editing the shared stylesheet, so every
     other restaurant's menu keeps the default palette. #}
  {% if menu.primaryColorCss or menu.secondaryColorCss or menu.fontTheme == 'modern' or menu.fontTheme == 'clean' or menu.cornerStyleCss or menu.backgroundColorCss or menu.buttonShapeCss %}
    <style>
      :root {
        {% if menu.primaryColorCss %}
        --color-primary: {{ menu.primaryColorCss.primary }};
        --color-primary-hover: {{ menu.primaryColorCss.primaryHover }};
        --color-primary-soft: {{ menu.primaryColorCss.primarySoft }};
        --color-primary-text: {{ menu.primaryColorCss.primaryText }};
        {% endif %}
        {% if menu.secondaryColorCss %}
        --color-secondary: {{ menu.secondaryColorCss.secondary }};
        --color-secondary-hover: {{ menu.secondaryColorCss.secondaryHover }};
        --color-secondary-text: {{ menu.secondaryColorCss.secondaryText }};
        --color-secondary-soft: {{ menu.secondaryColorCss.secondarySoft }};
        {% endif %}
        {% if menu.fontTheme == 'clean' %}
        --font-sans: 'Inter', 'IBM Plex Sans Arabic', 'Segoe UI', Tahoma, sans-serif;
        --font-display: 'Inter', 'IBM Plex Sans Arabic', 'Segoe UI', Tahoma, sans-serif;
        {% elif menu.fontTheme == 'modern' %}
        {# The "modern" theme swaps Tajawal for IBM Plex Sans Arabic, which is
           already self-hosted, so nothing new is loaded. #}
        --font-sans: 'IBM Plex Sans Arabic', 'Inter', 'Segoe UI', Tahoma, sans-serif;
        --font-display: 'IBM Plex Sans Arabic', 'Inter', 'Segoe UI', Tahoma, sans-serif;
        {% endif %}
        {% if menu.cornerStyleCss %}
        --radius-sm: {{ menu.cornerStyleCss.radiusSm }};
        --radius-md: {{ menu.cornerStyleCss.radiusMd }};
        --radius-lg: {{ menu.cornerStyleCss.radiusLg }};
        --radius-card: {{ menu.cornerStyleCss.radiusCard }};
        {% endif %}
        {% if menu.backgroundColorCss %}
        --color-bg: {{ menu.backgroundColorCss }};
        {% endif %}
        {% if menu.buttonShapeCss %}
        --radius-button: {{ menu.buttonShapeCss.radiusButton }};
        {% endif %}
      }
    </style>
  {% endif %}
</head>
<body
  class="min-h-screen bg-bg text-text font-sans antialiased {{ 'embed-frame' if embed }}"
  data-restaurant-slug="{{ menu.slug }}"
  data-menu-density="{{ menu.menuDensity }}"
  data-card-style="{{ menu.cardStyle }}"
  data-category-divider="{{ menu.categoryDivider }}"
  data-menu-layout="{{ menu.menuLayout }}"
  data-custom-bg="{{ 'true' if (menu.backgroundColorCss or menu.backgroundStyle == 'pattern') else 'false' }}"
  data-item-images="{{ menu.itemImages }}"
  data-image-shape="{{ menu.itemImageShape }}"
  data-category-marker="{{ menu.categoryMarker }}"
  data-logo-shape="{{ menu.logoShape }}"
  data-cover-height="{{ menu.coverHeight }}"
  data-price-style="{{ menu.priceStyle }}"
  data-heading-align="{{ menu.headingAlign }}"
  data-background-style="{{ menu.backgroundStyle }}"
  data-background-pattern="{{ menu.backgroundPattern }}"
  data-section-spacing="{{ menu.sectionSpacing }}"
  {% if menu.backgroundStyle == 'image' and menu.backgroundImageUrl %}
  style="background-image: url('{{ menu.backgroundImageUrl }}'); background-size: cover; background-position: top center; background-repeat: no-repeat;"
  {% endif %}
>
  {% include "partials/skip-link.njk" %}
  {% block content %}{% endblock %}

  {{ toastHost() }}

  <script defer src="{{ asset('/js/scroll-restore.js') }}"></script>
  {% if menu and not embed %}
    <script defer src="{{ asset('/js/pwa.js') }}"></script>
  {% endif %}
  {% block scripts %}{% endblock %}
</body>
</html>
