{% from "components/toast.njk" import toastHost %}
<!DOCTYPE html>
<html lang="{{ locale }}" dir="{{ dir }}">
<head>
  <title>{% block title %}{{ t('common.admin.nav.dashboard') }}{% endblock %}</title>
  <meta name="description" content="{{ t('common.admin.nav.dashboard') }}">
  {% include "partials/head.njk" %}
</head>
<body
  class="min-h-screen bg-bg text-text font-sans antialiased"
  hx-headers='{"X-CSRF-Token": "{{ csrfToken }}"}'
>
  <header class="border-b border-border bg-surface">
    <div class="mx-auto flex max-w-3xl flex-wrap items-center justify-between gap-3 px-4 py-4">
      <div class="flex items-center gap-4">
        <a href="/admin" class="text-lg font-bold">{{ t('common.app.name') }}</a>
        <nav class="flex items-center gap-2 text-sm">
          <a href="/admin" class="min-h-11 inline-flex items-center rounded-md px-3 hover:bg-muted-surface">{{ t('common.admin.nav.categories') }}</a>
          <a href="/admin/qr" class="min-h-11 inline-flex items-center rounded-md px-3 hover:bg-muted-surface">{{ t('common.admin.nav.qr') }}</a>
          {% if restaurantSlug %}
            <a href="/m/{{ restaurantSlug }}" target="_blank" rel="noopener noreferrer" class="min-h-11 inline-flex items-center rounded-md px-3 hover:bg-muted-surface">{{ t('common.admin.nav.previewMenu') }}</a>
          {% endif %}
        </nav>
      </div>
      <form method="post" action="/admin/logout" class="flex items-center gap-3">
        {% if adminName %}
          <span class="text-sm text-muted-text">{{ t('common.admin.auth.loggedInAs', { name: adminName }) }}</span>
        {% endif %}
        <input type="hidden" name="csrf_token" value="{{ csrfToken }}">
        <button type="submit" class="min-h-11 inline-flex items-center rounded-md border border-border px-3 text-sm font-medium hover:bg-muted-surface focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary">
          {{ t('common.admin.auth.logout') }}
        </button>
      </form>
    </div>
  </header>

  <main class="mx-auto max-w-3xl px-4 py-8">
    {% block content %}{% endblock %}
  </main>

  {{ toastHost() }}
  {% block scripts %}{% endblock %}
</body>
</html>
