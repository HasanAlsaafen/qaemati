{% from "components/toast.njk" import toastHost %}
{% from "components/language-switcher.njk" import languageSwitcher %}
<!DOCTYPE html>
<html lang="{{ locale }}" dir="{{ dir }}">
<head>
  <title>{% block title %}{{ t('common.admin.nav.dashboard') }}{% endblock %}</title>
  <meta name="description" content="{{ t('common.admin.nav.dashboard') }}">
  {% include "partials/head.njk" %}
</head>
{#
  Sidebar replaces the old top nav bar (kept for mobile, as a slim bar
  with a hamburger opening the same links in an overlay drawer -- same
  "collapse to a drawer below sm" pattern the old nav already used, just
  applied to a vertical list instead of a horizontal one).

  "collapsed" (icon-only, desktop only) is a per-viewer convenience, so it
  lives in localStorage rather than being threaded through every admin
  controller -- wrapped in try/catch since a private window or blocked
  site data can make localStorage throw (see artifact-authoring
  guidance's "browser storage" note, the same caution applies to any
  localStorage use, not just artifacts).
#}
<body
  class="min-h-screen bg-bg text-text font-sans antialiased"
  hx-headers='{"X-CSRF-Token": "{{ csrfToken }}"}'
  x-data="{
    navOpen: false,
    collapsed: false,
    init() {
      try {
        this.collapsed = localStorage.getItem('qaemati_admin_sidebar_collapsed') === 'true';
      } catch (e) {}
    },
    toggleCollapsed() {
      this.collapsed = !this.collapsed;
      try {
        localStorage.setItem('qaemati_admin_sidebar_collapsed', this.collapsed.toString());
      } catch (e) {}
    },
  }"
>
  {% include "partials/skip-link.njk" %}
  <div class="flex min-h-screen flex-col sm:flex-row">
    <aside
      class="hidden shrink-0 border-e border-border bg-surface transition-[width] duration-base ease-standard sm:sticky sm:top-0 sm:flex sm:h-screen sm:flex-col sm:overflow-y-auto"
      x-bind:class="collapsed ? 'sm:w-16' : 'sm:w-56'"
    >
      <div class="flex h-14 items-center px-3" x-bind:class="collapsed ? 'justify-center' : 'justify-between'">
        <a href="/admin" class="inline-flex min-h-11 items-center truncate text-lg font-bold" x-show="!collapsed">{{ t('common.app.name') }}</a>
        <button
          type="button"
          class="inline-flex h-11 w-11 shrink-0 items-center justify-center rounded-md text-muted-text hover:bg-muted-surface focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary"
          x-on:click="toggleCollapsed()"
          x-bind:aria-expanded="(!collapsed).toString()"
          aria-label="{{ t('common.admin.nav.toggleSidebar') }}"
        >
          <svg width="18" height="18" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true" class="rtl:-scale-x-100" x-bind:class="collapsed ? 'rotate-180 rtl:rotate-0' : ''"><path d="M10 3L5 8l5 5" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </button>
      </div>

      <nav class="flex flex-1 flex-col gap-1 px-2 py-2 text-sm">
        {% set navItems = [
          { href: '/admin', label: t('common.admin.nav.categories'), icon: 'categories' },
          { href: '/admin/pos', label: t('common.admin.nav.pos'), icon: 'pos', feature: 'tableOrdering' },
          { href: '/admin/analytics', label: t('common.admin.nav.analytics'), icon: 'analytics', feature: 'analytics' },
          { href: '/admin/bulk', label: t('common.admin.nav.bulk'), icon: 'bulk', feature: 'bulkTools' },
          { href: '/admin/qr', label: t('common.admin.nav.qr'), icon: 'qr' },
          { href: '/admin/branding', label: t('common.admin.nav.branding'), icon: 'branding' },
          { href: '/admin/billing', label: t('common.admin.nav.billing'), icon: 'billing' }
        ] %}
        {% for item in navItems %}
          {% if not item.feature or (tenant and item.feature in tenant.features) %}
          <a
            href="{{ item.href }}"
            title="{{ item.label }}"
            class="flex min-h-11 items-center gap-3 rounded-md px-3 hover:bg-muted-surface"
            x-bind:class="collapsed ? 'justify-center' : ''"
          >
            {% include "admin/components/sidebar-icons/" + item.icon + ".njk" %}
            <span x-show="!collapsed" class="truncate">{{ item.label }}</span>
          </a>
          {% endif %}
        {% endfor %}

        {% if restaurantSlug %}
          <a
            href="/m/{{ restaurantSlug }}"
            target="_blank"
            rel="noopener noreferrer"
            class="flex min-h-11 items-center gap-3 rounded-md px-3 hover:bg-muted-surface"
            x-bind:class="collapsed ? 'justify-center' : ''"
          >
            {% include "admin/components/sidebar-icons/preview.njk" %}
            <span x-show="!collapsed" class="truncate">{{ t('common.admin.nav.previewMenu') }}</span>
          </a>
        {% endif %}
      </nav>

      <div class="border-t border-border p-2">
        {% if adminName %}
          <p x-show="!collapsed" class="truncate px-3 pb-1 text-xs text-muted-text">{{ t('common.admin.auth.loggedInAs', { name: adminName }) }}</p>
        {% endif %}
        <div x-show="!collapsed" class="px-1 pb-2">{{ languageSwitcher(otherLocale, t('common.nav.language')) }}</div>
        <form method="post" action="/admin/logout">
          <input type="hidden" name="csrf_token" value="{{ csrfToken }}">
          <button
            type="submit"
            class="flex min-h-11 w-full items-center gap-3 rounded-md border border-border px-3 text-sm font-medium hover:bg-muted-surface focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary"
            x-bind:class="collapsed ? 'justify-center' : ''"
          >
            {% include "admin/components/sidebar-icons/logout.njk" %}
            <span x-show="!collapsed">{{ t('common.admin.auth.logout') }}</span>
          </button>
        </form>
      </div>
    </aside>

    <div class="flex min-w-0 flex-1 flex-col">
      <header class="border-b border-border bg-surface sm:hidden">
        <div class="flex items-center justify-between gap-3 px-4 py-3">
          <a href="/admin" class="inline-flex min-h-11 items-center text-lg font-bold">{{ t('common.app.name') }}</a>
          <div class="ms-auto">{{ languageSwitcher(otherLocale, t('common.nav.language')) }}</div>
          <button
            type="button"
            class="inline-flex h-11 w-11 items-center justify-center rounded-md text-text hover:bg-muted-surface focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary"
            aria-label="{{ t('common.admin.nav.toggleMenu') }}"
            x-bind:aria-expanded="navOpen.toString()"
            aria-controls="admin-mobile-nav"
            x-on:click="navOpen = !navOpen"
          >
            <svg x-show="!navOpen" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M4 6h16M4 12h16M4 18h16" stroke-linecap="round"/></svg>
            <svg x-show="navOpen" x-cloak width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18" stroke-linecap="round"/></svg>
          </button>
        </div>

        <div id="admin-mobile-nav" x-show="navOpen" x-cloak class="border-t border-border px-4 py-3">
          <nav class="flex flex-col gap-1 text-sm">
            {% for item in navItems %}
              {% if not item.feature or (tenant and item.feature in tenant.features) %}
                <a href="{{ item.href }}" class="min-h-11 inline-flex items-center rounded-md px-3 hover:bg-muted-surface">{{ item.label }}</a>
              {% endif %}
            {% endfor %}
            {% if restaurantSlug %}
              <a href="/m/{{ restaurantSlug }}" target="_blank" rel="noopener noreferrer" class="min-h-11 inline-flex items-center rounded-md px-3 hover:bg-muted-surface">{{ t('common.admin.nav.previewMenu') }}</a>
            {% endif %}
          </nav>
          <div class="mt-3 flex flex-col gap-2 border-t border-border pt-3">
            {% if adminName %}
              <span class="text-sm text-muted-text">{{ t('common.admin.auth.loggedInAs', { name: adminName }) }}</span>
            {% endif %}
            <form method="post" action="/admin/logout">
              <input type="hidden" name="csrf_token" value="{{ csrfToken }}">
              <button type="submit" class="min-h-11 w-full inline-flex items-center justify-center rounded-md border border-border px-3 text-sm font-medium hover:bg-muted-surface focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary">
                {{ t('common.admin.auth.logout') }}
              </button>
            </form>
          </div>
        </div>
      </header>

      {#
        max-w-3xl fits every admin page's single-column forms/lists. The
        branding page overrides it (mainWidth block) to make room for its
        two-column form+live-preview layout -- at the default width, that
        grid's 1fr column and the preview's fixed-width phone frame were
        both squeezed into ~700px, producing a squashed form with a
        cut-off phone preview.
      #}
      {% include "admin/components/billing-banner.njk" %}

      <main id="main-content" tabindex="-1" class="mx-auto w-full {% block mainWidth %}max-w-3xl{% endblock %} px-4 py-8 focus:outline-none">
        {% block content %}{% endblock %}
      </main>
    </div>
  </div>

  {{ toastHost() }}
  {% include "admin/components/guided-tour.njk" %}
  <script defer src="{{ asset('/js/form-errors.js') }}"></script>
  {% block scripts %}{% endblock %}
</body>
</html>
