{% from "components/toast.njk" import toastHost %}
<!DOCTYPE html>
<html lang="{{ locale }}" dir="{{ dir }}">
<head>
  <title>{% block title %}{{ t('common.admin.nav.dashboard') }}{% endblock %}</title>
  <meta name="description" content="{{ t('common.admin.nav.dashboard') }}">
  {% include "partials/head.njk" %}
</head>
<body
  class="min-h-screen bg-bg text-text font-sans antialiased"
  hx-headers='{"X-CSRF-Token": "{{ csrfToken }}"}'
>
  <header class="border-b border-border bg-surface" x-data="{ navOpen: false }">
    <div class="mx-auto flex max-w-3xl items-center justify-between gap-3 px-4 py-3">
      <a href="/admin" class="text-lg font-bold">{{ t('common.app.name') }}</a>

      <nav class="hidden items-center gap-2 text-sm sm:flex">
        <a href="/admin" class="min-h-11 inline-flex items-center rounded-md px-3 hover:bg-muted-surface">{{ t('common.admin.nav.categories') }}</a>
        <a href="/admin/qr" class="min-h-11 inline-flex items-center rounded-md px-3 hover:bg-muted-surface">{{ t('common.admin.nav.qr') }}</a>
        <a href="/admin/branding" class="min-h-11 inline-flex items-center rounded-md px-3 hover:bg-muted-surface">{{ t('common.admin.nav.branding') }}</a>
        {% if restaurantSlug %}
          <a href="/m/{{ restaurantSlug }}" target="_blank" rel="noopener noreferrer" class="min-h-11 inline-flex items-center rounded-md px-3 hover:bg-muted-surface">{{ t('common.admin.nav.previewMenu') }}</a>
        {% endif %}
      </nav>
      <form method="post" action="/admin/logout" class="hidden items-center gap-3 sm:flex">
        {% if adminName %}
          <span class="text-sm text-muted-text">{{ t('common.admin.auth.loggedInAs', { name: adminName }) }}</span>
        {% endif %}
        <input type="hidden" name="csrf_token" value="{{ csrfToken }}">
        <button type="submit" class="min-h-11 inline-flex items-center rounded-md border border-border px-3 text-sm font-medium hover:bg-muted-surface focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary">
          {{ t('common.admin.auth.logout') }}
        </button>
      </form>

      <button
        type="button"
        class="inline-flex h-11 w-11 items-center justify-center rounded-md text-text hover:bg-muted-surface focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary sm:hidden"
        aria-label="{{ t('common.admin.nav.toggleMenu') }}"
        x-bind:aria-expanded="navOpen.toString()"
        aria-controls="admin-mobile-nav"
        x-on:click="navOpen = !navOpen"
      >
        <svg x-show="!navOpen" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M4 6h16M4 12h16M4 18h16" stroke-linecap="round"/></svg>
        <svg x-show="navOpen" x-cloak width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18" stroke-linecap="round"/></svg>
      </button>
    </div>

    <div id="admin-mobile-nav" x-show="navOpen" x-cloak class="border-t border-border px-4 py-3 sm:hidden">
      <nav class="flex flex-col gap-1 text-sm">
        <a href="/admin" class="min-h-11 inline-flex items-center rounded-md px-3 hover:bg-muted-surface">{{ t('common.admin.nav.categories') }}</a>
        <a href="/admin/qr" class="min-h-11 inline-flex items-center rounded-md px-3 hover:bg-muted-surface">{{ t('common.admin.nav.qr') }}</a>
        <a href="/admin/branding" class="min-h-11 inline-flex items-center rounded-md px-3 hover:bg-muted-surface">{{ t('common.admin.nav.branding') }}</a>
        {% if restaurantSlug %}
          <a href="/m/{{ restaurantSlug }}" target="_blank" rel="noopener noreferrer" class="min-h-11 inline-flex items-center rounded-md px-3 hover:bg-muted-surface">{{ t('common.admin.nav.previewMenu') }}</a>
        {% endif %}
      </nav>
      <div class="mt-3 flex flex-col gap-2 border-t border-border pt-3">
        {% if adminName %}
          <span class="text-sm text-muted-text">{{ t('common.admin.auth.loggedInAs', { name: adminName }) }}</span>
        {% endif %}
        <form method="post" action="/admin/logout">
          <input type="hidden" name="csrf_token" value="{{ csrfToken }}">
          <button type="submit" class="min-h-11 w-full inline-flex items-center justify-center rounded-md border border-border px-3 text-sm font-medium hover:bg-muted-surface focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary">
            {{ t('common.admin.auth.logout') }}
          </button>
        </form>
      </div>
    </div>
  </header>

  <main class="mx-auto max-w-3xl px-4 py-8">
    {% block content %}{% endblock %}
  </main>

  {{ toastHost() }}
  {% block scripts %}{% endblock %}
</body>
</html>
