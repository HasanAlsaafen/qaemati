{% from "components/language-switcher.njk" import languageSwitcher %}
{% from "components/toast.njk" import toastHost %}
<!DOCTYPE html>
<html lang="{{ locale }}" dir="{{ dir }}">
<head>
  <title>{% block title %}{{ t('common.app.name') }}{% endblock %}</title>
  <meta name="description" content="{% block meta_description %}{{ t('common.home.subtitle') }}{% endblock %}">
  {% include "partials/head.njk" %}
</head>
<body class="min-h-screen bg-bg text-text font-sans antialiased">
  <header class="border-b border-border bg-surface">
    <div class="mx-auto flex max-w-3xl items-center justify-between px-4 py-4">
      <span class="text-lg font-bold">{{ t('common.app.name') }}</span>
      {{ languageSwitcher(otherLocale, t('common.nav.language')) }}
    </div>
  </header>

  <main class="mx-auto max-w-3xl px-4 py-10">
    {% block content %}{% endblock %}
  </main>

  {{ toastHost() }}
</body>
</html>
