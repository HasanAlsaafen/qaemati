<!DOCTYPE html>
<html lang="{{ locale }}" dir="{{ dir }}">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{% block title %}{{ t('common.app.name') }}{% endblock %}</title>
  <link rel="stylesheet" href="/css/app.css">
</head>
<body class="min-h-screen bg-bg text-text font-sans antialiased">
  <header class="border-b border-border bg-surface">
    <div class="mx-auto flex max-w-3xl items-center justify-between px-4 py-4">
      <span class="text-lg font-semibold">{{ t('common.app.name') }}</span>
      <a
        href="/lang/{{ otherLocale }}"
        class="rounded-md border border-border px-3 py-2 text-sm font-medium text-text hover:bg-muted-surface"
      >
        {{ t('common.nav.language') }}
      </a>
    </div>
  </header>

  <main class="mx-auto max-w-3xl px-4 py-10">
    {% block content %}{% endblock %}
  </main>
</body>
</html>
