{% extends "layouts/admin.njk" %}

{% block title %}{{ t('common.billing.page.title') }}{% endblock %}

{% block content %}
<h1 class="font-sans text-2xl font-bold text-text">{{ t('common.billing.page.title') }}</h1>

{% if not subscription %}
  <p class="mt-4 text-sm text-muted-text">{{ t('common.billing.page.noSubscription') }}</p>
{% else %}
  <section class="mt-4 rounded-lg border border-border bg-surface p-4" aria-labelledby="plan-heading">
    <div class="flex flex-wrap items-start justify-between gap-3">
      <div>
        <h2 id="plan-heading" class="font-sans text-lg font-bold text-text">{{ plan.nameEn if locale == 'en' else plan.nameAr }}</h2>
        <p class="text-sm text-muted-text">
          {% if plan.priceAmount | money != '0.00' %}
            <span dir="ltr">{{ plan.priceAmount | money }} {{ plan.currency | symbol(locale) }}</span>
            / {{ t('common.billing.interval.' + plan.interval) }}
          {% else %}
            {{ t('common.billing.page.noCharge') }}
          {% endif %}
        </p>
      </div>
      <span class="inline-flex items-center rounded-sm px-2 py-1 text-xs font-medium {{ 'bg-success/10 text-success' if access.state == 'ok' else ('bg-primary-soft text-primary-text' if access.state == 'trial' else 'bg-warning/10 text-warning-text') }}">
        {{ t('common.billing.access.' + access.state) }}
      </span>
    </div>

    <dl class="mt-4 grid gap-3 text-sm sm:grid-cols-2">
      <div>
        <dt class="text-muted-text">{{ t('common.billing.page.status') }}</dt>
        <dd class="font-medium text-text">{{ t('common.billing.status.' + subscription.status) }}</dd>
      </div>
      {% if subscription.status == 'TRIALING' and subscription.trialEndsAt %}
        <div>
          <dt class="text-muted-text">{{ t('common.billing.page.trialEnds') }}</dt>
          <dd class="font-medium text-text" dir="ltr">{{ subscription.trialEndsAt | isoDate }}</dd>
        </div>
      {% elif subscription.currentPeriodEnd %}
        <div>
          <dt class="text-muted-text">{{ t('common.billing.page.periodEnds') }}</dt>
          <dd class="font-medium text-text" dir="ltr">{{ subscription.currentPeriodEnd | isoDate }}</dd>
        </div>
      {% else %}
        <div>
          <dt class="text-muted-text">{{ t('common.billing.page.periodEnds') }}</dt>
          <dd class="font-medium text-text">{{ t('common.billing.page.noEnd') }}</dd>
        </div>
      {% endif %}
      {% if access.state == 'grace' and access.blockAt %}
        <div>
          <dt class="text-muted-text">{{ t('common.billing.page.offlineOn') }}</dt>
          <dd class="font-medium text-danger" dir="ltr">{{ access.blockAt | isoDate }}</dd>
        </div>
      {% endif %}
    </dl>
    <p class="mt-4 text-sm text-muted-text">{{ t('common.billing.page.contact') }}</p>
  </section>

  <section class="mt-6 rounded-lg border border-border bg-surface p-4" aria-labelledby="usage-heading">
    <h2 id="usage-heading" class="font-sans text-lg font-bold text-text">{{ t('common.billing.page.usage') }}</h2>
    <ul class="mt-3 flex flex-col gap-3">
      {% for row in resources %}
        <li>
          <div class="flex items-baseline justify-between gap-3 text-sm">
            <span class="text-text">{{ t('common.billing.resource.' + row.resource) }}</span>
            <span class="text-muted-text" dir="ltr">
              {{ row.used }} / {% if row.limit is number %}{{ row.limit }}{% else %}{{ t('common.billing.unlimited') }}{% endif %}
            </span>
          </div>
          {% if row.limit is number and row.limit > 0 %}
            {% set percent = row.used | percentOf(row.limit) %}
            <div class="mt-1 h-2 overflow-hidden rounded-full bg-muted-surface" aria-hidden="true">
              <div class="h-full rounded-full {{ 'bg-danger' if percent >= 100 else 'bg-primary' }}" style="width: {{ percent }}%"></div>
            </div>
          {% endif %}
        </li>
      {% endfor %}
    </ul>
  </section>

  <section class="mt-6 rounded-lg border border-border bg-surface p-4" aria-labelledby="features-heading">
    <h2 id="features-heading" class="font-sans text-lg font-bold text-text">{{ t('common.billing.page.features') }}</h2>
    <ul class="mt-3 flex flex-col gap-2 text-sm">
      {% for feature in allFeatures %}
        <li class="flex items-center justify-between gap-3">
          <span class="text-text">{{ t('common.billing.feature.' + feature) }}</span>
          <span class="{{ 'text-success' if feature in enabledFeatures else 'text-muted-text' }}">
            {{ t('common.billing.page.included') if feature in enabledFeatures else t('common.billing.page.notIncluded') }}
          </span>
        </li>
      {% endfor %}
    </ul>
  </section>

  <section class="mt-6 rounded-lg border border-border bg-surface p-4" aria-labelledby="payments-heading">
    <h2 id="payments-heading" class="font-sans text-lg font-bold text-text">{{ t('common.billing.page.payments') }}</h2>
    {% if payments.length %}
      <ul class="mt-3 divide-y divide-border">
        {% for payment in payments %}
          <li class="flex flex-wrap items-center justify-between gap-2 py-2 text-sm">
            <div>
              <p class="font-medium text-text" dir="ltr">
                {{ payment.amount | money }} {{ payment.currency | symbol(locale) }}
                {% if payment.status == 'VOID' %}<span class="ms-2 rounded-sm bg-muted-surface px-1.5 py-0.5 text-xs text-muted-text">{{ t('common.billing.page.void') }}</span>{% endif %}
              </p>
              <p class="text-muted-text" dir="ltr">{{ payment.paidAt | isoDate }} · {{ payment.receiptNo | receiptNo }} · {{ t('common.billing.method.' + payment.method) }}</p>
            </div>
            <a href="/admin/billing/receipts/{{ payment.id }}" class="inline-flex min-h-11 items-center font-medium text-primary hover:underline">{{ t('common.billing.page.receipt') }}</a>
          </li>
        {% endfor %}
      </ul>
    {% else %}
      <p class="mt-3 text-sm text-muted-text">{{ t('common.billing.page.noPayments') }}</p>
    {% endif %}
  </section>
{% endif %}
{% endblock %}
