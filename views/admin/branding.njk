{% extends "layouts/admin.njk" %}

{% block title %}{{ labels.branding.title }}{% endblock %}

{# Needs room for the form + 400px live-preview phone side by side --
   see layouts/admin.njk's mainWidth block comment. #}
{% block mainWidth %}max-w-6xl{% endblock %}

{% block scripts %}
  <script defer src="{{ asset('/js/color-contrast.js') }}"></script>
{% endblock %}

{% block content %}
<h1 class="font-sans text-2xl font-bold text-text">{{ labels.branding.title }}</h1>

{#
  The x-data lives here, one level above branding-form.njk's own
  #branding-form div, so the live preview (a sibling of the form, not a
  descendant) can read the same reactive color/font/name state. Only the
  inner #branding-form div gets replaced on save (hx-swap="outerHTML"
  there) -- this wrapper and its Alpine scope, and the preview reading
  from it, survive that swap untouched.
#}
<div
  class="mt-4 grid grid-cols-[minmax(0,1fr)] gap-6 lg:grid-cols-[1fr_400px] lg:items-start"
  x-data="{
    color: {{ (restaurant.primaryColor or '#1565C0') | dump }},
    defaultColor: '#1565C0',
    contrast: null,
    secondaryColor: {{ (restaurant.secondaryColor or '#FF9800') | dump }},
    defaultSecondaryColor: '#FF9800',
    secondaryContrast: null,
    // Whether to still show the server-rendered fieldErrors.primary/
    // secondaryColor message (set from a rejected save). Starts shown
    // (false) when that error exists, and is dismissed the moment the
    // admin actually edits the field again -- the live pass/fail message
    // below it already updates instantly either way, so once they've
    // touched the field the static one is redundant, not just stale.
    primaryColorErrorDismissed: false,
    secondaryColorErrorDismissed: false,
    backgroundColorErrorDismissed: false,
    backgroundColor: {{ (restaurant.backgroundColor or '#F2F9FA') | dump }},
    defaultBackgroundColor: '#F2F9FA',
    backgroundContrast: null,
    look: 'colors',
    lookTabs: ['colors', 'text', 'header', 'layout', 'dishes'],
    lookStep(d) {
      const i = (this.lookTabs.indexOf(this.look) + d + this.lookTabs.length) % this.lookTabs.length;
      this.look = this.lookTabs[i];
      this.$nextTick(() => document.getElementById('look-tab-' + this.look).focus());
    },
    fontTheme: {{ (restaurant.fontTheme or 'classic') | dump }},
    menuDensity: {{ (restaurant.menuDensity or 'comfortable') | dump }},
    cornerStyle: {{ (restaurant.cornerStyle or 'rounded') | dump }},
    cardStyle: {{ (restaurant.cardStyle or 'flat') | dump }},
    buttonShape: {{ (restaurant.buttonShape or 'rounded') | dump }},
    categoryDivider: {{ (restaurant.categoryDivider or 'none') | dump }},
    logoShape: {{ (restaurant.logoShape or 'rounded') | dump }},
    coverHeight: {{ (restaurant.coverHeight or 'medium') | dump }},
    priceStyle: {{ (restaurant.priceStyle or 'plain') | dump }},
    headingAlign: {{ (restaurant.headingAlign or 'start') | dump }},
    themeDecor: {{ (restaurant.themeDecor or 'none') | dump }},
    menuLayout: {{ (restaurant.menuLayout or 'grid') | dump }},
    itemImages: {{ (restaurant.itemImages or 'show') | dump }},
    itemImageShape: {{ (restaurant.itemImageShape or 'standard') | dump }},
    categoryMarker: {{ (restaurant.categoryMarker or 'none') | dump }},
    backgroundStyle: {{ (restaurant.backgroundStyle or 'solid') | dump }},
    backgroundPattern: {{ (restaurant.backgroundPattern or 'dots') | dump }},
    sectionSpacing: {{ (restaurant.sectionSpacing or 'comfortable') | dump }},
    nameAr: {{ restaurant.nameAr | dump }},
    nameEn: {{ restaurant.nameEn | dump }},
    openTime: {{ (restaurant.openTime or '') | dump }},
    closeTime: {{ (restaurant.closeTime or '') | dump }},
    locale: {{ locale | dump }},
    slug: {{ restaurant.slug | dump }},
    themes: {{ themeValues | dump }},
    // Fills the form from a ready-made theme. Nothing is saved until the owner
    // presses Save, and everything stays editable afterwards.
    applyTheme(key) {
      const theme = this.themes[key];
      if (!theme) return;
      Object.assign(this, theme);
      this.primaryColorErrorDismissed = true;
      this.secondaryColorErrorDismissed = true;
      this.backgroundColorErrorDismissed = true;
      this.recomputeContrast();
      this.recomputeSecondaryContrast();
      this.recomputeBackgroundContrast();
      this.$dispatch('toast', { message: {{ t('common.admin.branding.themes.applied') | dump }}, variant: 'success' });
    },
    previewUrl: '',
    // Bumped when a photo is added or removed: the saved look is the same URL,
    // so without it the preview frame would not reload.
    previewRev: 0,
    previewTimer: null,
    passTemplate: {{ labels.branding.contrastPassTemplate | dump }},
    failTemplate: {{ labels.branding.contrastFailTemplate | dump }},
    recomputeContrast() {
      this.contrast = window.checkPrimaryColorContrast ? window.checkPrimaryColorContrast(this.color) : null;
      this.schedulePreview();
    },
    recomputeSecondaryContrast() {
      this.secondaryContrast = window.checkSecondaryColorContrast ? window.checkSecondaryColorContrast(this.secondaryColor) : null;
      this.schedulePreview();
    },
    recomputeBackgroundContrast() {
      this.backgroundContrast = window.checkBackgroundColorContrast ? window.checkBackgroundColorContrast(this.backgroundColor) : null;
      this.schedulePreview();
    },
    // The preview is an iframe of the real /m/:slug route (see
    // menu.controller.ts's preview* query params) -- 'live' here means
    // 'reload that iframe shortly after the admin stops typing/dragging',
    // not a client-side re-render, so every keystroke/drag tick is
    // debounced into one navigation instead of one per input event.
    schedulePreview() {
      clearTimeout(this.previewTimer);
      this.previewTimer = setTimeout(() => this.updatePreviewUrl(), 250);
    },
    updatePreviewUrl() {
      const params = new URLSearchParams({
        lang: this.locale,
        embed: '1',
        previewName: this.locale === 'ar' ? this.nameAr : this.nameEn,
        previewPrimaryColor: this.color,
        previewSecondaryColor: this.secondaryColor,
        previewFontTheme: this.fontTheme,
        previewMenuDensity: this.menuDensity,
        previewCornerStyle: this.cornerStyle,
        previewBackgroundColor: this.backgroundColor,
        previewCardStyle: this.cardStyle,
        previewButtonShape: this.buttonShape,
        previewCategoryDivider: this.categoryDivider,
        previewLogoShape: this.logoShape,
        previewCoverHeight: this.coverHeight,
        previewPriceStyle: this.priceStyle,
        previewHeadingAlign: this.headingAlign,
        previewThemeDecor: this.themeDecor,
        previewMenuLayout: this.menuLayout,
        previewItemImages: this.itemImages,
        previewItemImageShape: this.itemImageShape,
        previewCategoryMarker: this.categoryMarker,
        previewBackgroundStyle: this.backgroundStyle,
        previewBackgroundPattern: this.backgroundPattern,
        previewSectionSpacing: this.sectionSpacing,
        previewRev: String(this.previewRev),
      });
      this.previewUrl = '/m/' + this.slug + '?' + params.toString();
    },
  }"
  x-init="recomputeContrast(); recomputeSecondaryContrast(); recomputeBackgroundContrast(); updatePreviewUrl()"
  x-on:qaemati-preview-refresh.window="previewRev++; updatePreviewUrl()"
>
  <div class="flex min-w-0 flex-col gap-6">
    <section class="rounded-lg border border-border bg-surface p-4" aria-labelledby="themes-title">
      <h2 id="themes-title" class="font-sans text-lg font-bold text-text">{{ t('common.admin.branding.themes.title') }}</h2>
      <p class="mt-1 text-sm text-muted-text">{{ t('common.admin.branding.themes.intro') }}</p>
      <ul class="mt-4 grid grid-cols-2 gap-3 sm:grid-cols-3 xl:grid-cols-4">
        {% for theme in themes %}
          <li>
            <button
              type="button"
              x-on:click="applyTheme('{{ theme.key }}')"
              class="flex h-full w-full flex-col items-start gap-2 rounded-lg border border-border-strong p-3 text-start transition-colors duration-fast ease-standard hover:bg-muted-surface focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary"
            >
              <span class="flex overflow-hidden rounded-full border border-border" aria-hidden="true" dir="ltr">
                <span class="h-7 w-7" style="background: {{ theme.primaryColor }}"></span>
                <span class="h-7 w-7" style="background: {{ theme.secondaryColor }}"></span>
                <span class="h-7 w-7" style="background: {{ theme.backgroundColor }}"></span>
              </span>
              <span class="text-sm font-bold text-text">{{ theme.nameEn if locale == 'en' else theme.nameAr }}</span>
              <span class="text-xs text-muted-text">{{ (theme.descriptionEn if locale == 'en' else theme.descriptionAr) or '' }}</span>
            </button>
          </li>
        {% endfor %}
      </ul>
    </section>
    {% include "admin/partials/branding-images.njk" %}
    {% include "admin/partials/branding-form.njk" %}
  </div>

  {% include "admin/partials/branding-preview.njk" %}
</div>
{% endblock %}
