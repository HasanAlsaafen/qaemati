{% extends "layouts/admin.njk" %}

{% from "admin/components/menus-panel.njk" import menusPanel %}
{% from "admin/components/admin-confirm-dialog.njk" import adminConfirmDialog %}

{% block title %}{{ t('common.admin.categories.title') }}{% endblock %}

{% block content %}
<h1 class="font-sans text-2xl font-bold text-text">{{ t('common.admin.categories.title') }}</h1>

<div class="mt-4">
  {{ menusPanel(menus, activeMenu, categories, labels, menuId) }}
</div>

{{ adminConfirmDialog() }}
{% endblock %}

{% block scripts %}
  <script defer src="/js/vendor/sortable.min.js"></script>
  <script defer src="/js/sortable-admin.js"></script>
{% endblock %}
