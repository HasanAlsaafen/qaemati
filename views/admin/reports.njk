{% extends "layouts/admin.njk" %}

{% set P = 'common.admin.reports.' %}
{% set r = report %}
{% block title %}{{ t(P + 'title') }}{% endblock %}

{% macro duration(seconds, t, P) %}{% if seconds is number %}{% if seconds < 60 %}{{ t(P + 'seconds', { n: seconds }) }}{% else %}{{ t(P + 'minutes', { n: (seconds / 60) | round(1) }) }}{% endif %}{% else %}-{% endif %}{% endmacro %}

{% block content %}
<div class="flex flex-wrap items-center justify-between gap-3">
  <h1 class="font-sans text-2xl font-bold text-text">{{ t(P + 'title') }}</h1>
  <a href="/admin/reports/export.csv?from={{ r.range.from }}&amp;to={{ r.range.to }}" class="inline-flex min-h-11 items-center rounded-md border border-border-strong px-4 text-sm font-medium text-text hover:bg-muted-surface focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary">{{ t(P + 'export') }}</a>
</div>
<p class="mt-2 max-w-2xl text-sm text-muted-text">{{ t(P + 'scope') }}</p>

<nav aria-label="{{ t(P + 'rangeLabel') }}" class="mt-5 flex flex-wrap items-center gap-2">
  {% for preset in ['today', '7d', '30d', '90d'] %}
    <a href="/admin/reports?range={{ preset }}" {% if r.range.preset == preset %}aria-current="true"{% endif %} class="inline-flex min-h-11 items-center rounded-md border px-4 text-sm font-medium focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary {{ 'border-primary bg-primary text-primary-on' if r.range.preset == preset else 'border-border-strong text-text hover:bg-muted-surface' }}">{{ t(P + 'preset' + preset) }}</a>
  {% endfor %}
</nav>
<form method="get" action="/admin/reports" class="mt-3 flex flex-wrap items-end gap-3">
  <div class="flex flex-col gap-1">
    <label for="from" class="text-sm font-medium text-text">{{ t(P + 'from') }}</label>
    <input id="from" name="from" type="date" value="{{ r.range.from }}" class="min-h-11 rounded-md border border-border-strong bg-surface px-3 text-base text-text focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary">
  </div>
  <div class="flex flex-col gap-1">
    <label for="to" class="text-sm font-medium text-text">{{ t(P + 'to') }}</label>
    <input id="to" name="to" type="date" value="{{ r.range.to }}" class="min-h-11 rounded-md border border-border-strong bg-surface px-3 text-base text-text focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary">
  </div>
  <button type="submit" class="inline-flex min-h-11 items-center rounded-md border border-border-strong px-4 text-sm font-medium text-text hover:bg-muted-surface focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary">{{ t(P + 'show') }}</button>
</form>
<p class="mt-2 text-sm text-muted-text" dir="ltr">{{ r.range.from }} to {{ r.range.to }}</p>

{% if r.summary.orders == 0 and r.summary.canceled == 0 and r.calls.total == 0 %}
  <p class="mt-8 rounded-lg border border-dashed border-border p-6 text-center text-muted-text">{{ t(P + 'empty') }}</p>
{% else %}

<dl class="mt-8 grid grid-cols-2 gap-x-6 gap-y-5 border-y border-border py-5 sm:grid-cols-3 lg:grid-cols-5">
  <div><dt class="text-sm text-muted-text">{{ t(P + 'orders') }}</dt><dd class="font-sans text-3xl font-bold text-text" dir="ltr">{{ r.summary.orders }}</dd></div>
  <div><dt class="text-sm text-muted-text">{{ t(P + 'revenue') }}</dt><dd class="font-sans text-3xl font-bold text-text" dir="ltr">{{ r.summary.revenue | money }} {{ (r.currency or 'ILS') | symbol(locale) }}</dd></div>
  <div><dt class="text-sm text-muted-text">{{ t(P + 'average') }}</dt><dd class="font-sans text-3xl font-bold text-text" dir="ltr">{{ r.summary.average | money }} {{ (r.currency or 'ILS') | symbol(locale) }}</dd></div>
  <div><dt class="text-sm text-muted-text">{{ t(P + 'items') }}</dt><dd class="font-sans text-3xl font-bold text-text" dir="ltr">{{ r.summary.items }}</dd></div>
  <div><dt class="text-sm text-muted-text">{{ t(P + 'canceled') }}</dt><dd class="font-sans text-3xl font-bold text-text" dir="ltr">{{ r.summary.canceled }} <span class="text-base font-medium text-muted-text">({{ (r.summary.cancelRate * 100) | round(0) }}%)</span></dd></div>
</dl>
<p class="mt-2 text-sm text-muted-text">{{ t(P + 'revenueNote') }}{% if r.mixedCurrencies %} {{ t(P + 'mixedNote') }}{% endif %}</p>

<section class="mt-10" aria-labelledby="days-title">
  <h2 id="days-title" class="font-sans text-lg font-bold text-text">{{ t(P + 'perDay') }}</h2>
  <div class="mt-3">
    <table class="w-full text-sm">
      <thead class="text-start text-muted-text"><tr><th scope="col" class="py-2 text-start font-medium">{{ t(P + 'date') }}</th><th scope="col" class="py-2 text-start font-medium">{{ t(P + 'orders') }}</th><th scope="col" class="py-2 text-start font-medium">{{ t(P + 'revenue') }}</th><th scope="col" class="hidden w-1/3 py-2 sm:table-cell"><span class="sr-only">{{ t(P + 'share') }}</span></th></tr></thead>
      <tbody class="divide-y divide-border">
        {% for day in r.days %}
          <tr>
            <th scope="row" class="py-2 text-start font-normal text-text" dir="ltr">{{ day.date }}</th>
            <td class="py-2 text-text" dir="ltr">{{ day.orders }}</td>
            <td class="py-2 text-text" dir="ltr">{{ day.revenue | money }}</td>
            <td class="hidden py-2 sm:table-cell" aria-hidden="true"><span class="block h-2 rounded-sm bg-primary" style="width: {{ day.orders | percentOf(r.maxDayOrders) }}%"></span></td>
          </tr>
        {% endfor %}
      </tbody>
    </table>
  </div>
</section>

<div class="mt-10 grid gap-10 lg:grid-cols-2">
  <section aria-labelledby="hours-title">
    <h2 id="hours-title" class="font-sans text-lg font-bold text-text">{{ t(P + 'perHour') }}</h2>
    {% if r.hours.length %}
      <table class="mt-3 w-full text-sm">
        <caption class="sr-only">{{ t(P + 'perHour') }}</caption>
        <tbody class="divide-y divide-border">
          {% for hour in r.hours %}
            <tr>
              <th scope="row" class="w-20 py-2 text-start font-normal text-text" dir="ltr">{{ ('0' + hour.hour) if hour.hour < 10 else hour.hour }}:00</th>
              <td class="w-12 py-2 text-text" dir="ltr">{{ hour.orders }}</td>
              <td class="py-2" aria-hidden="true"><span class="block h-2 rounded-sm bg-primary" style="width: {{ hour.orders | percentOf(r.maxHourOrders) }}%"></span></td>
            </tr>
          {% endfor %}
        </tbody>
      </table>
    {% else %}<p class="mt-3 text-sm text-muted-text">{{ t(P + 'none') }}</p>{% endif %}
  </section>

  <section aria-labelledby="dishes-title">
    <h2 id="dishes-title" class="font-sans text-lg font-bold text-text">{{ t(P + 'topDishes') }}</h2>
    {% if r.dishes.length %}
      <table class="mt-3 w-full text-sm">
        <thead><tr><th scope="col" class="py-2 text-start font-medium text-muted-text">{{ t(P + 'dish') }}</th><th scope="col" class="py-2 text-start font-medium text-muted-text">{{ t(P + 'sold') }}</th><th scope="col" class="py-2 text-start font-medium text-muted-text">{{ t(P + 'revenue') }}</th></tr></thead>
        <tbody class="divide-y divide-border">
          {% for dish in r.dishes %}
            <tr><th scope="row" class="py-2 text-start font-normal text-text">{{ dish.nameAr if locale == 'ar' else dish.nameEn }}</th><td class="py-2 text-text" dir="ltr">{{ dish.quantity }}</td><td class="py-2 text-text" dir="ltr">{{ dish.revenue | money }}</td></tr>
          {% endfor %}
        </tbody>
      </table>
    {% else %}<p class="mt-3 text-sm text-muted-text">{{ t(P + 'none') }}</p>{% endif %}
  </section>
</div>

<section class="mt-10" aria-labelledby="suggested-title">
  <h2 id="suggested-title" class="font-sans text-lg font-bold text-text">{{ t(P + 'suggested') }}</h2>
  {% if r.suggested.total %}
    <p class="mt-1 text-sm text-muted-text">{{ t(P + 'suggestedCount', { n: r.suggested.total }) }}</p>
    <ul class="mt-3 divide-y divide-border text-sm">
      {% for dish in r.suggested.dishes %}
        <li class="flex justify-between gap-3 py-2 text-text"><span>{{ dish.nameAr if locale == 'ar' else dish.nameEn }}</span><span dir="ltr">{{ dish.count }}</span></li>
      {% endfor %}
    </ul>
  {% else %}<p class="mt-3 text-sm text-muted-text">{{ t(P + 'none') }}</p>{% endif %}
</section>

<div class="mt-10 grid gap-10 lg:grid-cols-2">
  <section aria-labelledby="tables-title">
    <h2 id="tables-title" class="font-sans text-lg font-bold text-text">{{ t(P + 'topTables') }}</h2>
    {% if r.tables.length %}
      <table class="mt-3 w-full text-sm">
        <thead><tr><th scope="col" class="py-2 text-start font-medium text-muted-text">{{ t(P + 'table') }}</th><th scope="col" class="py-2 text-start font-medium text-muted-text">{{ t(P + 'orders') }}</th><th scope="col" class="py-2 text-start font-medium text-muted-text">{{ t(P + 'revenue') }}</th></tr></thead>
        <tbody class="divide-y divide-border">
          {% for row in r.tables %}
            <tr><th scope="row" class="py-2 text-start font-normal text-text">{{ row.label }}</th><td class="py-2 text-text" dir="ltr">{{ row.orders }}</td><td class="py-2 text-text" dir="ltr">{{ row.revenue | money }}</td></tr>
          {% endfor %}
        </tbody>
      </table>
    {% else %}<p class="mt-3 text-sm text-muted-text">{{ t(P + 'none') }}</p>{% endif %}
  </section>

  <section aria-labelledby="calls-title">
    <h2 id="calls-title" class="font-sans text-lg font-bold text-text">{{ t(P + 'calls') }}</h2>
    <dl class="mt-3 grid grid-cols-2 gap-x-6 text-sm">
      <div><dt class="text-muted-text">{{ t(P + 'callsTotal') }}</dt><dd class="font-sans text-2xl font-bold text-text" dir="ltr">{{ r.calls.total }}</dd></div>
      <div><dt class="text-muted-text">{{ t(P + 'callsAnswer') }}</dt><dd class="font-sans text-2xl font-bold text-text" dir="ltr">{{ duration(r.calls.averageSeconds, t, P) }}</dd></div>
    </dl>
  </section>
</div>
{% endif %}
{% endblock %}
