{% extends "layouts/base.njk" %}

{% from "components/input.njk" import input %}
{% from "components/button.njk" import button %}

{% block title %}{{ t('common.admin.auth.title') }}{% endblock %}

{% block content %}
<div class="mx-auto max-w-sm rounded-xl border border-border bg-surface p-8 shadow-raised">
  <h1 class="font-sans text-2xl font-bold text-text">{{ t('common.admin.auth.title') }}</h1>

  {% if alreadyLoggedIn %}
    <p class="mt-4 text-sm text-muted-text">{{ t('common.admin.auth.loggedInAs', { name: adminName }) }}</p>
    <a href="{{ redirect }}" class="mt-4 inline-flex min-h-11 items-center justify-center rounded-md bg-primary px-4 text-sm font-medium text-primary-on hover:bg-primary-hover">
      {{ t('common.admin.nav.dashboard') }}
    </a>
  {% else %}
    {% if error %}
      <p class="mt-4 rounded-md bg-danger/10 px-3 py-2 text-sm text-danger" role="alert">{{ error }}</p>
    {% endif %}

    <form method="post" action="/admin/login" class="mt-6 flex flex-col gap-4">
      <input type="hidden" name="csrf_token" value="{{ csrfToken }}">
      <input type="hidden" name="redirect" value="{{ redirect }}">

      {{ input('email', t('common.admin.auth.emailLabel'), 'email', email, '', none, none, 'required autocomplete="username"') }}
      {{ input('password', t('common.admin.auth.passwordLabel'), 'password', '', '', none, none, 'required autocomplete="current-password"') }}

      {{ button(t('common.admin.auth.submit'), 'primary', 'md', 'submit') }}
    </form>
  {% endif %}
</div>
{% endblock %}
