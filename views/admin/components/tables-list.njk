{% from "components/button.njk" import button %}
{% from "components/empty-state.njk" import emptyState %}
{% from "admin/components/table-row.njk" import tableRow %}

{#
  Wraps every table row. A move swaps this whole element
  (hx-target="#tables-list"), same reasoning as categories-list.njk.
#}
{% macro tablesList(tables, labels) %}
  <div id="tables-list" x-data="{ adding: false }" class="mt-3 flex flex-col gap-3">
    {% if tables.length %}
      {% for table in tables %}
        {{ tableRow(table, labels, loop.first, loop.last) }}
      {% endfor %}
    {% else %}
      {{ emptyState(labels.qr.emptyTitle, labels.qr.emptyDescription) }}
    {% endif %}

    <div>
      <button
        type="button"
        x-show="!adding"
        x-on:click="adding = true"
        class="inline-flex min-h-11 items-center gap-2 rounded-md border border-dashed border-border-strong px-4 text-sm font-medium text-text hover:bg-muted-surface focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary"
      >
        <svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M8 3v10M3 8h10" stroke-linecap="round"/></svg>
        {{ labels.qr.addTable }}
      </button>

      <form
        x-show="adding"
        x-cloak
        hx-post="/admin/qr/tables"
        hx-target="#tables-list"
        hx-swap="outerHTML"
        class="flex flex-wrap items-end gap-3 rounded-md border border-border bg-muted-surface p-3"
      >
        <div class="flex flex-col gap-1.5">
          <label for="new-table-label" class="text-sm font-medium text-text">{{ labels.qr.tableLabel }}</label>
          <input id="new-table-label" name="label" type="text" placeholder="1" class="min-h-11 rounded-md border border-border-strong bg-surface px-3 text-base text-text focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary" required>
        </div>
        {{ button(labels.form.add, 'primary', 'sm', 'submit') }}
        {{ button(labels.form.cancel, 'ghost', 'sm', 'button', 'x-on:click="adding = false"') }}
      </form>
    </div>
  </div>
{% endmacro %}
