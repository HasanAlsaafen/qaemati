{% from "components/toggle.njk" import toggle %}
{% from "components/button.njk" import button %}
{% from "admin/components/delete-trigger.njk" import deleteTrigger %}
{% from "admin/components/options-editor.njk" import optionsEditor %}

{#
  item: { id, categoryId, nameAr, nameEn, descriptionAr, descriptionEn,
          priceFormatted, currency, imagePath, available, tags[] (codes) }
  Edit mode is local Alpine state (x-data), not a server round trip -- only
  Save and the image upload actually hit the server. Keeps the common case
  (open the row, maybe cancel) instant.
#}
{% macro itemRow(item, labels, isFirst, isLast) %}
  <div
    id="item-{{ item.id }}"
    data-sort-id="{{ item.id }}"
    x-data="{ editing: false }"
    class="border-b border-border py-3 last:border-b-0"
  >
    {#
      Stacked on narrow screens, side-by-side from sm: up: the name column
      and the action-button column used to always compete for the same
      row's width, which left almost nothing for the name once every
      control (move x2, toggle, edit, delete) was accounted for -- names
      were truncating to 1-2 characters even in English, not just the
      bidi-direction bug this was first mistaken for (Phase 8 audit, P0-2).
    #}
    <div x-show="!editing" class="flex flex-col gap-2 sm:flex-row sm:items-start sm:gap-3">
      <div class="flex min-w-0 items-start gap-3 sm:flex-1">
        <span
          data-drag-handle
          aria-hidden="true"
          title="{{ labels.form.dragToReorder }}"
          class="-mt-1 -ms-2 inline-flex h-11 w-11 shrink-0 cursor-grab touch-none items-center justify-center text-muted-text"
        >
          <svg width="14" height="14" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"><circle cx="5" cy="4" r="1.3"/><circle cx="11" cy="4" r="1.3"/><circle cx="5" cy="8" r="1.3"/><circle cx="11" cy="8" r="1.3"/><circle cx="5" cy="12" r="1.3"/><circle cx="11" cy="12" r="1.3"/></svg>
        </span>
        {#
          The whole thumbnail is the upload control (a label wrapping a
          hidden file input), not just something shown inside edit mode --
          clicking/tapping it opens the file picker directly, and the
          corner camera badge is an always-visible affordance (not a
          hover reveal, which phone-first admins would never discover).
          An empty item starts with a plain image-outline icon instead of
          a blank box, so "no photo yet" reads as a deliberate empty
          state rather than a broken image.
        #}
        <label
          for="item-{{ item.id }}-image-input"
          class="relative block h-14 w-14 shrink-0 cursor-pointer overflow-hidden rounded-md bg-muted-surface focus-within:outline focus-within:outline-2 focus-within:outline-offset-2 focus-within:outline-primary"
          title="{{ labels.form.image }}"
        >
          {% if item.imagePath %}
            <img src="{{ item.imagePath }}" alt="" width="56" height="56" class="h-full w-full object-cover">
          {% else %}
            <span class="flex h-full w-full items-center justify-center text-muted-text" aria-hidden="true">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><rect x="3" y="5" width="18" height="14" rx="2"/><circle cx="8.5" cy="10" r="1.3"/><path d="M21 16l-5.5-5.5-3 3-2.5-2.5L4 16.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </span>
          {% endif %}
          <span class="absolute bottom-0 end-0 inline-flex h-5 w-5 items-center justify-center rounded-ss-md bg-text/70 text-surface" aria-hidden="true">
            <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M4 7h3l2-2h6l2 2h3v12H4V7Z" stroke-linecap="round" stroke-linejoin="round"/><circle cx="12" cy="13" r="2.8"/></svg>
          </span>
          <span class="sr-only">{{ labels.form.image }}</span>
          <input
            id="item-{{ item.id }}-image-input"
            type="file"
            accept="image/jpeg,image/png,image/webp"
            name="image"
            data-crop-aspect="1.3333"
            class="sr-only"
            hx-post="/admin/items/{{ item.id }}/image"
            hx-trigger="change"
            hx-target="#item-{{ item.id }}"
            hx-swap="outerHTML"
            hx-encoding="multipart/form-data"
          >
        </label>

        <div class="min-w-0 flex-1">
          <p class="break-words text-sm font-bold text-text" dir="ltr">{{ item.nameEn }}</p>
          <p class="break-words text-sm text-muted-text" dir="rtl">{{ item.nameAr }}</p>
          <p class="text-sm text-muted-text" dir="ltr">{{ item.priceFormatted }} {{ item.currency }}</p>
          {% if item.isTodaysSpecial or item.variants.length or item.addons.length %}
            <p class="mt-1 flex flex-wrap gap-1">
              {% if item.isTodaysSpecial %}
                <span class="inline-flex items-center rounded-sm bg-gold px-1.5 py-0.5 text-xs text-on-gold">{{ labels.items.todaysSpecialLabel }}</span>
              {% endif %}
              {% if item.variants.length %}
                <span class="inline-flex items-center rounded-sm bg-primary-soft px-1.5 py-0.5 text-xs text-primary-text">{{ labels.items.variantsLabel }} ({{ item.variants.length }})</span>
              {% endif %}
              {% if item.addons.length %}
                <span class="inline-flex items-center rounded-sm bg-secondary-soft px-1.5 py-0.5 text-xs text-secondary-text">{{ labels.items.addonsLabel }} ({{ item.addons.length }})</span>
              {% endif %}
            </p>
          {% endif %}
          {% if item.tags.length %}
            <p class="mt-1 flex flex-wrap gap-1">
              {% for tag in item.tags %}
                <span class="inline-flex items-center rounded-sm bg-muted-surface px-1.5 py-0.5 text-xs text-muted-text">{{ labels.tags[tag] }}</span>
              {% endfor %}
            </p>
          {% endif %}
        </div>
      </div>

      <div class="flex flex-wrap items-center gap-1 ps-[68px] sm:shrink-0 sm:flex-col sm:items-end sm:gap-1 sm:ps-0">
        <div class="flex items-center gap-1">
          <button
            type="button"
            aria-label="{{ labels.form.moveUp }}"
            {% if isFirst %}disabled{% endif %}
            class="inline-flex h-11 w-11 items-center justify-center rounded-full text-text hover:bg-muted-surface disabled:opacity-30 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary"
            hx-post="/admin/items/{{ item.id }}/move"
            hx-vals='{"direction": "up"}'
            hx-target="#category-{{ item.categoryId }}"
            hx-swap="outerHTML"
          >
            <svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M3 10l5-5 5 5" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </button>
          <button
            type="button"
            aria-label="{{ labels.form.moveDown }}"
            {% if isLast %}disabled{% endif %}
            class="inline-flex h-11 w-11 items-center justify-center rounded-full text-text hover:bg-muted-surface disabled:opacity-30 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary"
            hx-post="/admin/items/{{ item.id }}/move"
            hx-vals='{"direction": "down"}'
            hx-target="#category-{{ item.categoryId }}"
            hx-swap="outerHTML"
          >
            <svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M3 6l5 5 5-5" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </button>
        </div>
        <div class="flex items-center gap-1">
          {{ toggle('available-' + item.id, labels.form.available, item.available, 'hx-patch="/admin/items/' + item.id + '/availability" hx-target="#item-' + item.id + '" hx-swap="outerHTML"') }}
          {% if item.imagePath %}
            <button
              type="button"
              aria-label="{{ labels.items.removeImage }}"
              title="{{ labels.items.removeImage }}"
              class="inline-flex h-11 w-11 items-center justify-center rounded-full text-text hover:bg-muted-surface focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary"
              hx-delete="/admin/items/{{ item.id }}/image"
              hx-target="#item-{{ item.id }}"
              hx-swap="outerHTML"
            >
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="M3 3l18 18" stroke-linecap="round"/></svg>
            </button>
          {% endif %}
          <button
            type="button"
            aria-label="{{ labels.form.edit }}"
            class="inline-flex h-11 w-11 items-center justify-center rounded-full text-text hover:bg-muted-surface focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary"
            x-on:click="editing = true"
          >
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4Z" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </button>
          {{ deleteTrigger(labels.form.delete, labels.items.deleteConfirmTitle, labels.items.deleteConfirmBody, labels.form.delete, labels.form.cancel, '/admin/items/' + item.id, '#item-' + item.id) }}
        </div>
      </div>
    </div>

    <form
      x-show="editing"
      x-cloak
      hx-patch="/admin/items/{{ item.id }}"
      hx-target="#item-{{ item.id }}"
      hx-swap="outerHTML"
      class="flex flex-col gap-3"
    >
      <div class="grid gap-3 sm:grid-cols-2">
        <div class="flex flex-col gap-1.5">
          <label for="item-{{ item.id }}-nameAr" class="text-sm font-medium text-text">{{ labels.form.nameAr }}</label>
          <input id="item-{{ item.id }}-nameAr" name="nameAr" type="text" value="{{ item.nameAr }}" dir="rtl" class="min-h-11 rounded-md border border-border-strong bg-surface px-3 text-base text-text focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary" required>
        </div>
        <div class="flex flex-col gap-1.5">
          <label for="item-{{ item.id }}-nameEn" class="text-sm font-medium text-text">{{ labels.form.nameEn }}</label>
          <input id="item-{{ item.id }}-nameEn" name="nameEn" type="text" value="{{ item.nameEn }}" dir="ltr" class="min-h-11 rounded-md border border-border-strong bg-surface px-3 text-base text-text focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary" required>
        </div>
        <div class="flex flex-col gap-1.5">
          <label for="item-{{ item.id }}-descriptionAr" class="text-sm font-medium text-text">{{ labels.form.descriptionAr }}</label>
          <textarea id="item-{{ item.id }}-descriptionAr" name="descriptionAr" dir="rtl" rows="2" class="rounded-md border border-border-strong bg-surface px-3 py-2 text-base text-text focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary">{{ item.descriptionAr }}</textarea>
        </div>
        <div class="flex flex-col gap-1.5">
          <label for="item-{{ item.id }}-descriptionEn" class="text-sm font-medium text-text">{{ labels.form.descriptionEn }}</label>
          <textarea id="item-{{ item.id }}-descriptionEn" name="descriptionEn" dir="ltr" rows="2" class="rounded-md border border-border-strong bg-surface px-3 py-2 text-base text-text focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary">{{ item.descriptionEn }}</textarea>
        </div>
        <div class="flex flex-col gap-1.5">
          <label for="item-{{ item.id }}-allergenNoteAr" class="text-sm font-medium text-text">{{ labels.form.allergenNoteAr }}</label>
          <textarea id="item-{{ item.id }}-allergenNoteAr" name="allergenNoteAr" dir="rtl" rows="2" class="rounded-md border border-border-strong bg-surface px-3 py-2 text-base text-text focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary">{{ item.allergenNoteAr }}</textarea>
        </div>
        <div class="flex flex-col gap-1.5">
          <label for="item-{{ item.id }}-allergenNoteEn" class="text-sm font-medium text-text">{{ labels.form.allergenNoteEn }}</label>
          <textarea id="item-{{ item.id }}-allergenNoteEn" name="allergenNoteEn" dir="ltr" rows="2" class="rounded-md border border-border-strong bg-surface px-3 py-2 text-base text-text focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary">{{ item.allergenNoteEn }}</textarea>
        </div>
        <div class="flex flex-col gap-1.5">
          <label for="item-{{ item.id }}-price" class="text-sm font-medium text-text">{{ labels.form.price }}</label>
          <input id="item-{{ item.id }}-price" name="price" type="number" min="0" step="0.01" dir="ltr" value="{{ item.priceFormatted }}" class="min-h-11 rounded-md border border-border-strong bg-surface px-3 text-base text-text focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary" required>
        </div>
        <div class="flex flex-col gap-1.5">
          <label for="item-{{ item.id }}-currency" class="text-sm font-medium text-text">{{ labels.form.currency }}</label>
          <input id="item-{{ item.id }}-currency" name="currency" type="text" dir="ltr" value="{{ item.currency }}" maxlength="3" class="min-h-11 rounded-md border border-border-strong bg-surface px-3 text-base text-text focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary" required>
        </div>
      </div>

      <fieldset class="flex flex-wrap gap-3">
        <legend class="text-sm font-medium text-text">{{ labels.form.tags }}</legend>
        {% for code, label in labels.tags %}
          <label class="inline-flex min-h-11 items-center gap-1.5 text-sm text-text">
            <input type="checkbox" name="tags" value="{{ code }}" {% if code in item.tags %}checked{% endif %} class="h-4 w-4 rounded border-border-strong text-primary focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary">
            {{ label }}
          </label>
        {% endfor %}
      </fieldset>
      <p class="text-sm text-muted-text">{{ labels.form.allergenNoteHint }}</p>

      <label class="inline-flex min-h-11 w-fit items-center gap-1.5 text-sm text-text">
        <input type="checkbox" name="isTodaysSpecial" {% if item.isTodaysSpecial %}checked{% endif %} class="h-4 w-4 rounded border-border-strong text-primary focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary">
        {{ labels.items.todaysSpecialLabel }}
      </label>

      {{ optionsEditor('variants', item.variants, labels.items.variantsLabel, labels.items.variantsHint, labels.items.addVariant, labels.form.nameAr, labels.form.nameEn, labels.form.price, labels.items.removeOption) }}
      {{ optionsEditor('addons', item.addons, labels.items.addonsLabel, labels.items.addonsHint, labels.items.addAddon, labels.form.nameAr, labels.form.nameEn, labels.form.price, labels.items.removeOption) }}

      <div class="flex items-center gap-2">
        {{ button(labels.form.save, 'primary', 'sm', 'submit') }}
        {{ button(labels.form.cancel, 'ghost', 'sm', 'button', 'x-on:click="editing = false"') }}
      </div>
    </form>

    {# What to suggest next to this dish. It loads when opened and saves on its own, apart from the form above. #}
    <details x-show="editing" x-cloak class="mt-3 rounded-md border border-border p-3">
      <summary class="inline-flex min-h-11 cursor-pointer items-center text-sm font-medium text-text" hx-get="/admin/items/{{ item.id }}/pairings" hx-trigger="click once" hx-target="#pairings-{{ item.id }}" hx-swap="innerHTML">{{ labels.pairings.title }}</summary>
      <p class="mt-1 text-xs text-muted-text">{{ labels.pairings.hint }}</p>
      <div id="pairings-{{ item.id }}" class="mt-3"></div>
    </details>
  </div>
{% endmacro %}
