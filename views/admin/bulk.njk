{% extends "layouts/admin.njk" %}

{% from "components/empty-state.njk" import emptyState %}
{% from "components/file-input.njk" import fileInput %}

{% block title %}{{ labels.bulk.title }}{% endblock %}

{% block content %}
<h1 class="font-sans text-2xl font-bold text-text">{{ labels.bulk.title }}</h1>

{% if message %}
  {% set toneClass = {
    success: 'border-success/30 bg-success/10 text-success',
    danger: 'border-danger/30 bg-danger/10 text-danger',
    warning: 'border-warning/30 bg-warning/10 text-warning-text'
  } %}
  <div class="mt-4 rounded-md border p-3 text-sm {{ toneClass[message.tone] }}">
    {{ t('common.admin.bulk.' + message.key, message.args) }}
  </div>
{% endif %}

{% if importErrors and importErrors.length %}
  <div class="mt-3 rounded-md border border-border bg-surface p-3 text-sm">
    <p class="font-medium text-text">{{ labels.bulk.importErrorsTitle }}</p>
    <ul class="mt-1 list-inside list-disc text-muted-text">
      {% for err in importErrors %}
        <li>{{ t('common.admin.bulk.lineError', { line: err.line, message: err.message }) }}</li>
      {% endfor %}
    </ul>
  </div>
{% endif %}

{% if undoableLog %}
  {# Every form on this page posts via htmx, targeting/replacing <body>
     (hx-select picks just <body> out of the full-page response) rather
     than a plain POST-and-reload -- the CSV import form below needs
     multipart, and the global X-CSRF-Token header set via hx-headers on
     <body> (layouts/admin.njk) is the only way a multipart POST can
     carry a CSRF token: Express's body parsers never populate req.body
     for multipart/form-data, so doubleCsrfProtection's hidden-field
     fallback can't see a token there (see src/auth/csrf.ts). Using htmx
     uniformly for every action on this page, not just import, keeps all
     four actions consistent instead of having one oddly-different form. #}
  <form hx-post="/admin/bulk/undo" hx-target="body" hx-swap="outerHTML" hx-select="body" class="mt-4 flex flex-wrap items-center gap-3 rounded-md border border-border bg-surface p-3">
    <input type="hidden" name="logId" value="{{ undoableLog.id }}" />
    <p class="flex-1 text-sm text-muted-text">{{ labels.bulk.undoAvailableLabel }}</p>
    <button type="submit" class="min-h-11 rounded-md border border-border-strong px-4 text-sm font-medium text-text hover:bg-muted-surface">
      {{ labels.bulk.undo }}
    </button>
  </form>
{% endif %}

<section class="mt-6 rounded-lg border border-border bg-surface p-4">
  <h2 class="font-sans text-lg font-bold text-text">{{ labels.bulk.importExportTitle }}</h2>
  <div class="mt-3 flex flex-col gap-4 sm:flex-row sm:flex-wrap sm:items-end">
    <a href="/admin/bulk/export.csv" class="inline-flex min-h-11 items-center justify-center rounded-md border border-border-strong px-4 text-sm font-medium text-text hover:bg-muted-surface">
      {{ labels.bulk.exportButton }}
    </a>
    <form hx-post="/admin/bulk/import" hx-encoding="multipart/form-data" hx-target="body" hx-swap="outerHTML" hx-select="body" class="flex min-w-0 flex-1 flex-col gap-2 sm:flex-row sm:items-end">
      <div class="flex min-w-0 flex-1 flex-col gap-1.5">
        <label for="bulk-import-file" class="text-sm font-medium text-text">{{ labels.bulk.importFileLabel }}</label>
        {{ fileInput('bulk-import-file', 'file', '.csv', '', true) }}
      </div>
      <button type="submit" class="inline-flex min-h-11 shrink-0 items-center justify-center rounded-md bg-primary px-4 text-sm font-medium text-primary-on hover:bg-primary-hover">
        {{ labels.bulk.importButton }}
      </button>
    </form>
  </div>
  <p class="mt-2 text-xs text-muted-text">{{ labels.bulk.importHint }}</p>
</section>

{% if items.length %}
  <form hx-post="/admin/bulk/price-change" hx-target="body" hx-swap="outerHTML" hx-select="body" x-data="{ checked: false }">
    <section class="mt-6 rounded-lg border border-border bg-surface p-4">
      <h2 class="font-sans text-lg font-bold text-text">{{ labels.bulk.changePrices }}</h2>
      <p class="text-sm text-muted-text">{{ labels.bulk.changePricesHint }}</p>
      <div class="mt-3 flex flex-wrap items-end gap-3">
        <div class="flex flex-col gap-1.5">
          <label for="bulk-percent" class="text-sm font-medium text-text">{{ labels.bulk.percentLabel }}</label>
          <input id="bulk-percent" type="number" step="0.1" name="percent" dir="ltr" class="min-h-11 w-28 rounded-md border border-border-strong bg-surface px-3 text-base text-text focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary" />
        </div>
        <button type="submit" class="inline-flex min-h-11 items-center justify-center rounded-md bg-primary px-4 text-sm font-medium text-primary-on hover:bg-primary-hover">
          {{ labels.bulk.apply }}
        </button>
        <label class="ms-auto inline-flex min-h-11 cursor-pointer items-center gap-3 text-sm font-medium text-text">
          <input type="checkbox" class="h-5 w-5 accent-primary" x-bind:checked="checked" x-on:change="checked = $event.target.checked; $el.closest('section').querySelectorAll('input[name=itemIds]').forEach(cb => cb.checked = checked)" />
          {{ labels.bulk.selectAll }}
        </label>
      </div>

      <ul class="mt-4 divide-y divide-border border-t border-border">
        {% for item in items %}
          <li class="flex items-center gap-1 py-1">
            <label class="inline-flex h-11 w-11 shrink-0 cursor-pointer items-center justify-center">
              <input type="checkbox" name="itemIds" value="{{ item.id }}" class="h-5 w-5 accent-primary" x-bind:checked="checked" />
              <span class="sr-only">{{ labels.bulk.selectItem | replace('{name}', item.nameEn) }}</span>
            </label>
            <div class="min-w-0 flex-1 py-1">
              <p class="break-words text-sm font-medium text-text" dir="ltr">{{ item.nameEn }}</p>
              <p class="break-words text-sm text-muted-text" dir="rtl">{{ item.nameAr }}</p>
              <p class="mt-0.5 flex flex-wrap gap-x-3 text-sm text-muted-text">
                <span dir="ltr">{{ item.category.nameEn }}</span>
                <span dir="ltr" class="font-medium text-text">{{ item.price }} {{ item.currency }}</span>
              </p>
            </div>
            {# Its own hx-post, independent of the ancestor form's --
               htmx dispatches each element's own hx-* request rather
               than the form's, so this doesn't trigger a price change. #}
            <button
              type="button"
              hx-post="/admin/bulk/items/{{ item.id }}/duplicate"
              hx-target="body"
              hx-swap="outerHTML"
              hx-select="body"
              class="inline-flex min-h-11 min-w-11 shrink-0 items-center justify-center rounded-md border border-border-strong px-3 text-sm font-medium text-text hover:bg-muted-surface focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary"
            >
              {{ labels.bulk.duplicate }}
            </button>
          </li>
        {% endfor %}
      </ul>
    </section>
  </form>
{% else %}
  <div class="mt-6">
    {{ emptyState(labels.bulk.emptyTitle, labels.bulk.emptyDescription) }}
  </div>
{% endif %}
{% endblock %}
