{% from "components/iphone-frame.njk" import iphoneFrame %}
{#
  restaurant: Restaurant row (admin-view-model.ts toRestaurantSettingsView)
  This is an <iframe> of the real public menu route (/m/:slug), not a
  hand-built mockup -- it's the exact same template the real menu page
  renders, so it's pixel-identical by construction instead of by upkeep.
  "Live" means the iframe's src carries the current, unsaved color/font/
  name state as preview* query params (branding.njk's x-data,
  schedulePreview/updatePreviewUrl), which menu.controller.ts/
  menu.service.ts only honor for the logged-in admin's own restaurant --
  see MenuPreviewOverrides's comment in menu.service.ts.
#}
<aside class="flex min-w-0 flex-col items-center gap-2 lg:sticky lg:top-4">
  <p class="text-sm font-medium text-text">{{ labels.branding.previewFrameLabel }}</p>

  {{ iphoneFrame('previewUrl', labels.branding.previewFrameLabel, '', true) }}
</aside>
