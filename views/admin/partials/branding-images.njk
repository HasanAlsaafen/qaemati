{% from "components/file-input.njk" import fileInput %}
{# restaurant: Restaurant row (admin-view-model.ts toRestaurantSettingsView) #}
<section id="branding-images" class="rounded-lg border border-border bg-surface p-4">
  <div class="grid gap-6 sm:grid-cols-2">
    <div>
      <label for="branding-logo-input" class="text-sm font-medium text-text">{{ labels.branding.logoLabel }}</label>
      <div class="mt-2 flex flex-col items-start gap-3 sm:flex-row sm:items-center">
        <span class="h-16 w-16 shrink-0 overflow-hidden rounded-full bg-muted-surface">
          {% if restaurant.logoPath %}
            <img src="{{ restaurant.logoPath }}" alt="" width="64" height="64" class="h-full w-full object-cover">
          {% endif %}
        </span>
        {{ fileInput('branding-logo-input', 'image', 'image/jpeg,image/png,image/webp', 'data-crop-aspect="1" data-crop-round="true" hx-post="/admin/branding/logo" hx-trigger="change" hx-target="#branding-images" hx-swap="outerHTML" hx-encoding="multipart/form-data" hx-on::after-request="window.dispatchEvent(new Event(\'qaemati-preview-refresh\'))"') }}
        {% if restaurant.logoPath %}
          <button
            type="button"
            aria-label="{{ labels.branding.removeImage }}"
            class="inline-flex min-h-11 items-center justify-center rounded-md border border-border px-3 text-sm font-medium text-text transition-colors duration-fast ease-standard hover:bg-muted-surface focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary"
            hx-delete="/admin/branding/logo/image"
            hx-target="#branding-images"
            hx-swap="outerHTML"
            hx-on::after-request="window.dispatchEvent(new Event('qaemati-preview-refresh'))"
          >{{ labels.branding.removeImage }}</button>
        {% endif %}
      </div>
    </div>

    <div>
      <label for="branding-cover-input" class="text-sm font-medium text-text">{{ labels.branding.coverImageLabel }}</label>
      <div class="mt-2 flex flex-col items-start gap-3 sm:flex-row sm:items-center">
        <span class="h-16 w-28 shrink-0 overflow-hidden rounded-md bg-muted-surface">
          {% if restaurant.coverImagePath %}
            <img src="{{ restaurant.coverImagePath }}" alt="" width="112" height="64" class="h-full w-full object-cover">
          {% endif %}
        </span>
        {{ fileInput('branding-cover-input', 'image', 'image/jpeg,image/png,image/webp', 'data-crop-aspect="1.7778" hx-post="/admin/branding/cover" hx-trigger="change" hx-target="#branding-images" hx-swap="outerHTML" hx-encoding="multipart/form-data" hx-on::after-request="window.dispatchEvent(new Event(\'qaemati-preview-refresh\'))"') }}
        {% if restaurant.coverImagePath %}
          <button
            type="button"
            aria-label="{{ labels.branding.removeImage }}"
            class="inline-flex min-h-11 items-center justify-center rounded-md border border-border px-3 text-sm font-medium text-text transition-colors duration-fast ease-standard hover:bg-muted-surface focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary"
            hx-delete="/admin/branding/cover/image"
            hx-target="#branding-images"
            hx-swap="outerHTML"
            hx-on::after-request="window.dispatchEvent(new Event('qaemati-preview-refresh'))"
          >{{ labels.branding.removeImage }}</button>
        {% endif %}
      </div>
    </div>
  </div>

  {#
    Only relevant once "Photo" is picked as the background style
    (branding-form.njk's choice-card group, same shared Alpine scope as
    branding.njk's x-data) -- shown/hidden client-side rather than a
    separate server round trip, consistent with how the rest of this
    form reacts to its own choice groups. The upload itself still always
    happens over its own htmx request, same as logo/cover.
  #}
  <div class="mt-6 border-t border-border pt-6" x-show="backgroundStyle === 'image'" x-cloak>
    <label for="branding-background-input" class="text-sm font-medium text-text">{{ labels.branding.backgroundImageLabel }}</label>
    <div class="mt-2 flex flex-col items-start gap-3 sm:flex-row sm:items-center">
      <span class="h-16 w-28 shrink-0 overflow-hidden rounded-md bg-muted-surface">
        {% if restaurant.backgroundImagePath %}
          <img src="{{ restaurant.backgroundImagePath }}" alt="" width="112" height="64" class="h-full w-full object-cover">
        {% endif %}
      </span>
      {{ fileInput('branding-background-input', 'image', 'image/jpeg,image/png,image/webp', 'hx-post="/admin/branding/background" hx-trigger="change" hx-target="#branding-images" hx-swap="outerHTML" hx-encoding="multipart/form-data" hx-on::after-request="window.dispatchEvent(new Event(\'qaemati-preview-refresh\'))"') }}
      {% if restaurant.backgroundImagePath %}
        <button
          type="button"
          aria-label="{{ labels.branding.removeImage }}"
          class="inline-flex min-h-11 items-center justify-center rounded-md border border-border px-3 text-sm font-medium text-text transition-colors duration-fast ease-standard hover:bg-muted-surface focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary"
          x-on:click="if (backgroundStyle === 'image') backgroundStyle = 'solid'"
          hx-delete="/admin/branding/background/image"
          hx-target="#branding-images"
          hx-swap="outerHTML"
          hx-on::after-request="window.dispatchEvent(new Event('qaemati-preview-refresh'))"
        >{{ labels.branding.removeImage }}</button>
      {% endif %}
    </div>
  </div>
</section>
