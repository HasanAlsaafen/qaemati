{% from "components/choice-card.njk" import choiceCard %}
{% from "components/button.njk" import button %}
{% from "components/input.njk" import input %}
{#
  restaurant: Restaurant row + hasStructuredHours (admin-view-model.ts)
  Rendered both as the initial page content (admin/branding.njk) and as
  the htmx re-render target after a successful/failed save -- so this
  partial owns the whole <form>, matching category-block.njk's pattern
  of "the thing that gets swapped is exactly the thing with the form in
  it." The reactive color/font/name state this form reads and writes
  (x-model) lives one level up, in branding.njk's x-data -- see that
  file's comment for why.

  fieldErrors: { [name]: message } from BrandingController's catch block
  -- which input (if any) a rejected save's error actually belongs to.
  Empty on first load and on a successful save.
#}
<div id="branding-form">
  <form
    hx-patch="/admin/branding"
    hx-target="#branding-form"
    hx-swap="outerHTML"
    class="flex flex-col gap-6"
  >
    <section class="rounded-lg border border-border bg-surface p-4">
      <h2 class="font-sans text-lg font-bold text-text">{{ labels.branding.detailsTitle }}</h2>
      <div class="mt-4 grid gap-4 sm:grid-cols-2">
        {{ input(name='nameAr', label=labels.form.nameAr, value=restaurant.nameAr, error=fieldErrors.nameAr, dir='rtl', attrs='x-model="nameAr" x-on:input="schedulePreview()" required') }}
        {{ input(name='nameEn', label=labels.form.nameEn, value=restaurant.nameEn, error=fieldErrors.nameEn, dir='ltr', attrs='x-model="nameEn" x-on:input="schedulePreview()" required') }}
        <div class="flex flex-col gap-1.5">
          <label for="branding-descriptionAr" class="text-sm font-medium text-text">{{ labels.form.descriptionAr }}</label>
          <textarea id="branding-descriptionAr" name="descriptionAr" dir="rtl" rows="2" class="rounded-md border border-border-strong bg-surface px-3 py-2 text-base text-text focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary">{{ restaurant.descriptionAr or '' }}</textarea>
        </div>
        <div class="flex flex-col gap-1.5">
          <label for="branding-descriptionEn" class="text-sm font-medium text-text">{{ labels.form.descriptionEn }}</label>
          <textarea id="branding-descriptionEn" name="descriptionEn" dir="ltr" rows="2" class="rounded-md border border-border-strong bg-surface px-3 py-2 text-base text-text focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary">{{ restaurant.descriptionEn or '' }}</textarea>
        </div>
        <div class="flex flex-col gap-1.5">
          <label for="branding-whatsapp" class="text-sm font-medium text-text">{{ labels.branding.whatsappLabel }}</label>
          <input id="branding-whatsapp" name="whatsapp" type="tel" dir="ltr" value="{{ restaurant.whatsapp or '' }}" class="min-h-11 rounded-md border border-border-strong bg-surface px-3 text-base text-text focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary">
        </div>
        <div class="flex flex-col gap-1.5">
          <label for="branding-instagramHandle" class="text-sm font-medium text-text">{{ labels.branding.instagramLabel }}</label>
          <input id="branding-instagramHandle" name="instagramHandle" type="text" dir="ltr" value="{{ restaurant.instagramHandle or '' }}" class="min-h-11 rounded-md border border-border-strong bg-surface px-3 text-base text-text focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary">
        </div>
        <div class="flex flex-col gap-1.5">
          <label for="branding-workingHoursAr" class="text-sm font-medium text-text">{{ labels.branding.workingHoursArLabel }}</label>
          <input id="branding-workingHoursAr" name="workingHoursAr" type="text" dir="rtl" value="{{ restaurant.workingHoursAr or '' }}" class="min-h-11 rounded-md border border-border-strong bg-surface px-3 text-base text-text focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary">
        </div>
        <div class="flex flex-col gap-1.5">
          <label for="branding-workingHoursEn" class="text-sm font-medium text-text">{{ labels.branding.workingHoursEnLabel }}</label>
          <input id="branding-workingHoursEn" name="workingHoursEn" type="text" dir="ltr" value="{{ restaurant.workingHoursEn or '' }}" class="min-h-11 rounded-md border border-border-strong bg-surface px-3 text-base text-text focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary">
        </div>
      </div>

      <div class="mt-4 grid gap-4 sm:grid-cols-3">
        {{ input(name='openTime', label=labels.branding.openTimeLabel, type='time', value=restaurant.openTime or '', error=fieldErrors.openTime, dir='ltr', attrs='x-model="openTime"') }}
        {{ input(name='closeTime', label=labels.branding.closeTimeLabel, type='time', value=restaurant.closeTime or '', error=fieldErrors.closeTime, dir='ltr', attrs='x-model="closeTime"') }}
        <div class="flex flex-col gap-1.5">
          <label for="branding-currency" class="text-sm font-medium text-text">{{ labels.branding.currencyLabel }}</label>
          <input id="branding-currency" name="currency" type="text" dir="ltr" maxlength="8" value="{{ restaurant.currency }}" class="min-h-11 rounded-md border border-border-strong bg-surface px-3 text-base text-text focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary">
        </div>
      </div>
      <p class="mt-2 text-sm text-muted-text">{{ labels.branding.hoursHint }}</p>
      <p class="mt-1 text-sm text-muted-text">{{ labels.branding.currencyHint }}</p>
    </section>

    <section class="rounded-lg border border-border bg-surface p-4">
      <h2 class="font-sans text-lg font-bold text-text">{{ labels.branding.contactTitle }}</h2>
      <div class="mt-4 grid gap-4 sm:grid-cols-2">
        {{ input(name='taglineAr', label=labels.branding.taglineArLabel, value=restaurant.taglineAr or '', error=fieldErrors.taglineAr, dir='rtl', attrs='maxlength="120"') }}
        {{ input(name='taglineEn', label=labels.branding.taglineEnLabel, value=restaurant.taglineEn or '', error=fieldErrors.taglineEn, dir='ltr', attrs='maxlength="120"') }}
        {{ input(name='phone', label=labels.branding.phoneLabel, type='tel', value=restaurant.phone or '', error=fieldErrors.phone, attrs='autocomplete="off"') }}
        {{ input(name='facebookUrl', label=labels.branding.facebookLabel, value=restaurant.facebookUrl or '', error=fieldErrors.facebookUrl, hint=labels.branding.facebookHint, dir='ltr') }}
        {{ input(name='addressAr', label=labels.branding.addressArLabel, value=restaurant.addressAr or '', error=fieldErrors.addressAr, dir='rtl', attrs='maxlength="200"') }}
        {{ input(name='addressEn', label=labels.branding.addressEnLabel, value=restaurant.addressEn or '', error=fieldErrors.addressEn, dir='ltr', attrs='maxlength="200"') }}
        <div class="sm:col-span-2">
          {{ input(name='mapUrl', label=labels.branding.mapUrlLabel, type='url', value=restaurant.mapUrl or '', error=fieldErrors.mapUrl, hint=labels.branding.mapUrlHint, attrs='maxlength="500"') }}
        </div>
      </div>
    </section>

    <section class="rounded-lg border border-border bg-surface p-4">
      <h2 class="font-sans text-lg font-bold text-text">{{ labels.branding.appearanceTitle }}</h2>
      <div class="mt-4 flex flex-wrap items-start gap-6">
        <div class="flex flex-col gap-1.5">
          <label for="branding-primaryColor" class="text-sm font-medium text-text">{{ labels.branding.primaryColorLabel }}</label>
          <div class="flex items-center gap-2">
            <input
              id="branding-primaryColor"
              type="color"
              x-model="color"
              x-on:input="primaryColorErrorDismissed = true; recomputeContrast()"
              class="h-11 w-14 cursor-pointer rounded-md border border-border-strong bg-surface"
            >
            <input
              type="text"
              dir="ltr"
              x-model="color"
              x-on:input="primaryColorErrorDismissed = true; recomputeContrast()"
              maxlength="7"
              aria-label="{{ labels.branding.primaryColorLabel }}"
              {% if fieldErrors.primaryColor %}aria-invalid="true" aria-describedby="field-primaryColor-error"{% endif %}
              class="min-h-11 w-28 rounded-md border bg-surface px-3 text-base text-text focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary {{ 'border-danger' if fieldErrors.primaryColor else 'border-border-strong' }}"
            >
            <input type="hidden" name="primaryColor" x-bind:value="color">
            <button
              type="button"
              x-on:click="color = defaultColor; primaryColorErrorDismissed = true; recomputeContrast()"
              class="inline-flex min-h-11 items-center justify-center rounded-md border border-border px-3 text-sm font-medium text-text transition-colors duration-fast ease-standard hover:bg-muted-surface active:scale-[0.97] focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary"
            >{{ labels.branding.resetColor }}</button>
          </div>
          {% if fieldErrors.primaryColor %}
            <p id="field-primaryColor-error" class="mt-1 text-sm text-danger" x-show="!primaryColorErrorDismissed">{{ fieldErrors.primaryColor }}</p>
          {% endif %}
          <p class="mt-1 text-sm" x-show="contrast" x-bind:class="contrast && contrast.passes ? 'text-success' : 'text-danger'">
            <span x-text="contrast ? (contrast.passes ? passTemplate : failTemplate).replace('{ratio}', contrast.ratio.toFixed(2)) : ''"></span>
          </p>
          <p class="mt-1 text-sm text-muted-text">{{ labels.branding.primaryColorHint }}</p>
        </div>

        <div class="flex flex-col gap-1.5">
          <label for="branding-secondaryColor" class="text-sm font-medium text-text">{{ labels.branding.secondaryColorLabel }}</label>
          <div class="flex items-center gap-2">
            <input
              id="branding-secondaryColor"
              type="color"
              x-model="secondaryColor"
              x-on:input="secondaryColorErrorDismissed = true; recomputeSecondaryContrast()"
              class="h-11 w-14 cursor-pointer rounded-md border border-border-strong bg-surface"
            >
            <input
              type="text"
              dir="ltr"
              x-model="secondaryColor"
              x-on:input="secondaryColorErrorDismissed = true; recomputeSecondaryContrast()"
              maxlength="7"
              aria-label="{{ labels.branding.secondaryColorLabel }}"
              {% if fieldErrors.secondaryColor %}aria-invalid="true" aria-describedby="field-secondaryColor-error"{% endif %}
              class="min-h-11 w-28 rounded-md border bg-surface px-3 text-base text-text focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary {{ 'border-danger' if fieldErrors.secondaryColor else 'border-border-strong' }}"
            >
            <input type="hidden" name="secondaryColor" x-bind:value="secondaryColor">
            <button
              type="button"
              x-on:click="secondaryColor = defaultSecondaryColor; secondaryColorErrorDismissed = true; recomputeSecondaryContrast()"
              class="inline-flex min-h-11 items-center justify-center rounded-md border border-border px-3 text-sm font-medium text-text transition-colors duration-fast ease-standard hover:bg-muted-surface active:scale-[0.97] focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary"
            >{{ labels.branding.resetColor }}</button>
          </div>
          {% if fieldErrors.secondaryColor %}
            <p id="field-secondaryColor-error" class="mt-1 text-sm text-danger" x-show="!secondaryColorErrorDismissed">{{ fieldErrors.secondaryColor }}</p>
          {% endif %}
          <p class="mt-1 text-sm" x-show="secondaryContrast" x-bind:class="secondaryContrast && secondaryContrast.passes ? 'text-success' : 'text-danger'">
            <span x-text="secondaryContrast ? (secondaryContrast.passes ? passTemplate : failTemplate).replace('{ratio}', secondaryContrast.ratio.toFixed(2)) : ''"></span>
          </p>
          <p class="mt-1 text-sm text-muted-text">{{ labels.branding.secondaryColorHint }}</p>
        </div>

        <div class="flex flex-col gap-1.5">
          <label for="branding-backgroundColor" class="text-sm font-medium text-text">{{ labels.branding.backgroundColorLabel }}</label>
          <div class="flex items-center gap-2">
            <input
              id="branding-backgroundColor"
              type="color"
              x-model="backgroundColor"
              x-on:input="backgroundColorErrorDismissed = true; recomputeBackgroundContrast()"
              class="h-11 w-14 cursor-pointer rounded-md border border-border-strong bg-surface"
            >
            <input
              type="text"
              dir="ltr"
              x-model="backgroundColor"
              x-on:input="backgroundColorErrorDismissed = true; recomputeBackgroundContrast()"
              maxlength="7"
              aria-label="{{ labels.branding.backgroundColorLabel }}"
              {% if fieldErrors.backgroundColor %}aria-invalid="true" aria-describedby="field-backgroundColor-error"{% endif %}
              class="min-h-11 w-28 rounded-md border bg-surface px-3 text-base text-text focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary {{ 'border-danger' if fieldErrors.backgroundColor else 'border-border-strong' }}"
            >
            <input type="hidden" name="backgroundColor" x-bind:value="backgroundColor">
            <button
              type="button"
              x-on:click="backgroundColor = defaultBackgroundColor; backgroundColorErrorDismissed = true; recomputeBackgroundContrast()"
              class="inline-flex min-h-11 items-center justify-center rounded-md border border-border px-3 text-sm font-medium text-text transition-colors duration-fast ease-standard hover:bg-muted-surface active:scale-[0.97] focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary"
            >{{ labels.branding.resetColor }}</button>
          </div>
          {% if fieldErrors.backgroundColor %}
            <p id="field-backgroundColor-error" class="mt-1 text-sm text-danger" x-show="!backgroundColorErrorDismissed">{{ fieldErrors.backgroundColor }}</p>
          {% endif %}
          <p class="mt-1 text-sm" x-show="backgroundContrast" x-bind:class="backgroundContrast && backgroundContrast.passes ? 'text-success' : 'text-danger'">
            <span x-text="backgroundContrast ? (backgroundContrast.passes ? passTemplate : failTemplate).replace('{ratio}', backgroundContrast.ratio.toFixed(2)) : ''"></span>
          </p>
          <p class="mt-1 text-sm text-muted-text">{{ labels.branding.backgroundColorHint }}</p>
        </div>
      </div>

      <div class="mt-6 flex flex-col gap-5">
        <fieldset class="flex flex-col gap-1.5">
          <legend class="text-sm font-medium text-text">{{ labels.branding.fontThemeLabel }}</legend>
          <div class="grid max-w-sm grid-cols-2 sm:grid-cols-3 gap-2">
            {{ choiceCard('fontTheme', 'classic', labels.branding.fontThemeClassic, restaurant.fontTheme != 'modern', 'x-model="fontTheme" x-on:change="schedulePreview()"') }}
            {{ choiceCard('fontTheme', 'modern', labels.branding.fontThemeModern, restaurant.fontTheme == 'modern', 'x-model="fontTheme" x-on:change="schedulePreview()"') }}
            {{ choiceCard('fontTheme', 'clean', t('common.admin.branding.look.extra.fontTheme.clean'), restaurant.fontTheme == 'clean', 'x-model="fontTheme" x-on:change="schedulePreview()"') }}
          </div>
        </fieldset>

        <fieldset class="flex flex-col gap-1.5">
          <legend class="text-sm font-medium text-text">{{ labels.branding.menuDensityLabel }}</legend>
          <div class="grid max-w-sm grid-cols-2 sm:grid-cols-3 gap-2">
            {{ choiceCard('menuDensity', 'comfortable', labels.branding.menuDensityComfortable, restaurant.menuDensity != 'compact', 'x-model="menuDensity" x-on:change="schedulePreview()"') }}
            {{ choiceCard('menuDensity', 'compact', labels.branding.menuDensityCompact, restaurant.menuDensity == 'compact', 'x-model="menuDensity" x-on:change="schedulePreview()"') }}
            {{ choiceCard('menuDensity', 'spacious', t('common.admin.branding.look.extra.menuDensity.spacious'), restaurant.menuDensity == 'spacious', 'x-model="menuDensity" x-on:change="schedulePreview()"') }}
          </div>
        </fieldset>

        <fieldset class="flex flex-col gap-1.5">
          <legend class="text-sm font-medium text-text">{{ labels.branding.cornerStyleLabel }}</legend>
          <div class="grid max-w-sm grid-cols-2 sm:grid-cols-3 gap-2">
            {{ choiceCard('cornerStyle', 'rounded', labels.branding.cornerStyleRounded, restaurant.cornerStyle != 'sharp', 'x-model="cornerStyle" x-on:change="schedulePreview()"') }}
            {{ choiceCard('cornerStyle', 'sharp', labels.branding.cornerStyleSharp, restaurant.cornerStyle == 'sharp', 'x-model="cornerStyle" x-on:change="schedulePreview()"') }}
            {{ choiceCard('cornerStyle', 'soft', t('common.admin.branding.look.extra.cornerStyle.soft'), restaurant.cornerStyle == 'soft', 'x-model="cornerStyle" x-on:change="schedulePreview()"') }}
          </div>
        </fieldset>

        <fieldset class="flex flex-col gap-1.5">
          <legend class="text-sm font-medium text-text">{{ labels.branding.cardStyleLabel }}</legend>
          <div class="grid max-w-sm grid-cols-2 sm:grid-cols-3 gap-2">
            {{ choiceCard('cardStyle', 'flat', labels.branding.cardStyleFlat, restaurant.cardStyle != 'raised', 'x-model="cardStyle" x-on:change="schedulePreview()"') }}
            {{ choiceCard('cardStyle', 'raised', labels.branding.cardStyleRaised, restaurant.cardStyle == 'raised', 'x-model="cardStyle" x-on:change="schedulePreview()"') }}
            {{ choiceCard('cardStyle', 'outlined', t('common.admin.branding.look.extra.cardStyle.outlined'), restaurant.cardStyle == 'outlined', 'x-model="cardStyle" x-on:change="schedulePreview()"') }}
            {{ choiceCard('cardStyle', 'tinted', t('common.admin.branding.look.extra.cardStyle.tinted'), restaurant.cardStyle == 'tinted', 'x-model="cardStyle" x-on:change="schedulePreview()"') }}
          </div>
        </fieldset>

        <fieldset class="flex flex-col gap-1.5">
          <legend class="text-sm font-medium text-text">{{ labels.branding.buttonShapeLabel }}</legend>
          <div class="grid max-w-sm grid-cols-2 sm:grid-cols-3 gap-2">
            {{ choiceCard('buttonShape', 'rounded', labels.branding.buttonShapeRounded, restaurant.buttonShape != 'pill', 'x-model="buttonShape" x-on:change="schedulePreview()"') }}
            {{ choiceCard('buttonShape', 'pill', labels.branding.buttonShapePill, restaurant.buttonShape == 'pill', 'x-model="buttonShape" x-on:change="schedulePreview()"') }}
            {{ choiceCard('buttonShape', 'square', t('common.admin.branding.look.extra.buttonShape.square'), restaurant.buttonShape == 'square', 'x-model="buttonShape" x-on:change="schedulePreview()"') }}
          </div>
        </fieldset>

        <fieldset class="flex flex-col gap-1.5">
          <legend class="text-sm font-medium text-text">{{ labels.branding.categoryDividerLabel }}</legend>
          <div class="grid max-w-md grid-cols-2 sm:grid-cols-3 gap-2">
            {{ choiceCard('categoryDivider', 'none', labels.branding.categoryDividerNone, restaurant.categoryDivider != 'line' and restaurant.categoryDivider != 'dashed', 'x-model="categoryDivider" x-on:change="schedulePreview()"') }}
            {{ choiceCard('categoryDivider', 'line', labels.branding.categoryDividerLine, restaurant.categoryDivider == 'line', 'x-model="categoryDivider" x-on:change="schedulePreview()"') }}
            {{ choiceCard('categoryDivider', 'dashed', labels.branding.categoryDividerDashed, restaurant.categoryDivider == 'dashed', 'x-model="categoryDivider" x-on:change="schedulePreview()"') }}
            {{ choiceCard('categoryDivider', 'dotted', t('common.admin.branding.look.extra.categoryDivider.dotted'), restaurant.categoryDivider == 'dotted', 'x-model="categoryDivider" x-on:change="schedulePreview()"') }}
            {{ choiceCard('categoryDivider', 'thick', t('common.admin.branding.look.extra.categoryDivider.thick'), restaurant.categoryDivider == 'thick', 'x-model="categoryDivider" x-on:change="schedulePreview()"') }}
          </div>
        </fieldset>

        <fieldset class="flex flex-col gap-1.5">
          <legend class="text-sm font-medium text-text">{{ t('common.admin.branding.look.layout.label') }}</legend>
          <div class="grid max-w-md grid-cols-2 sm:grid-cols-3 gap-2">
            {{ choiceCard('menuLayout', 'grid', t('common.admin.branding.look.layout.grid'), restaurant.menuLayout == 'grid' or not restaurant.menuLayout, 'x-model="menuLayout" x-on:change="schedulePreview()"') }}
            {{ choiceCard('menuLayout', 'list', t('common.admin.branding.look.layout.list'), restaurant.menuLayout == 'list', 'x-model="menuLayout" x-on:change="schedulePreview()"') }}
            {{ choiceCard('menuLayout', 'large', t('common.admin.branding.look.layout.large'), restaurant.menuLayout == 'large', 'x-model="menuLayout" x-on:change="schedulePreview()"') }}
            {{ choiceCard('menuLayout', 'grid3', t('common.admin.branding.look.extra.menuLayout.grid3'), restaurant.menuLayout == 'grid3', 'x-model="menuLayout" x-on:change="schedulePreview()"') }}
          </div>
        </fieldset>

        <fieldset class="flex flex-col gap-1.5">
          <legend class="text-sm font-medium text-text">{{ t('common.admin.branding.look.images.label') }}</legend>
          <div class="grid max-w-md grid-cols-3 gap-2">
            {{ choiceCard('itemImages', 'show', t('common.admin.branding.look.images.show'), restaurant.itemImages == 'show' or not restaurant.itemImages, 'x-model="itemImages" x-on:change="schedulePreview()"') }}
            {{ choiceCard('itemImages', 'filled', t('common.admin.branding.look.images.filled'), restaurant.itemImages == 'filled', 'x-model="itemImages" x-on:change="schedulePreview()"') }}
            {{ choiceCard('itemImages', 'hide', t('common.admin.branding.look.images.hide'), restaurant.itemImages == 'hide', 'x-model="itemImages" x-on:change="schedulePreview()"') }}
          </div>
        </fieldset>

        <fieldset class="flex flex-col gap-1.5">
          <legend class="text-sm font-medium text-text">{{ t('common.admin.branding.look.shape.label') }}</legend>
          <div class="grid max-w-md grid-cols-2 sm:grid-cols-3 gap-2">
            {{ choiceCard('itemImageShape', 'standard', t('common.admin.branding.look.shape.standard'), restaurant.itemImageShape == 'standard' or not restaurant.itemImageShape, 'x-model="itemImageShape" x-on:change="schedulePreview()"') }}
            {{ choiceCard('itemImageShape', 'wide', t('common.admin.branding.look.shape.wide'), restaurant.itemImageShape == 'wide', 'x-model="itemImageShape" x-on:change="schedulePreview()"') }}
            {{ choiceCard('itemImageShape', 'square', t('common.admin.branding.look.shape.square'), restaurant.itemImageShape == 'square', 'x-model="itemImageShape" x-on:change="schedulePreview()"') }}
            {{ choiceCard('itemImageShape', 'round', t('common.admin.branding.look.shape.round'), restaurant.itemImageShape == 'round', 'x-model="itemImageShape" x-on:change="schedulePreview()"') }}
            {{ choiceCard('itemImageShape', 'tall', t('common.admin.branding.look.extra.itemImageShape.tall'), restaurant.itemImageShape == 'tall', 'x-model="itemImageShape" x-on:change="schedulePreview()"') }}
          </div>
        </fieldset>

        <fieldset class="flex flex-col gap-1.5">
          <legend class="text-sm font-medium text-text">{{ t('common.admin.branding.look.marker.label') }}</legend>
          <div class="grid max-w-md grid-cols-2 sm:grid-cols-3 gap-2">
            {{ choiceCard('categoryMarker', 'none', t('common.admin.branding.look.marker.none'), restaurant.categoryMarker == 'none' or not restaurant.categoryMarker, 'x-model="categoryMarker" x-on:change="schedulePreview()"') }}
            {{ choiceCard('categoryMarker', 'bar', t('common.admin.branding.look.marker.bar'), restaurant.categoryMarker == 'bar', 'x-model="categoryMarker" x-on:change="schedulePreview()"') }}
            {{ choiceCard('categoryMarker', 'dot', t('common.admin.branding.look.marker.dot'), restaurant.categoryMarker == 'dot', 'x-model="categoryMarker" x-on:change="schedulePreview()"') }}
            {{ choiceCard('categoryMarker', 'underline', t('common.admin.branding.look.marker.underline'), restaurant.categoryMarker == 'underline', 'x-model="categoryMarker" x-on:change="schedulePreview()"') }}
            {{ choiceCard('categoryMarker', 'square', t('common.admin.branding.look.extra.categoryMarker.square'), restaurant.categoryMarker == 'square', 'x-model="categoryMarker" x-on:change="schedulePreview()"') }}
            {{ choiceCard('categoryMarker', 'rule', t('common.admin.branding.look.extra.categoryMarker.rule'), restaurant.categoryMarker == 'rule', 'x-model="categoryMarker" x-on:change="schedulePreview()"') }}
          </div>
        </fieldset>

        <fieldset class="flex flex-col gap-1.5">
          <legend class="text-sm font-medium text-text">{{ t('common.admin.branding.look.logo.label') }}</legend>
          <div class="grid max-w-md grid-cols-3 gap-2">
            {{ choiceCard('logoShape', 'rounded', t('common.admin.branding.look.logo.rounded'), restaurant.logoShape == 'rounded' or not restaurant.logoShape, 'x-model="logoShape" x-on:change="schedulePreview()"') }}
            {{ choiceCard('logoShape', 'round', t('common.admin.branding.look.logo.round'), restaurant.logoShape == 'round', 'x-model="logoShape" x-on:change="schedulePreview()"') }}
            {{ choiceCard('logoShape', 'square', t('common.admin.branding.look.logo.square'), restaurant.logoShape == 'square', 'x-model="logoShape" x-on:change="schedulePreview()"') }}
          </div>
        </fieldset>

        <fieldset class="flex flex-col gap-1.5">
          <legend class="text-sm font-medium text-text">{{ t('common.admin.branding.look.cover.label') }}</legend>
          <div class="grid max-w-md grid-cols-3 gap-2">
            {{ choiceCard('coverHeight', 'medium', t('common.admin.branding.look.cover.medium'), restaurant.coverHeight == 'medium' or not restaurant.coverHeight, 'x-model="coverHeight" x-on:change="schedulePreview()"') }}
            {{ choiceCard('coverHeight', 'small', t('common.admin.branding.look.cover.small'), restaurant.coverHeight == 'small', 'x-model="coverHeight" x-on:change="schedulePreview()"') }}
            {{ choiceCard('coverHeight', 'large', t('common.admin.branding.look.cover.large'), restaurant.coverHeight == 'large', 'x-model="coverHeight" x-on:change="schedulePreview()"') }}
          </div>
        </fieldset>

        <fieldset class="flex flex-col gap-1.5">
          <legend class="text-sm font-medium text-text">{{ t('common.admin.branding.look.price.label') }}</legend>
          <div class="grid max-w-md grid-cols-3 gap-2">
            {{ choiceCard('priceStyle', 'plain', t('common.admin.branding.look.price.plain'), restaurant.priceStyle == 'plain' or not restaurant.priceStyle, 'x-model="priceStyle" x-on:change="schedulePreview()"') }}
            {{ choiceCard('priceStyle', 'badge', t('common.admin.branding.look.price.badge'), restaurant.priceStyle == 'badge', 'x-model="priceStyle" x-on:change="schedulePreview()"') }}
            {{ choiceCard('priceStyle', 'muted', t('common.admin.branding.look.price.muted'), restaurant.priceStyle == 'muted', 'x-model="priceStyle" x-on:change="schedulePreview()"') }}
          </div>
        </fieldset>

        <fieldset class="flex flex-col gap-1.5">
          <legend class="text-sm font-medium text-text">{{ t('common.admin.branding.look.heading.label') }}</legend>
          <div class="grid max-w-md grid-cols-2 gap-2">
            {{ choiceCard('headingAlign', 'start', t('common.admin.branding.look.heading.start'), restaurant.headingAlign == 'start' or not restaurant.headingAlign, 'x-model="headingAlign" x-on:change="schedulePreview()"') }}
            {{ choiceCard('headingAlign', 'center', t('common.admin.branding.look.heading.center'), restaurant.headingAlign == 'center', 'x-model="headingAlign" x-on:change="schedulePreview()"') }}
          </div>
        </fieldset>

        <fieldset class="flex flex-col gap-1.5">
          <legend class="text-sm font-medium text-text">{{ labels.branding.backgroundStyleLabel }}</legend>
          <div class="grid max-w-md grid-cols-3 gap-2">
            {{ choiceCard('backgroundStyle', 'solid', labels.branding.backgroundStyleSolid, restaurant.backgroundStyle != 'pattern' and restaurant.backgroundStyle != 'image', 'x-model="backgroundStyle" x-on:change="schedulePreview()"') }}
            {{ choiceCard('backgroundStyle', 'pattern', labels.branding.backgroundStylePattern, restaurant.backgroundStyle == 'pattern', 'x-model="backgroundStyle" x-on:change="schedulePreview()"') }}
            {{ choiceCard('backgroundStyle', 'image', labels.branding.backgroundStyleImage, restaurant.backgroundStyle == 'image', 'x-model="backgroundStyle" x-on:change="schedulePreview()"') }}
          </div>

          {#
            Only meaningful while "Pattern" is selected -- hidden rather
            than removed so the choice persists if the admin switches
            away and back without losing which pattern they'd picked.
          #}
          <div class="mt-3" x-show="backgroundStyle === 'pattern'" x-cloak>
            <span class="text-sm font-medium text-text">{{ labels.branding.backgroundPatternLabel }}</span>
            <div class="mt-1.5 grid max-w-md grid-cols-2 sm:grid-cols-3 gap-2">
              {{ choiceCard('backgroundPattern', 'dots', labels.branding.backgroundPatternDots, restaurant.backgroundPattern != 'grid' and restaurant.backgroundPattern != 'diagonal', 'x-model="backgroundPattern" x-on:change="schedulePreview()"') }}
              {{ choiceCard('backgroundPattern', 'grid', labels.branding.backgroundPatternGrid, restaurant.backgroundPattern == 'grid', 'x-model="backgroundPattern" x-on:change="schedulePreview()"') }}
              {{ choiceCard('backgroundPattern', 'diagonal', labels.branding.backgroundPatternDiagonal, restaurant.backgroundPattern == 'diagonal', 'x-model="backgroundPattern" x-on:change="schedulePreview()"') }}
            {{ choiceCard('backgroundPattern', 'checks', t('common.admin.branding.look.extra.backgroundPattern.checks'), restaurant.backgroundPattern == 'checks', 'x-model="backgroundPattern" x-on:change="schedulePreview()"') }}
            {{ choiceCard('backgroundPattern', 'lines', t('common.admin.branding.look.extra.backgroundPattern.lines'), restaurant.backgroundPattern == 'lines', 'x-model="backgroundPattern" x-on:change="schedulePreview()"') }}
            </div>
          </div>

          <p class="mt-2 text-sm text-muted-text" x-show="backgroundStyle === 'image'" x-cloak>{{ labels.branding.backgroundImageHint }}</p>
        </fieldset>

        <fieldset class="flex flex-col gap-1.5">
          <legend class="text-sm font-medium text-text">{{ labels.branding.sectionSpacingLabel }}</legend>
          <div class="grid max-w-md grid-cols-3 gap-2">
            {{ choiceCard('sectionSpacing', 'cozy', labels.branding.sectionSpacingCozy, restaurant.sectionSpacing == 'cozy', 'x-model="sectionSpacing" x-on:change="schedulePreview()"') }}
            {{ choiceCard('sectionSpacing', 'comfortable', labels.branding.sectionSpacingComfortable, restaurant.sectionSpacing != 'cozy' and restaurant.sectionSpacing != 'spacious', 'x-model="sectionSpacing" x-on:change="schedulePreview()"') }}
            {{ choiceCard('sectionSpacing', 'spacious', labels.branding.sectionSpacingSpacious, restaurant.sectionSpacing == 'spacious', 'x-model="sectionSpacing" x-on:change="schedulePreview()"') }}
          </div>
        </fieldset>
      </div>
    </section>

    {#
      Sticky save bar: a long settings form (this one scrolls several
      screens) otherwise makes "Save" a scroll-to-the-bottom hunt after
      every edit -- a common dashboard pattern (Shopify admin, WordPress
      customizer) pins the primary action to the viewport instead.
      Blurred surface so content scrolling underneath it stays legible.
    #}
    <div class="sticky bottom-0 -mx-4 flex justify-end border-t border-border bg-surface/90 px-4 py-3 backdrop-blur sm:mx-0 sm:rounded-lg sm:border">
      {{ button(labels.form.save, 'primary', 'md', 'submit') }}
    </div>
  </form>
</div>
