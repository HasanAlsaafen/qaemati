{#
  The live board. It is re-fetched whenever the socket says something changed
  and every 30 seconds as a safety net, so everything the screen shows comes
  from here and the script only has to read the two counts below.
#}
{% set P = 'common.admin.pos.' %}
<div data-pos-state data-new-orders="{{ counts.newOrders }}" data-open-calls="{{ counts.openCalls }}" class="contents">

  {% set activeCalls = [] %}
  {% for call in calls %}{% if call.status != 'RESOLVED' %}{% set _c = activeCalls.push(call) %}{% endif %}{% endfor %}
  {% if activeCalls.length and role != 'KITCHEN' %}
    <section aria-labelledby="calls-title" class="mt-6">
      <h2 id="calls-title" class="font-sans text-lg font-bold text-text">{{ t(P + 'calls') }}</h2>
      <ul class="mt-3 grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
        {% for call in activeCalls %}
          <li class="rounded-lg border-2 p-4 {{ 'border-danger bg-danger/10' if call.status == 'OPEN' else 'border-border bg-surface' }}" data-call="{{ call.id }}" data-call-status="{{ call.status }}">
            <p class="font-sans text-lg font-bold text-text">{{ t(P + ('billTitle' if call.kind == 'BILL' else 'callTitle'), { label: call.tableLabel }) }}</p>
            <p class="text-sm text-muted-text"><time dir="ltr" datetime="{{ call.createdAt.toISOString() }}">{{ call.createdAt | clock }}</time>{% if call.status == 'ACKNOWLEDGED' %} · {{ t(P + 'callAcknowledged') }}{% endif %}</p>
            <div class="mt-3 flex flex-wrap gap-2">
              {% if call.status == 'OPEN' %}
                <button type="button" hx-post="/admin/pos/calls/{{ call.id }}/acknowledge" hx-target="#pos-board" hx-swap="innerHTML" class="inline-flex min-h-11 items-center rounded-md bg-primary px-4 text-sm font-medium text-primary-on hover:bg-primary-hover focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary">{{ t(P + 'callAck') }}</button>
              {% endif %}
              <button type="button" hx-post="/admin/pos/calls/{{ call.id }}/resolve" hx-target="#pos-board" hx-swap="innerHTML" class="inline-flex min-h-11 items-center rounded-md border border-border-strong px-4 text-sm font-medium text-text hover:bg-muted-surface focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary">{{ t(P + 'callDone') }}</button>
            </div>
          </li>
        {% endfor %}
      </ul>
    </section>
  {% endif %}

  {% if role != 'KITCHEN' and tables and tables.length %}
    <section aria-labelledby="tables-title" class="mt-6" data-tables>
      <h2 id="tables-title" class="flex items-center justify-between font-sans text-lg font-bold text-text">
        {{ t(P + 'tables') }}
        <span class="rounded-full bg-muted-surface px-2.5 py-0.5 text-sm font-medium text-text" dir="ltr">{% set taken = [] %}{% for tb in tables %}{% if tb.state != 'FREE' %}{% set _t = taken.push(tb) %}{% endif %}{% endfor %}{{ taken.length }} / {{ tables.length }}</span>
      </h2>
      <ul class="mt-3 grid grid-cols-2 gap-3 sm:grid-cols-3 lg:grid-cols-4">
        {% for tb in tables %}
          <li class="flex flex-col rounded-lg border-2 p-3 {{ 'border-danger bg-danger/10' if tb.state == 'BILL' else ('border-primary bg-primary-soft' if tb.state == 'OCCUPIED' else 'border-border bg-surface') }}" data-table="{{ tb.id }}" data-table-state="{{ tb.state }}">
            <div class="flex items-baseline justify-between gap-2">
              <p class="font-sans text-lg font-bold text-text">{{ tb.label }}</p>
              <span class="text-xs font-medium text-text">{{ t(P + ('tableBill' if tb.state == 'BILL' else ('tableOccupied' if tb.state == 'OCCUPIED' else 'tableFree'))) }}</span>
            </div>
            {% if tb.state != 'FREE' %}
              <p class="mt-1 text-sm text-muted-text"><time dir="ltr" datetime="{{ tb.occupiedAt.toISOString() }}">{{ tb.occupiedAt | clock }}</time> · {{ t(P + 'tableOrders', { count: tb.orders }) }}</p>
              {% if tb.orders %}<p class="mt-1 text-sm font-bold text-text" dir="ltr">{{ tb.total | money }} {{ tb.currency | symbol(locale) }}</p>{% endif %}
              <button type="button" hx-post="/admin/pos/tables/{{ tb.id }}/checkout" hx-confirm="{{ t(P + 'checkoutConfirm', { label: tb.label }) }}" hx-target="#pos-board" hx-swap="innerHTML" class="mt-3 inline-flex min-h-11 items-center justify-center rounded-md {{ 'bg-primary text-primary-on hover:bg-primary-hover' if tb.state == 'BILL' else 'border border-border text-text hover:bg-muted-surface' }} px-3 text-sm font-medium focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary">{{ t(P + 'checkout') }}</button>
            {% endif %}
          </li>
        {% endfor %}
      </ul>
    </section>
  {% endif %}

  {% macro orderCard(order, locale, P, role) %}
    <li class="rounded-lg border border-border bg-surface p-4" data-order="{{ order.id }}">
      <div class="flex items-baseline justify-between gap-2">
        <p class="font-sans text-lg font-bold text-text">{{ t(P + 'orderNo', { number: order.number }) }}</p>
        <time class="text-sm text-muted-text" dir="ltr" datetime="{{ order.createdAt.toISOString() }}">{{ order.createdAt | clock }}</time>
      </div>
      <p class="text-sm font-medium text-text">{{ t(P + 'table', { label: order.tableLabel }) }}</p>
      <ul class="mt-3 flex flex-col gap-1 text-sm text-text">
        {% for line in order.items %}
          <li class="flex gap-2"><span class="font-bold" dir="ltr">{{ line.quantity }} ×</span><span class="min-w-0 flex-1">{{ line.nameAr if locale == 'ar' else line.nameEn }}</span></li>
        {% endfor %}
      </ul>
      {% if order.note %}<p class="mt-2 rounded-md bg-muted-surface p-2 text-sm text-text"><span class="font-medium">{{ t(P + 'note') }}:</span> {{ order.note }}</p>{% endif %}
      {% if role != 'KITCHEN' %}<p class="mt-3 text-sm font-bold text-text" dir="ltr">{{ order.total | money }} {{ order.currency | symbol(locale) }}</p>{% endif %}
      {% set next = {'NEW': ['PREPARING', 'start'], 'PREPARING': ['READY', 'ready'], 'READY': ['SERVED', 'served']}[order.status] %}
      {# The kitchen starts and finishes dishes. Serving and canceling belong to the floor. #}
      {% if next and (role != 'KITCHEN' or order.status != 'READY') %}
        <div class="mt-3 flex flex-wrap gap-2">
          <button type="button" hx-post="/admin/pos/orders/{{ order.id }}/status" hx-vals='{"status": "{{ next[0] }}"}' hx-target="#pos-board" hx-swap="innerHTML" class="inline-flex min-h-11 items-center rounded-md bg-primary px-4 text-sm font-medium text-primary-on hover:bg-primary-hover focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary">{{ t(P + next[1]) }}</button>
          {% if role != 'KITCHEN' %}<button type="button" hx-post="/admin/pos/orders/{{ order.id }}/status" hx-vals='{"status": "CANCELED"}' hx-confirm="{{ t(P + 'cancelConfirm') }}" hx-target="#pos-board" hx-swap="innerHTML" class="inline-flex min-h-11 items-center rounded-md border border-border-strong px-4 text-sm font-medium text-text hover:bg-muted-surface focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary">{{ t(P + 'cancel') }}</button>{% endif %}
        </div>
      {% endif %}
    </li>
  {% endmacro %}

  {% set columns = [['NEW', 'colNew'], ['PREPARING', 'colPreparing'], ['READY', 'colReady']] %}
  <div class="mt-6 grid gap-6 lg:grid-cols-3">
    {% for column in columns %}
      {% set rows = [] %}
      {% for order in orders %}{% if order.status == column[0] %}{% set _r = rows.push(order) %}{% endif %}{% endfor %}
      <section aria-labelledby="col-{{ column[0] }}">
        <h2 id="col-{{ column[0] }}" class="flex items-center justify-between font-sans text-lg font-bold text-text">
          {{ t(P + column[1]) }}
          <span class="rounded-full bg-muted-surface px-2.5 py-0.5 text-sm font-medium text-text" dir="ltr">{{ rows.length }}</span>
        </h2>
        {% if rows.length %}
          <ul class="mt-3 flex flex-col gap-3">
            {% for order in rows %}{{ orderCard(order, locale, P, role) }}{% endfor %}
          </ul>
        {% else %}
          <p class="mt-3 rounded-lg border border-dashed border-border p-4 text-sm text-muted-text">{{ t(P + 'emptyColumn') }}</p>
        {% endif %}
      </section>
    {% endfor %}
  </div>

  {% set finished = [] %}
  {% for order in orders %}{% if order.status == 'SERVED' or order.status == 'CANCELED' %}{% set _f = finished.push(order) %}{% endif %}{% endfor %}
  {% if finished.length %}
    <details class="mt-8">
      <summary class="inline-flex min-h-11 cursor-pointer items-center font-sans text-lg font-bold text-text">{{ t(P + 'recent') }} ({{ finished.length }})</summary>
      <ul class="mt-3 divide-y divide-border rounded-lg border border-border bg-surface text-sm">
        {% for order in finished | reverse %}
          <li class="flex flex-wrap items-center justify-between gap-2 px-4 py-3">
            <span class="font-medium text-text">{{ t(P + 'orderNo', { number: order.number }) }} · {{ t(P + 'table', { label: order.tableLabel }) }}</span>
            <span class="text-muted-text"><time dir="ltr">{{ order.statusChangedAt | clock }}</time> · {{ t(P + ('statusServed' if order.status == 'SERVED' else 'statusCanceled')) }}{% if role != 'KITCHEN' %} · <span dir="ltr">{{ order.total | money }} {{ order.currency | symbol(locale) }}</span>{% endif %}</span>
          </li>
        {% endfor %}
      </ul>
    </details>
  {% endif %}

  {% if not orders.length and not calls.length %}
    <p class="mt-8 rounded-lg border border-dashed border-border p-6 text-center text-muted-text">{{ t(P + 'noOrders') }}</p>
  {% endif %}
</div>
