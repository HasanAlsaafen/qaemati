{% extends "layouts/menu.njk" %}

{% from "components/restaurant-header.njk" import restaurantHeader %}
{% from "components/language-switcher.njk" import languageSwitcher %}
{% from "components/category-chip.njk" import categoryChip, categoryAllChip %}
{% from "components/menu-item-card.njk" import menuItemCard %}
{% from "components/item-detail-sheet.njk" import itemDetailSheet %}
{% from "components/empty-state.njk" import emptyState %}
{% from "components/selection-bar.njk" import selectionBar %}
{% from "components/menu-filter-sheet.njk" import menuFilterSheet %}
{% from "components/restaurant-footer.njk" import restaurantFooter %}
{% from "components/menu-switcher.njk" import menuSwitcher %}

{% set hasWhatsapp = menu.whatsappUrl %}

{% block title %}{{ menu.name }}{% endblock %}
{% block meta_description %}{{ menu.description or menu.name }}{% endblock %}

{% block content %}
<div
  hidden
  data-pwa-offline-banner
  class="print:hidden bg-warning px-4 py-2 text-center text-sm font-medium text-white"
  role="status"
>
  {{ labels.pwa.offlineBanner }}
</div>
{{ restaurantHeader(menu, t('common.menu.whatsapp'), t('common.menu.instagram'), labels.openStatus, t('common.menu.call')) }}

{% if menu.todaysSpecials.length %}
  {#
    A3: "Today's special" banner. A horizontally-scrolling strip rather
    than full menuItemCard instances -- these are a teaser/highlight, not
    a second full listing of the same items (which already appear in
    their normal category below); tapping one opens the same shared
    detail sheet as everywhere else, so "add to selection" still works
    from here without duplicating that logic.
  #}
  <div class="print:hidden border-b border-border bg-gold/10">
    <div class="mx-auto max-w-2xl px-4 py-3">
      <h2 class="font-sans text-sm font-bold text-on-gold">{{ labels.todaysSpecial }}</h2>
      <div class="mt-2 flex gap-3 overflow-x-auto pb-1">
        {% for item in menu.todaysSpecials %}
          <button
            type="button"
            x-data
            x-on:click="$dispatch('open-item-sheet', {{ item | dump }})"
            class="flex w-40 shrink-0 flex-col items-start gap-1 rounded-md border border-gold bg-surface p-2 text-start focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary"
          >
            <span class="relative h-16 w-full shrink-0 overflow-hidden rounded-sm bg-muted-surface">
              <img src="{{ item.imageUrl }}" alt="" loading="lazy" width="160" height="64" class="h-full w-full object-cover">
            </span>
            <span class="truncate text-xs font-bold text-text">{{ item.name }}</span>
            <span dir="ltr" class="text-xs text-muted-text">{{ item.priceFormatted }} {{ item.currency }}</span>
          </button>
        {% endfor %}
      </div>
    </div>
  </div>
{% endif %}

{% if tableLabel %}
  <div class="print:hidden mx-auto max-w-2xl px-4 pt-3">
    <span class="inline-flex items-center rounded-full bg-primary-soft px-3 py-1 text-xs font-medium text-primary">
      {{ t('common.menu.tableLabel', { name: tableLabel }) }}
    </span>
  </div>
{% endif %}

{{ menuSwitcher(menu, t('common.menu.menusLabel'), tableLabel) }}

<div class="print:hidden sticky top-0 z-30 border-b border-border bg-bg/95 backdrop-blur">
  <div class="mx-auto flex max-w-2xl items-center gap-2 px-4 pt-3">
    <label class="sr-only" for="menu-search">{{ t('common.menu.searchPlaceholder') }}</label>
    <input
      id="menu-search"
      type="search"
      placeholder="{{ t('common.menu.searchPlaceholder') }}"
      class="min-h-11 w-full min-w-0 flex-1 rounded-md border border-border-strong bg-surface px-3 text-base text-text placeholder:text-muted-text focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary"
      data-menu-search
      autocomplete="off"
    >
    {{ menuFilterSheet(labels.filter) }}
    {# B4: hidden until pwa.js's `beforeinstallprompt` handler reveals
       it -- Chrome only fires that event once its own installability
       checks (manifest + service worker + icon) already pass, so there's
       nothing useful this button can do before then. Safari/iOS never
       fires it at all (no JS-triggerable install there), so the button
       stays hidden there permanently rather than showing a dead click. #}
    <button
      type="button"
      hidden
      data-pwa-install-button
      class="min-h-11 shrink-0 rounded-md border border-border-strong px-3 text-sm font-medium text-text hover:bg-muted-surface"
    >
      {{ labels.pwa.installButton }}
    </button>
    <button
      type="button"
      data-share-button
      data-share-title="{{ menu.name }}"
      data-share-copied-label="{{ labels.share.copied }}"
      aria-label="{{ labels.share.buttonLabel }}"
      class="flex min-h-11 w-11 shrink-0 items-center justify-center rounded-md border border-border-strong text-text hover:bg-muted-surface"
    >
      <svg width="18" height="18" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><circle cx="12.5" cy="3.5" r="1.8"/><circle cx="3.5" cy="8" r="1.8"/><circle cx="12.5" cy="12.5" r="1.8"/><path d="M5.1 7.1l5.8-3.2M5.1 8.9l5.8 3.2" stroke-linecap="round"/></svg>
    </button>
    {{ languageSwitcher(otherLocale, t('common.nav.language'), 'data-preserve-scroll') }}
  </div>
  <div class="mx-auto flex max-w-2xl gap-2 overflow-x-auto px-4 py-3" data-category-bar>
    {% if menu.categories.length %}
      {{ categoryAllChip(t('common.menu.allCategories'), true) }}
    {% endif %}
    {% for category in menu.categories %}
      {{ categoryChip(category.name, '#' + category.anchor, false) }}
    {% endfor %}
  </div>
</div>

<main id="main-content" tabindex="-1" class="mx-auto max-w-2xl px-4 py-6 print:max-w-none focus:outline-none">
  <div data-menu-empty-state class="hidden">
    {{ emptyState(t('common.menu.noResults'), '') }}
  </div>

  <div data-menu-sections class="flex flex-col gap-8">
    {% for category in menu.categories %}
      <section id="{{ category.anchor }}" data-category-section class="scroll-mt-28">
        <h2 class="font-display text-2xl font-bold leading-heading text-text">{{ category.name }}</h2>
        <div class="mt-3 flex flex-col gap-3">
          {% for item in category.items %}
            {{ menuItemCard(item, t('common.menu.unavailable'), labels.selection, hasWhatsapp, labels.fromPrice, menu.logoUrl if (menu.itemDivider == 'logo' and not loop.last) else none) }}
          {% endfor %}
        </div>
      </section>
    {% endfor %}
  </div>
</main>

{{ restaurantFooter(menu, {
  title: t('common.menu.contactTitle'),
  call: t('common.menu.call'),
  whatsapp: t('common.menu.whatsapp'),
  instagram: t('common.menu.instagram'),
  facebook: t('common.menu.facebook'),
  openMap: t('common.menu.openMap'),
  hasSelectionBar: hasWhatsapp
}) }}

<div class="print:hidden">
  {{ itemDetailSheet(t('common.menu.unavailable'), hasWhatsapp, labels.selection.addButton, labels.selection.addedToast, labels.selectVariant, labels.addonsTitle, labels.selectVariantPrompt, labels.allergenNoteLabel) }}
</div>

{% if hasWhatsapp %}
  <div class="print:hidden">
    {{ selectionBar(labels.selection, menu.name, menu.whatsappUrl, tableLabel) }}
  </div>
{% endif %}
{% endblock %}

{% block scripts %}
  <script defer src="/js/menu.js"></script>
  {% if menu.openStatus %}
    <script defer src="/js/open-status.js"></script>
  {% endif %}
{% endblock %}
