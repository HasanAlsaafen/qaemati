{% extends "layouts/menu.njk" %}

{% from "components/restaurant-header.njk" import restaurantHeader %}
{% from "components/language-switcher.njk" import languageSwitcher %}
{% from "components/category-chip.njk" import categoryChip %}
{% from "components/menu-item-card.njk" import menuItemCard %}
{% from "components/item-detail-sheet.njk" import itemDetailSheet %}
{% from "components/empty-state.njk" import emptyState %}
{% from "components/selection-bar.njk" import selectionBar %}

{% set hasWhatsapp = menu.whatsappUrl %}

{% block title %}{{ menu.name }}{% endblock %}
{% block meta_description %}{{ menu.description or menu.name }}{% endblock %}

{% block content %}
{{ restaurantHeader(menu, t('common.menu.whatsapp'), t('common.menu.instagram')) }}

{% if tableLabel %}
  <div class="print:hidden mx-auto max-w-2xl px-4 pt-3">
    <span class="inline-flex items-center rounded-full bg-primary-soft px-3 py-1 text-xs font-medium text-primary">
      {{ t('common.menu.tableLabel', { name: tableLabel }) }}
    </span>
  </div>
{% endif %}

<div class="print:hidden sticky top-0 z-30 border-b border-border bg-bg/95 backdrop-blur">
  <div class="mx-auto flex max-w-2xl items-center gap-2 px-4 pt-3">
    <label class="sr-only" for="menu-search">{{ t('common.menu.searchPlaceholder') }}</label>
    <input
      id="menu-search"
      type="search"
      placeholder="{{ t('common.menu.searchPlaceholder') }}"
      class="min-h-11 w-full min-w-0 flex-1 rounded-md border border-border-strong bg-surface px-3 text-base text-text placeholder:text-muted-text focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary"
      data-menu-search
      autocomplete="off"
    >
    {{ languageSwitcher(otherLocale, t('common.nav.language'), 'data-preserve-scroll') }}
  </div>
  <div class="mx-auto flex max-w-2xl gap-2 overflow-x-auto px-4 py-3" data-category-bar>
    {% for category in menu.categories %}
      {{ categoryChip(category.name, '#' + category.anchor, loop.first) }}
    {% endfor %}
  </div>
</div>

<main class="mx-auto max-w-2xl px-4 py-6 print:max-w-none">
  <div data-menu-empty-state class="hidden">
    {{ emptyState(t('common.menu.noResults'), '') }}
  </div>

  <div data-menu-sections class="flex flex-col gap-8">
    {% for category in menu.categories %}
      <section id="{{ category.anchor }}" data-category-section class="scroll-mt-28">
        <h2 class="font-display text-2xl font-bold leading-heading text-text">{{ category.name }}</h2>
        <div class="mt-3 flex flex-col gap-3">
          {% for item in category.items %}
            {{ menuItemCard(item, t('common.menu.unavailable'), labels.selection, hasWhatsapp) }}
          {% endfor %}
        </div>
      </section>
    {% endfor %}
  </div>
</main>

<div class="print:hidden">
  {{ itemDetailSheet(t('common.menu.unavailable'), hasWhatsapp, labels.selection.addButton, labels.selection.addedToast) }}
</div>

{% if hasWhatsapp %}
  <div class="print:hidden">
    {{ selectionBar(labels.selection, menu.name, menu.whatsappUrl, tableLabel) }}
  </div>
{% endif %}
{% endblock %}

{% block scripts %}
  <script defer src="/js/menu.js"></script>
{% endblock %}
