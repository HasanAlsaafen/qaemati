{% extends "layouts/menu.njk" %}

{% from "components/restaurant-header.njk" import restaurantHeader %}
{% from "components/category-chip.njk" import categoryChip, categoryAllChip %}
{% from "components/menu-item-card.njk" import menuItemCard %}
{% from "components/item-detail-sheet.njk" import itemDetailSheet %}
{% from "components/empty-state.njk" import emptyState %}
{% from "components/selection-bar.njk" import selectionBar %}
{% from "components/menu-filter-sheet.njk" import menuFilterSheet %}
{% from "components/restaurant-footer.njk" import restaurantFooter %}
{% from "components/menu-switcher.njk" import menuSwitcher %}
{% from "components/waiter-button.njk" import waiterButton %}

{% set hasWhatsapp = menu.whatsappUrl and menu.orderingEnabled %}
{# At a table with table ordering on, the selection goes to the kitchen and WhatsApp is not used at all. #}
{% set canOrder = true if (tableOrder or hasWhatsapp) else false %}

{% block title %}{{ menu.name }}{% endblock %}
{% block meta_description %}{{ menu.description or menu.name }}{% endblock %}

{% block content %}
<div
  hidden
  data-pwa-offline-banner
  class="print:hidden bg-warning px-4 py-2 text-center text-sm font-medium text-white"
  role="status"
>
  {{ labels.pwa.offlineBanner }}
</div>
{{ restaurantHeader(menu, labels.openStatus, otherLocale, t('common.nav.language')) }}

{% if menu.todaysSpecials.length %}
  {#
    A3: "Today's special" strip. A horizontally scrolling row rather than
    full cards -- a teaser for dishes that also appear in their normal
    category below. Tapping one opens the same shared detail sheet, so
    "add to selection" works from here without duplicating that logic.
  #}
  <div class="print:hidden bg-surface" data-todays-specials>
    <div class="mx-auto max-w-4xl px-4 pb-3 sm:px-6">
      <h2 class="flex items-center gap-2 font-display text-sm font-bold text-text">
        <span class="h-4 w-1 rounded-full bg-secondary" aria-hidden="true"></span>{{ labels.todaysSpecial }}
      </h2>
      <div class="mt-2 flex gap-3 overflow-x-auto pb-1">
        {% for item in menu.todaysSpecials %}
          <button
            type="button"
            x-data
            x-on:click="$dispatch('open-item-sheet', {{ item | dump }})"
            class="flex w-40 shrink-0 flex-col items-start overflow-hidden rounded-card border border-border bg-surface text-start focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary"
          >
            <span class="relative block aspect-[4/3] w-full overflow-hidden bg-muted-surface">
              {% if item.imageUrl %}
                <img src="{{ item.imageUrl }}" alt="" loading="lazy" width="160" height="120" class="h-full w-full object-cover">
              {% elif menu.logoUrl %}
                <img src="{{ menu.logoUrl }}" alt="" loading="lazy" width="160" height="120" class="h-full w-full object-contain p-4 opacity-80">
              {% endif %}
            </span>
            <span class="w-full p-2">
              <span class="block truncate font-display text-xs font-bold text-text">{{ item.name }}</span>
              <span dir="ltr" class="block text-start font-display text-xs font-bold text-primary">{{ item.priceFormatted }} {{ item.currencySymbol }}</span>
            </span>
          </button>
        {% endfor %}
      </div>
    </div>
  </div>
{% endif %}

{% if tableLabel %}
  <div class="print:hidden mx-auto max-w-4xl px-4 pt-3 sm:px-6">
    <span class="inline-flex items-center rounded-full bg-primary-soft px-3 py-1 text-xs font-medium text-primary-text">
      {{ t('common.menu.tableLabel', { name: tableLabel }) }}
    </span>
  </div>
{% endif %}

{{ menuSwitcher(menu, t('common.menu.menusLabel'), tableLabel) }}

<div class="print:hidden bg-surface">
  <div class="mx-auto flex max-w-4xl items-center gap-2 px-4 pb-3 sm:px-6">
    <div class="relative min-w-0 flex-1">
      <label class="sr-only" for="menu-search">{{ t('common.menu.searchPlaceholder') }}</label>
      <input
        id="menu-search"
        type="search"
        placeholder="{{ t('common.menu.searchPlaceholder') }}"
        class="min-h-11 w-full rounded-full border border-border bg-surface py-2 pe-10 ps-4 text-sm text-text placeholder:text-muted-text focus-visible:border-primary focus-visible:outline focus-visible:outline-2 focus-visible:outline-primary/30"
        data-menu-search
        autocomplete="off"
      >
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" class="pointer-events-none absolute end-3 top-1/2 -translate-y-1/2 text-muted-text" aria-hidden="true"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
    </div>
    {{ menuFilterSheet(labels.filter) }}
    <button
      type="button"
      data-share-button
      data-share-title="{{ menu.name }}"
      data-share-copied-label="{{ labels.share.copied }}"
      aria-label="{{ labels.share.buttonLabel }}"
      class="flex h-11 w-11 shrink-0 items-center justify-center rounded-full border border-border bg-surface text-text hover:bg-muted-surface focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary"
    >
      <svg width="18" height="18" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><circle cx="12.5" cy="3.5" r="1.8"/><circle cx="3.5" cy="8" r="1.8"/><circle cx="12.5" cy="12.5" r="1.8"/><path d="M5.1 7.1l5.8-3.2M5.1 8.9l5.8 3.2" stroke-linecap="round"/></svg>
    </button>
  </div>
  <div class="mx-auto max-w-4xl px-4 sm:px-6">
    {# B4: hidden until pwa.js's `beforeinstallprompt` handler reveals
       it -- Chrome only fires that event once its own installability
       checks (manifest + service worker + icon) already pass, so there's
       nothing useful this button can do before then. Safari/iOS never
       fires it at all (no JS-triggerable install there), so the button
       stays hidden there permanently rather than showing a dead click. #}
    <button
      type="button"
      hidden
      data-pwa-install-button
      class="min-h-11 shrink-0 rounded-full border border-border bg-surface px-4 text-sm font-bold text-text hover:bg-muted-surface"
    >
      {{ labels.pwa.installButton }}
    </button>
  </div>
</div>

{# Only the category row sticks: it is the navigation, and a second sticky
   row for search would take a fifth of a phone screen. #}
<div class="print:hidden sticky top-0 z-30 border-b border-border bg-surface/95 backdrop-blur">
  <div class="mx-auto flex max-w-4xl gap-1 overflow-x-auto px-4 py-2 sm:px-6" data-category-bar>
    {% if menu.categories.length %}
      {{ categoryAllChip(t('common.menu.allCategories'), true) }}
    {% endif %}
    {% for category in menu.categories %}
      {{ categoryChip(category.name, '#' + category.anchor, false, category.thumbUrl, menu.logoUrl) }}
    {% endfor %}
  </div>
</div>

<main id="main-content" tabindex="-1" class="mx-auto max-w-4xl px-4 py-6 sm:px-6 print:max-w-none focus:outline-none">
  <div data-menu-empty-state class="hidden">
    {{ emptyState(t('common.menu.noResults'), '') }}
  </div>

  <div data-menu-sections class="flex flex-col gap-10">
    {% for category in menu.categories %}
      <section id="{{ category.anchor }}" data-category-section class="scroll-mt-32">
        <h2 class="flex items-center gap-2 font-display text-2xl font-bold leading-heading text-text">
          <span class="h-6 w-1 shrink-0 rounded-full bg-primary" aria-hidden="true"></span>{{ category.name }}
        </h2>
        <div class="mt-4 grid grid-cols-2 gap-3 sm:gap-4 lg:grid-cols-3">
          {% for item in category.items %}
            {{ menuItemCard(item, t('common.menu.unavailable'), labels.selection, canOrder, labels.fromPrice, menu.logoUrl) }}
          {% endfor %}
        </div>
      </section>
    {% endfor %}
  </div>
</main>

{{ restaurantFooter(menu, {
  title: t('common.menu.contactTitle'),
  call: t('common.menu.call'),
  whatsapp: t('common.menu.whatsapp'),
  instagram: t('common.menu.instagram'),
  facebook: t('common.menu.facebook'),
  openMap: t('common.menu.openMap'),
  hasSelectionBar: canOrder
}) }}

<div class="print:hidden">
  {{ itemDetailSheet(t('common.menu.unavailable'), canOrder, labels.selection.addButton, labels.selection.addedToast, labels.selectVariant, labels.addonsTitle, labels.selectVariantPrompt, labels.allergenNoteLabel, menu.logoUrl, t('common.menu.close')) }}
</div>

{% if canOrder %}
  <div class="print:hidden">
    {{ selectionBar(labels.selection, menu.name, menu.whatsappUrl, tableLabel, tableOrder, labels.tableOrder) }}
  </div>
{% endif %}
{% if tableOrder %}
  {{ waiterButton(tableOrder, tableLabel, labels.tableOrder) }}
{% endif %}
{% endblock %}

{% block scripts %}
  <script defer src="{{ asset('/js/menu.js') }}"></script>
  {% if menu.openStatus %}
    <script defer src="{{ asset('/js/open-status.js') }}"></script>
  {% endif %}
{% endblock %}
