{% extends "layouts/base.njk" %}
{% set P = 'common.signup.' %}
{% block title %}{{ t(P + 'sentTitle') }}{% endblock %}

{% block content %}
<h1 class="font-sans text-3xl font-bold text-text">{{ t(P + 'sentTitle') }}</h1>
<p class="mt-3 max-w-xl text-text" role="status">{{ t(P + 'sentText', { email: email }) }}</p>
<p class="mt-2 max-w-xl text-sm text-muted-text">{{ t(P + 'sentHelp') }}</p>
<a href="/" class="mt-6 inline-flex min-h-11 items-center text-sm font-medium text-primary-text underline underline-offset-4">{{ t(P + 'backHome') }}</a>
{% endblock %}
