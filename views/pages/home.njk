{% extends "layouts/landing.njk" %}
{% from "components/language-switcher.njk" import languageSwitcher %}
{% from "components/iphone-frame.njk" import iphoneFrame %}

{# Where every "get in touch" button goes: WhatsApp, else email, else the owner sign in. #}
{% if contact.whatsappUrl %}
  {% set ctaHref = contact.whatsappUrl %}{% set ctaLabel = t('common.home.landing.contact.whatsapp') %}
{% elif contact.email %}
  {% set ctaHref = 'mailto:' + contact.email %}{% set ctaLabel = t('common.home.landing.contact.email') %}
{% else %}
  {% set ctaHref = '/admin/login' %}{% set ctaLabel = t('common.home.landing.nav.signIn') %}
{% endif %}
{% set L = 'common.home.landing.' %}

{% block body %}
<header class="sticky top-0 z-40 border-b border-border bg-surface">
  <div class="mx-auto flex max-w-6xl items-center gap-3 px-4 py-2 sm:px-6">
    <a href="/" class="inline-flex min-h-11 items-center font-display text-2xl font-bold text-primary-text">{{ t('common.app.name') }}</a>
    <nav class="ms-6 hidden items-center gap-1 md:flex" aria-label="{{ t(L + 'nav.menu') }}">
      {% for key in ['how', 'features', 'pricing', 'faq'] %}
        {% if key != 'pricing' or plans.length %}
          <a href="#{{ key }}" class="inline-flex min-h-11 items-center rounded-md px-3 text-sm font-medium text-text hover:bg-muted-surface">{{ t(L + 'nav.' + key) }}</a>
        {% endif %}
      {% endfor %}
    </nav>
    <div class="ms-auto flex items-center gap-2">
      {{ languageSwitcher(otherLocale, t('common.nav.language')) }}
      <a href="/admin/login" class="hidden min-h-11 items-center rounded-md px-3 text-sm font-medium text-text hover:bg-muted-surface lg:inline-flex">{{ t(L + 'nav.signIn') }}</a>
      <a href="{{ ctaHref }}" class="hidden min-h-11 items-center rounded-md bg-primary px-4 text-sm font-medium text-primary-on hover:bg-primary-hover md:inline-flex">{{ t(L + 'hero.primary') }}</a>
      <button type="button" class="inline-flex h-11 w-11 items-center justify-center rounded-md hover:bg-muted-surface md:hidden" aria-label="{{ t(L + 'nav.menu') }}" x-bind:aria-expanded="navOpen.toString()" aria-controls="landing-nav" x-on:click="navOpen = !navOpen">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16" stroke-linecap="round"/></svg>
      </button>
    </div>
  </div>
  <nav id="landing-nav" x-show="navOpen" x-cloak class="border-t border-border px-4 py-3 md:hidden" aria-label="{{ t(L + 'nav.menu') }}">
    <ul class="flex flex-col gap-1 text-sm">
      {% for key in ['how', 'features', 'pricing', 'faq'] %}
        {% if key != 'pricing' or plans.length %}
          <li><a href="#{{ key }}" x-on:click="navOpen = false" class="inline-flex min-h-11 w-full items-center rounded-md px-3 hover:bg-muted-surface">{{ t(L + 'nav.' + key) }}</a></li>
        {% endif %}
      {% endfor %}
      <li><a href="/admin/login" class="inline-flex min-h-11 w-full items-center rounded-md px-3 hover:bg-muted-surface">{{ t(L + 'nav.signIn') }}</a></li>
    </ul>
  </nav>
</header>

<main id="main-content" tabindex="-1" class="focus:outline-none">

  <section aria-labelledby="hero-title">
    <div class="mx-auto grid max-w-6xl gap-10 px-4 pb-16 pt-10 sm:px-6 lg:gap-16 lg:pb-24 lg:pt-16 {{ 'lg:grid-cols-[minmax(0,1.15fr)_minmax(0,1fr)] lg:items-center' if demoSlug }}">
      <div>
        <h1 id="hero-title" class="font-display text-4xl font-bold leading-heading text-text sm:text-5xl lg:text-6xl">{{ t(L + 'hero.title') }}</h1>
        <p class="mt-6 max-w-xl text-lg leading-body text-text">{{ t(L + 'hero.text') }}</p>
        <div class="mt-8 flex flex-wrap items-center gap-x-6 gap-y-2">
          <a href="{{ ctaHref }}" class="inline-flex min-h-12 items-center rounded-md bg-primary px-6 text-base font-bold text-primary-on hover:bg-primary-hover focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary">{{ t(L + 'hero.primaryTrial') if hasTrial else t(L + 'hero.primary') }}</a>
          {% if demoSlug %}
            <a href="/m/{{ demoSlug }}" class="inline-flex min-h-12 items-center text-base font-medium text-primary-text underline underline-offset-4 hover:text-primary-hover focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary">{{ t(L + 'hero.secondary') }}</a>
          {% endif %}
        </div>
        <p class="mt-8 max-w-xl text-sm text-muted-text">{{ t(L + 'hero.note') }}</p>
      </div>

      {% if demoSlug %}
        <div>
          {{ iphoneFrame('/m/' + demoSlug + '?lang=' + locale, t(L + 'hero.phoneTitle'), t(L + 'hero.secondary')) }}
          <p class="mx-auto mt-5 hidden max-w-xs text-center text-sm text-muted-text lg:block">{{ t(L + 'hero.phoneDesktop') }}</p>
          <p class="mx-auto mt-5 max-w-xs text-center text-sm text-muted-text lg:hidden">{{ t(L + 'hero.phoneTouch') }}</p>
        </div>
      {% endif %}
    </div>
  </section>

  <section id="how" class="scroll-mt-16 border-t border-border" aria-labelledby="how-title">
    <div class="mx-auto grid max-w-6xl gap-8 px-4 py-12 sm:px-6 lg:grid-cols-[minmax(0,1fr)_minmax(0,2fr)] lg:gap-16 lg:py-16">
      <h2 id="how-title" class="font-display text-2xl font-bold leading-heading text-text sm:text-3xl">{{ t(L + 'how.title') }}</h2>
      <ol class="divide-y divide-border border-y border-border">
        {% for step in [0, 1, 2] %}
          <li class="grid grid-cols-[2.5rem_minmax(0,1fr)] gap-x-3 gap-y-1 py-5 sm:grid-cols-[3rem_minmax(0,1fr)_minmax(0,1.4fr)] sm:gap-x-6">
            <span class="font-display text-3xl font-bold leading-none text-primary-text" aria-hidden="true">{{ loop.index }}</span>
            <h3 class="font-display text-lg font-bold text-text sm:text-xl">{{ t(L + 'how.steps.' + step + '.title') }}</h3>
            <p class="col-start-2 text-muted-text sm:col-start-auto">{{ t(L + 'how.steps.' + step + '.text') }}</p>
          </li>
        {% endfor %}
      </ol>
    </div>
  </section>

  <section id="features" class="scroll-mt-16 border-t border-border" aria-labelledby="features-title">
    <div class="mx-auto grid max-w-6xl gap-8 px-4 py-12 sm:px-6 lg:grid-cols-[minmax(0,1fr)_minmax(0,2fr)] lg:gap-16 lg:py-16">
      <h2 id="features-title" class="font-display text-2xl font-bold leading-heading text-text sm:text-3xl">{{ t(L + 'features.title') }}</h2>
      <dl class="grid gap-x-10 sm:grid-cols-2">
        {% for index in [0, 1, 2, 3, 4, 5, 6, 7, 8] %}
          <div class="border-t border-border py-4 first:border-t-0 sm:[&:nth-child(2)]:border-t-0">
            <dt class="font-bold text-text">{{ t(L + 'features.items.' + index + '.title') }}</dt>
            <dd class="mt-1 text-muted-text">{{ t(L + 'features.items.' + index + '.text') }}</dd>
          </div>
        {% endfor %}
      </dl>
    </div>
  </section>

  {% if plans.length %}
  <section id="pricing" class="scroll-mt-16 border-t border-border" aria-labelledby="pricing-title">
    <div class="mx-auto grid max-w-6xl gap-8 px-4 py-12 sm:px-6 lg:grid-cols-[minmax(0,1fr)_minmax(0,2fr)] lg:gap-16 lg:py-16">
      <div>
        <h2 id="pricing-title" class="font-display text-2xl font-bold leading-heading text-text sm:text-3xl">{{ t(L + 'pricing.title') }}</h2>
        <p class="mt-3 max-w-sm text-muted-text">{{ t(L + 'pricing.intro') }}</p>
      </div>
      {# Laid out like the price list of a menu: name, a dotted leader, the price. #}
      <ul class="divide-y divide-border border-y border-border">
        {% for plan in plans %}
          <li class="py-6">
            <div class="flex items-baseline gap-3">
              <h3 class="font-display text-xl font-bold text-text">{{ plan.name }}</h3>
              <span class="min-w-6 flex-1 border-b-2 border-dotted border-border-strong" aria-hidden="true"></span>
              <p class="flex items-baseline gap-1" dir="ltr">
                <span class="font-display text-2xl font-bold text-text">{{ plan.price }}</span>
                <span class="font-bold text-text">{{ plan.symbol }}</span>
                <span class="text-sm text-muted-text">/ {{ t(L + 'pricing.' + plan.interval) }}</span>
              </p>
            </div>
            {% if plan.description %}<p class="mt-1 text-muted-text">{{ plan.description }}</p>{% endif %}
            {% if plan.trialDays %}<p class="mt-1 text-sm font-medium text-success">{{ t(L + 'pricing.trial', { days: plan.trialDays }) }}</p>{% endif %}
            <dl class="mt-4 grid grid-cols-2 gap-x-6 gap-y-1 text-sm sm:grid-cols-4">
              {% for row in [['menus', plan.limits.menus], ['categories', plan.limits.categories], ['dishes', plan.limits.dishes], ['admins', plan.limits.admins]] %}
                <div>
                  <dt class="text-muted-text">{{ t(L + 'pricing.' + row[0]) }}</dt>
                  <dd class="font-medium text-text">{% if row[1] is number %}{{ t(L + 'pricing.upTo', { count: row[1] }) }}{% else %}{{ t(L + 'pricing.unlimited') }}{% endif %}</dd>
                </div>
              {% endfor %}
            </dl>
            {% set included = [] %}{% set excluded = [] %}
            {% for feature in ['tableOrdering', 'whatsappOrdering', 'bulkTools', 'analytics'] %}
              {% if plan.features[feature] %}{% set _a = included.push(t(L + 'pricing.features.' + feature)) %}{% else %}{% set _b = excluded.push(t(L + 'pricing.features.' + feature)) %}{% endif %}
            {% endfor %}
            {% if included.length %}<p class="mt-3 text-sm text-text"><span class="font-medium">{{ t(L + 'pricing.includes') }}:</span> {{ included | join(', ') }}</p>{% endif %}
            {% if excluded.length %}<p class="mt-1 text-sm text-muted-text"><span class="font-medium">{{ t(L + 'pricing.excludes') }}:</span> {{ excluded | join(', ') }}</p>{% endif %}
            <a href="{{ ctaHref }}" class="mt-4 inline-flex min-h-11 items-center text-sm font-bold text-primary-text underline underline-offset-4 hover:text-primary-hover focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary">{{ t(L + 'pricing.cta') }}</a>
          </li>
        {% endfor %}
      </ul>
    </div>
  </section>
  {% endif %}

  <section id="faq" class="scroll-mt-16 border-t border-border" aria-labelledby="faq-title">
    <div class="mx-auto grid max-w-6xl gap-8 px-4 py-12 sm:px-6 lg:grid-cols-[minmax(0,1fr)_minmax(0,2fr)] lg:gap-16 lg:py-16">
      <h2 id="faq-title" class="font-display text-2xl font-bold leading-heading text-text sm:text-3xl">{{ t(L + 'faq.title') }}</h2>
      <div class="divide-y divide-border border-y border-border">
        {% for index in [0, 1, 2, 3, 4, 5, 6] %}
          <details class="group">
            <summary class="flex min-h-14 cursor-pointer list-none items-center justify-between gap-4 py-3 text-start font-bold text-text focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary [&::-webkit-details-marker]:hidden">
              {{ t(L + 'faq.items.' + index + '.q') }}
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="shrink-0 text-muted-text transition-transform group-open:rotate-180" aria-hidden="true"><path d="M6 9l6 6 6-6" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </summary>
            <p class="pb-5 pe-8 leading-body text-muted-text">{{ t(L + 'faq.items.' + index + '.a') }}</p>
          </details>
        {% endfor %}
      </div>
    </div>
  </section>

  <section class="border-t border-border bg-primary text-primary-on" aria-labelledby="cta-title">
    <div class="mx-auto flex max-w-6xl flex-col gap-6 px-4 py-12 sm:px-6 md:flex-row md:items-end md:justify-between lg:py-16">
      <div>
        <h2 id="cta-title" class="font-display text-3xl font-bold leading-heading sm:text-4xl">{{ t(L + 'cta.title') }}</h2>
        <p class="mt-2 text-lg">{{ t(L + 'cta.text') }}</p>
      </div>
      <div class="flex flex-wrap items-center gap-3">
        <a href="{{ ctaHref }}" class="inline-flex min-h-12 items-center rounded-md bg-surface px-6 text-base font-bold text-primary-text hover:bg-muted-surface focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary-on">{{ t(L + 'cta.button') if (contact.whatsappUrl or contact.email) else t(L + 'nav.signIn') }}</a>
        {% if contact.whatsappUrl and contact.email %}
          <a href="mailto:{{ contact.email }}" class="inline-flex min-h-12 items-center rounded-md border border-primary-on px-6 text-base font-medium text-primary-on hover:bg-primary-hover focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary-on">{{ t(L + 'contact.email') }}</a>
        {% endif %}
      </div>
    </div>
  </section>
</main>

<footer class="bg-surface">
  <div class="mx-auto flex max-w-6xl flex-col gap-6 px-4 py-10 sm:px-6 md:flex-row md:items-center md:justify-between">
    <div>
      <p class="font-display text-xl font-bold text-primary-text">{{ t('common.app.name') }}</p>
      <p class="mt-1 text-sm text-muted-text">{{ t(L + 'footer.tagline') }}</p>
    </div>
    <ul class="flex flex-wrap gap-x-2 text-sm">
      {% for key in ['how', 'features', 'pricing', 'faq'] %}
        {% if key != 'pricing' or plans.length %}
          <li><a href="#{{ key }}" class="inline-flex min-h-11 min-w-11 items-center justify-center px-2 text-text hover:underline">{{ t(L + 'nav.' + key) }}</a></li>
        {% endif %}
      {% endfor %}
      <li><a href="/admin/login" class="inline-flex min-h-11 min-w-11 items-center justify-center px-2 text-text hover:underline">{{ t(L + 'nav.signIn') }}</a></li>
    </ul>
    <p class="text-sm text-muted-text">© {{ year }} {{ t('common.app.name') }}. {{ t(L + 'footer.rights') }}</p>
  </div>
</footer>
{% endblock %}

{% block scripts %}
  {% if demoSlug %}<script defer src="{{ asset('/js/landing.js') }}"></script>{% endif %}
{% endblock %}
