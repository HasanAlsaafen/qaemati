{% extends "layouts/base.njk" %}

{% block content %}
<div class="rounded-xl border border-border bg-surface p-8 shadow-sm">
  <h1 class="font-sans text-3xl font-bold leading-tight text-text md:text-4xl">
    {{ t('common.home.title') }}
  </h1>
  <p class="mt-3 text-lg text-muted-text">
    {{ t('common.home.subtitle') }}
  </p>
  <p class="mt-6 text-sm text-muted-text">
    {{ t('common.home.description') }}
  </p>
  {% if restaurants.length %}
    <ul class="mt-4 flex flex-col gap-2">
      {% for restaurant in restaurants %}
        <li>
          <a
            href="/m/{{ restaurant.slug }}"
            class="inline-flex min-h-11 items-center rounded-md border border-border bg-surface px-4 text-sm font-medium text-text hover:bg-muted-surface focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary"
          >
            {{ restaurant.name }}
            <svg class="ms-1 inline-block h-4 w-4 rtl:rotate-180" width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M6 3l5 5-5 5" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </a>
        </li>
      {% endfor %}
    </ul>
  {% endif %}
</div>

{% if demoMode %}
  <div class="mt-6 rounded-xl border border-border bg-surface p-6">
    {% if demoResetSucceeded %}
      <p role="status" class="mb-4 rounded-md bg-success/10 px-3 py-2 text-sm text-success">{{ t('common.home.demo.resetSuccessMessage') }}</p>
    {% endif %}
    <h2 class="font-sans text-xl font-bold text-text">{{ t('common.home.demo.panelTitle') }}</h2>
    <p class="mt-2 text-sm text-muted-text">{{ t('common.home.demo.panelDescription') }}</p>

    <ul class="mt-4 flex flex-col gap-3">
      {% for restaurant in restaurants %}
        {% if restaurant.demoAdminEmail %}
          <li class="rounded-md border border-border bg-muted-surface p-3">
            <p class="text-sm font-medium text-text">{{ restaurant.name }}</p>
            <p class="mt-1 text-sm text-muted-text" dir="ltr">
              {{ t('common.home.demo.emailLabel') }}: <span class="font-mono">{{ restaurant.demoAdminEmail }}</span>
            </p>
            <p class="text-sm text-muted-text" dir="ltr">
              {{ t('common.home.demo.passwordLabel') }}: <span class="font-mono">{{ demoAdminPassword }}</span>
            </p>
          </li>
        {% endif %}
      {% endfor %}
      <li class="rounded-md border border-border bg-muted-surface p-3">
        <p class="text-sm font-medium text-text">{{ t('common.home.demo.platformTitle') }}</p>
        <p class="text-sm text-muted-text">{{ t('common.home.demo.platformHint') }}</p>
        <p class="mt-1 text-sm text-muted-text" dir="ltr">
          {{ t('common.home.demo.emailLabel') }}: <span class="font-mono">{{ demoSuperAdminEmail }}</span>
        </p>
        <p class="text-sm text-muted-text" dir="ltr">
          {{ t('common.home.demo.passwordLabel') }}: <span class="font-mono">{{ demoAdminPassword }}</span>
        </p>
        <a href="/super/login" class="mt-1 inline-flex min-h-11 items-center text-sm font-medium text-primary hover:underline">{{ t('common.home.demo.platformLink') }}</a>
      </li>
    </ul>

    <div class="mt-4 flex flex-wrap items-center gap-3">
      <a
        href="/admin/login"
        class="inline-flex min-h-11 items-center rounded-md bg-primary px-4 text-sm font-medium text-primary-on hover:bg-primary-hover focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary"
      >{{ t('common.home.demo.loginLink') }}</a>

      {# An inline onsubmit handler is blocked by the page's CSP, so the confirmation
         runs through Alpine, which the CSP allows. #}
      <form method="post" action="/demo/reset" x-data x-on:submit="if (!confirm({{ t('common.home.demo.resetConfirm') | dump }})) $event.preventDefault()">
        <input type="hidden" name="csrf_token" value="{{ csrfToken }}">
        <button
          type="submit"
          class="inline-flex min-h-11 items-center rounded-md border border-border px-4 text-sm font-medium text-text hover:bg-muted-surface focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary"
        >{{ t('common.home.demo.resetButton') }}</button>
      </form>
    </div>
  </div>
{% endif %}
{% endblock %}
