{% extends "layouts/landing.njk" %}
{% from "components/language-switcher.njk" import languageSwitcher %}

{# Where every "get in touch" button goes: WhatsApp, else email, else the owner sign in. #}
{% if contact.whatsappUrl %}
  {% set ctaHref = contact.whatsappUrl %}{% set ctaLabel = t('common.home.landing.contact.whatsapp') %}
{% elif contact.email %}
  {% set ctaHref = 'mailto:' + contact.email %}{% set ctaLabel = t('common.home.landing.contact.email') %}
{% else %}
  {% set ctaHref = '/admin/login' %}{% set ctaLabel = t('common.home.landing.nav.signIn') %}
{% endif %}
{% set L = 'common.home.landing.' %}

{% macro icon(name) %}
  <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    {% if name == 'globe' %}<circle cx="12" cy="12" r="9"/><path d="M3 12h18M12 3c3 3.2 3 14.8 0 18M12 3c-3 3.2-3 14.8 0 18"/>
    {% elif name == 'qr' %}<rect x="3" y="3" width="7" height="7" rx="1"/><rect x="14" y="3" width="7" height="7" rx="1"/><rect x="3" y="14" width="7" height="7" rx="1"/><path d="M14 14h3v3h-3zM20 14v.01M14 20h3M20 17v4"/>
    {% elif name == 'chat' %}<path d="M4 5h16v11H9l-5 4z"/><path d="M8 10h8M8 13h5"/>
    {% elif name == 'clock' %}<circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/>
    {% elif name == 'edit' %}<path d="M4 20h4L19 9l-4-4L4 16z"/><path d="M13 7l4 4"/>
    {% elif name == 'bulk' %}<path d="M4 6h16M4 12h10M4 18h6"/><path d="M17 15l3 3 3-3"/>
    {% elif name == 'brand' %}<circle cx="12" cy="12" r="9"/><circle cx="8.5" cy="10" r="1.2"/><circle cx="12" cy="7.5" r="1.2"/><circle cx="15.5" cy="10" r="1.2"/><path d="M12 21c-2 0-2-2-1-3s0-3 2-3h3"/>
    {% elif name == 'chart' %}<path d="M4 20V10M10 20V4M16 20v-7M22 20H2"/>
    {% else %}<path d="M13 2L4 14h7l-1 8 9-12h-7z"/>{% endif %}
  </svg>
{% endmacro %}

{% block body %}
{% set featureIcons = ['globe', 'qr', 'chat', 'clock', 'edit', 'bulk', 'brand', 'chart', 'bolt'] %}

<header class="sticky top-0 z-40 border-b border-border bg-surface/95 backdrop-blur">
  <div class="mx-auto flex max-w-6xl items-center gap-3 px-4 py-2 sm:px-6">
    <a href="/" class="inline-flex min-h-11 items-center font-display text-2xl font-bold text-primary-text">{{ t('common.app.name') }}</a>
    <nav class="ms-6 hidden items-center gap-1 md:flex" aria-label="{{ t(L + 'nav.menu') }}">
      {% for item in [['how', 'how'], ['features', 'features'], ['pricing', 'pricing'], ['faq', 'faq']] %}
        {% if item[0] != 'pricing' or plans.length %}
          <a href="#{{ item[0] }}" class="inline-flex min-h-11 items-center rounded-md px-3 text-sm font-medium text-text hover:bg-muted-surface">{{ t(L + 'nav.' + item[1]) }}</a>
        {% endif %}
      {% endfor %}
    </nav>
    <div class="ms-auto flex items-center gap-2">
      {{ languageSwitcher(otherLocale, t('common.nav.language')) }}
      <a href="/admin/login" class="hidden min-h-11 items-center rounded-md px-3 text-sm font-medium text-text hover:bg-muted-surface lg:inline-flex">{{ t(L + 'nav.signIn') }}</a>
      <a href="{{ '#demo' if demoMode else ctaHref }}" class="hidden min-h-11 items-center rounded-md bg-primary px-4 text-sm font-medium text-primary-on hover:bg-primary-hover md:inline-flex">{{ t(L + 'nav.demo') if demoMode else t(L + 'hero.primary') }}</a>
      <button type="button" class="inline-flex h-11 w-11 items-center justify-center rounded-md hover:bg-muted-surface md:hidden" aria-label="{{ t(L + 'nav.menu') }}" x-bind:aria-expanded="navOpen.toString()" aria-controls="landing-nav" x-on:click="navOpen = !navOpen">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16" stroke-linecap="round"/></svg>
      </button>
    </div>
  </div>
  <nav id="landing-nav" x-show="navOpen" x-cloak class="border-t border-border px-4 py-3 md:hidden" aria-label="{{ t(L + 'nav.menu') }}">
    <ul class="flex flex-col gap-1 text-sm">
      {% for key in ['how', 'features', 'pricing', 'faq'] %}
        {% if key != 'pricing' or plans.length %}
          <li><a href="#{{ key }}" x-on:click="navOpen = false" class="inline-flex min-h-11 w-full items-center rounded-md px-3 hover:bg-muted-surface">{{ t(L + 'nav.' + key) }}</a></li>
        {% endif %}
      {% endfor %}
      <li><a href="/admin/login" class="inline-flex min-h-11 w-full items-center rounded-md px-3 hover:bg-muted-surface">{{ t(L + 'nav.signIn') }}</a></li>
    </ul>
  </nav>
</header>

<main id="main-content" tabindex="-1" class="focus:outline-none">

  <section class="bg-gradient-to-b from-primary-soft to-bg" aria-labelledby="hero-title">
    <div class="mx-auto grid max-w-6xl items-center gap-10 px-4 py-12 sm:px-6 sm:py-16 lg:grid-cols-2 lg:gap-16 lg:py-24">
      <div>
        <p class="inline-flex rounded-full border border-primary/30 bg-surface px-3 py-1 text-sm font-medium text-primary-text">{{ t(L + 'hero.eyebrow') }}</p>
        <h1 id="hero-title" class="mt-5 font-display text-4xl font-bold leading-heading text-text sm:text-5xl lg:text-6xl">{{ t(L + 'hero.title') }}</h1>
        <p class="mt-5 max-w-xl text-lg leading-body text-muted-text">{{ t(L + 'hero.text') }}</p>
        <div class="mt-8 flex flex-wrap items-center gap-3">
          <a href="{{ ctaHref }}" class="inline-flex min-h-12 items-center rounded-md bg-primary px-6 text-base font-bold text-primary-on shadow-raised hover:bg-primary-hover focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary">{{ t(L + 'hero.primaryTrial') if hasTrial else t(L + 'hero.primary') }}</a>
          {% if demoSlug %}
            <a href="/m/{{ demoSlug }}" class="inline-flex min-h-12 items-center rounded-md border border-border-strong bg-surface px-6 text-base font-medium text-text hover:bg-muted-surface focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary">{{ t(L + 'hero.secondary') }}</a>
          {% endif %}
        </div>
        <ul class="mt-8 flex flex-col gap-2 text-sm text-text sm:flex-row sm:flex-wrap sm:gap-x-6">
          {% for point in ['p0', 'p1', 'p2'] %}
            <li class="flex items-center gap-2">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" class="shrink-0 text-success" aria-hidden="true"><path d="M5 12.5l4.5 4.5L19 7.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
              {{ t(L + 'hero.points.' + loop.index0) }}
            </li>
          {% endfor %}
        </ul>
      </div>

      {# A sketch of the guest's phone, built from the page's own colors. Decorative. #}
      <div class="mx-auto w-full max-w-xs lg:max-w-sm" aria-hidden="true">
        <div class="rounded-[2.4rem] border-8 border-text bg-bg p-3 shadow-overlay">
          <div class="flex items-center gap-2 rounded-card bg-surface p-2">
            <span class="flex h-9 w-9 items-center justify-center rounded-full bg-primary font-display text-sm font-bold text-primary-on">ق</span>
            <span class="min-w-0 flex-1 truncate text-sm font-bold text-text">{{ t('common.app.name') }}</span>
            <span class="rounded-full bg-primary-soft px-2 py-0.5 text-xs font-bold text-primary-text">AR | EN</span>
          </div>
          <div class="mt-2 rounded-full border border-border bg-surface px-3 py-2 text-xs text-muted-text">{{ t(L + 'mock.search') }}</div>
          <div class="mt-3 flex gap-3 overflow-hidden">
            {% for chip in [['all', 'bg-primary'], ['starters', 'bg-secondary'], ['grill', 'bg-gold'], ['drinks', 'bg-success']] %}
              <div class="flex w-14 shrink-0 flex-col items-center gap-1">
                <span class="h-11 w-11 rounded-full {{ chip[1] }} {{ 'ring-2 ring-primary ring-offset-2 ring-offset-bg' if loop.first }}"></span>
                <span class="text-[11px] font-medium text-text">{{ t(L + 'mock.' + chip[0]) }}</span>
              </div>
            {% endfor %}
          </div>
          <div class="mt-3 grid grid-cols-2 gap-2">
            {% for dish in [['d1', 'bg-secondary-soft', '14'], ['d2', 'bg-primary-soft', '12'], ['d3', 'bg-primary-soft', '10'], ['d4', 'bg-secondary-soft', '18']] %}
              <div class="overflow-hidden rounded-card border border-border bg-surface">
                <div class="h-16 {{ dish[1] }}"></div>
                <div class="p-2">
                  <p class="truncate text-xs font-bold text-text">{{ t(L + 'mock.' + dish[0]) }}</p>
                  <p class="text-xs font-bold text-primary-text" dir="ltr">{{ dish[2] }}.00 ₪</p>
                </div>
              </div>
            {% endfor %}
          </div>
        </div>
      </div>
    </div>
  </section>

  <section id="how" class="scroll-mt-20 bg-surface" aria-labelledby="how-title">
    <div class="mx-auto max-w-6xl px-4 py-14 sm:px-6 sm:py-20">
      <h2 id="how-title" class="font-display text-3xl font-bold leading-heading text-text sm:text-4xl">{{ t(L + 'how.title') }}</h2>
      <p class="mt-3 max-w-2xl text-lg text-muted-text">{{ t(L + 'how.intro') }}</p>
      <ol class="mt-10 grid gap-6 md:grid-cols-3">
        {% for step in [0, 1, 2] %}
          <li class="rounded-card border border-border bg-bg p-6">
            <span class="flex h-11 w-11 items-center justify-center rounded-full bg-primary font-display text-xl font-bold text-primary-on" aria-hidden="true">{{ loop.index }}</span>
            <h3 class="mt-4 font-display text-xl font-bold text-text">{{ t(L + 'how.steps.' + step + '.title') }}</h3>
            <p class="mt-2 leading-body text-muted-text">{{ t(L + 'how.steps.' + step + '.text') }}</p>
          </li>
        {% endfor %}
      </ol>
    </div>
  </section>

  <section id="features" class="scroll-mt-20" aria-labelledby="features-title">
    <div class="mx-auto max-w-6xl px-4 py-14 sm:px-6 sm:py-20">
      <h2 id="features-title" class="font-display text-3xl font-bold leading-heading text-text sm:text-4xl">{{ t(L + 'features.title') }}</h2>
      <p class="mt-3 max-w-2xl text-lg text-muted-text">{{ t(L + 'features.intro') }}</p>
      <ul class="mt-10 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
        {% for index in [0, 1, 2, 3, 4, 5, 6, 7, 8] %}
          <li class="rounded-card border border-border bg-surface p-6">
            <span class="flex h-11 w-11 items-center justify-center rounded-md bg-secondary-soft text-secondary-text">{{ icon(featureIcons[index]) }}</span>
            <h3 class="mt-4 font-display text-lg font-bold text-text">{{ t(L + 'features.items.' + index + '.title') }}</h3>
            <p class="mt-2 leading-body text-muted-text">{{ t(L + 'features.items.' + index + '.text') }}</p>
          </li>
        {% endfor %}
      </ul>
    </div>
  </section>

  {% if plans.length %}
  <section id="pricing" class="scroll-mt-20 bg-surface" aria-labelledby="pricing-title">
    <div class="mx-auto max-w-6xl px-4 py-14 sm:px-6 sm:py-20">
      <h2 id="pricing-title" class="font-display text-3xl font-bold leading-heading text-text sm:text-4xl">{{ t(L + 'pricing.title') }}</h2>
      <p class="mt-3 max-w-2xl text-lg text-muted-text">{{ t(L + 'pricing.intro') }}</p>
      {% if plans.length >= 3 %}{% set planGrid = 'lg:grid-cols-3' %}{% elif plans.length == 2 %}{% set planGrid = 'md:grid-cols-2' %}{% else %}{% set planGrid = 'max-w-md' %}{% endif %}
      <ul class="mt-10 grid gap-6 {{ planGrid }}">
        {% for plan in plans %}
          <li class="relative flex flex-col rounded-card border bg-bg p-6 {{ 'border-primary ring-2 ring-primary' if plan.popular else 'border-border' }}">
            {% if plan.popular %}<span class="absolute -top-3 start-6 rounded-full bg-primary px-3 py-1 text-xs font-bold text-primary-on">{{ t(L + 'pricing.popular') }}</span>{% endif %}
            <h3 class="font-display text-2xl font-bold text-text">{{ plan.name }}</h3>
            {% if plan.description %}<p class="mt-1 text-sm text-muted-text">{{ plan.description }}</p>{% endif %}
            <p class="mt-5 flex items-baseline gap-2" dir="ltr">
              <span class="font-display text-4xl font-bold text-text">{{ plan.price }}</span>
              <span class="text-lg font-bold text-text">{{ plan.symbol }}</span>
              <span class="text-sm text-muted-text">/ {{ t(L + 'pricing.' + plan.interval) }}</span>
            </p>
            {% if plan.trialDays %}<p class="mt-1 text-sm font-medium text-success">{{ t(L + 'pricing.trial', { days: plan.trialDays }) }}</p>{% endif %}
            <ul class="mt-6 flex flex-1 flex-col gap-2 border-t border-border pt-5 text-sm text-text">
              {% for row in [['menus', plan.limits.menus], ['categories', plan.limits.categories], ['dishes', plan.limits.dishes], ['admins', plan.limits.admins]] %}
                <li class="flex items-center justify-between gap-3">
                  <span class="text-muted-text">{{ t(L + 'pricing.' + row[0]) }}</span>
                  <span class="font-medium">{% if row[1] is number %}{{ t(L + 'pricing.upTo', { count: row[1] }) }}{% else %}{{ t(L + 'pricing.unlimited') }}{% endif %}</span>
                </li>
              {% endfor %}
              {% for feature in ['whatsappOrdering', 'bulkTools', 'analytics'] %}
                <li class="flex items-center gap-2 {{ '' if plan.features[feature] else 'text-muted-text' }}">
                  {% if plan.features[feature] %}
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" class="shrink-0 text-success" aria-hidden="true"><path d="M5 12.5l4.5 4.5L19 7.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
                    <span class="sr-only">{{ t(L + 'pricing.included') }}:</span>
                  {% else %}
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="shrink-0" aria-hidden="true"><path d="M6 12h12" stroke-linecap="round"/></svg>
                    <span class="sr-only">{{ t(L + 'pricing.notIncluded') }}:</span>
                  {% endif %}
                  {{ t(L + 'pricing.features.' + feature) }}
                </li>
              {% endfor %}
            </ul>
            <a href="{{ ctaHref }}" class="mt-6 inline-flex min-h-11 items-center justify-center rounded-md px-4 text-sm font-bold focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary {{ 'bg-primary text-primary-on hover:bg-primary-hover' if plan.popular else 'border border-border-strong text-text hover:bg-muted-surface' }}">{{ t(L + 'pricing.cta') }}</a>
          </li>
        {% endfor %}
      </ul>
    </div>
  </section>
  {% endif %}

  {% if demoMode %}
  <section id="demo" class="scroll-mt-20" aria-labelledby="demo-title">
    <div class="mx-auto max-w-6xl px-4 py-14 sm:px-6 sm:py-20">
      <h2 id="demo-title" class="font-display text-3xl font-bold leading-heading text-text sm:text-4xl">{{ t(L + 'demo.title') }}</h2>
      <p class="mt-3 max-w-2xl text-lg text-muted-text">{{ t(L + 'demo.intro') }}</p>

      <div class="mt-8 rounded-card border border-border bg-surface p-6">
        {% if demoResetSucceeded %}
          <p role="status" class="mb-4 rounded-md bg-success/10 px-3 py-2 text-sm text-success">{{ t('common.home.demo.resetSuccessMessage') }}</p>
        {% endif %}
        <h3 class="font-display text-xl font-bold text-text">{{ t(L + 'demo.menus') }}</h3>
        <ul class="mt-3 flex flex-wrap gap-2">
          {% for restaurant in restaurants %}
            <li>
              <a href="/m/{{ restaurant.slug }}" class="inline-flex min-h-11 items-center rounded-md border border-border bg-surface px-4 text-sm font-medium text-text hover:bg-muted-surface focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary">
                {{ restaurant.name }}
                <svg class="ms-1 inline-block h-4 w-4 rtl:rotate-180" width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M6 3l5 5-5 5" stroke-linecap="round" stroke-linejoin="round"/></svg>
              </a>
            </li>
          {% endfor %}
        </ul>

        <h3 class="mt-8 font-display text-xl font-bold text-text">{{ t('common.home.demo.panelTitle') }}</h3>
        <ul class="mt-3 grid gap-3 md:grid-cols-3">
          {% for restaurant in restaurants %}
            {% if restaurant.demoAdminEmail %}
              <li class="rounded-md border border-border bg-muted-surface p-3">
                <p class="text-sm font-medium text-text">{{ restaurant.name }}</p>
                <p class="mt-1 text-sm text-muted-text" dir="ltr">
                  {{ t('common.home.demo.emailLabel') }}: <span class="font-mono">{{ restaurant.demoAdminEmail }}</span>
                </p>
                <p class="text-sm text-muted-text" dir="ltr">
                  {{ t('common.home.demo.passwordLabel') }}: <span class="font-mono">{{ demoAdminPassword }}</span>
                </p>
              </li>
            {% endif %}
          {% endfor %}
          <li class="rounded-md border border-border bg-muted-surface p-3">
            <p class="text-sm font-medium text-text">{{ t('common.home.demo.platformTitle') }}</p>
            <p class="text-sm text-muted-text">{{ t('common.home.demo.platformHint') }}</p>
            <p class="mt-1 text-sm text-muted-text" dir="ltr">
              {{ t('common.home.demo.emailLabel') }}: <span class="font-mono">{{ demoSuperAdminEmail }}</span>
            </p>
            <p class="text-sm text-muted-text" dir="ltr">
              {{ t('common.home.demo.passwordLabel') }}: <span class="font-mono">{{ demoAdminPassword }}</span>
            </p>
            <a href="/super/login" class="mt-1 inline-flex min-h-11 items-center text-sm font-medium text-primary-text hover:underline">{{ t('common.home.demo.platformLink') }}</a>
          </li>
        </ul>

        <div class="mt-6 flex flex-wrap items-center gap-3">
          <a href="/admin/login" class="inline-flex min-h-11 items-center rounded-md bg-primary px-4 text-sm font-medium text-primary-on hover:bg-primary-hover focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary">{{ t('common.home.demo.loginLink') }}</a>
          {# An inline onsubmit handler is blocked by the page's CSP, so the confirmation
             runs through Alpine, which the CSP allows. #}
          <form method="post" action="/demo/reset" x-data x-on:submit="if (!confirm({{ t('common.home.demo.resetConfirm') | dump }})) $event.preventDefault()">
            <input type="hidden" name="csrf_token" value="{{ csrfToken }}">
            <button type="submit" class="inline-flex min-h-11 items-center rounded-md border border-border px-4 text-sm font-medium text-text hover:bg-muted-surface focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary">{{ t('common.home.demo.resetButton') }}</button>
          </form>
        </div>
      </div>
    </div>
  </section>
  {% endif %}

  <section id="faq" class="scroll-mt-20 {{ '' if demoMode else 'bg-surface' }}" aria-labelledby="faq-title">
    <div class="mx-auto max-w-3xl px-4 py-14 sm:px-6 sm:py-20">
      <h2 id="faq-title" class="font-display text-3xl font-bold leading-heading text-text sm:text-4xl">{{ t(L + 'faq.title') }}</h2>
      <div class="mt-8 divide-y divide-border rounded-card border border-border bg-surface">
        {% for index in [0, 1, 2, 3, 4, 5, 6] %}
          <details class="group px-5">
            <summary class="flex min-h-14 cursor-pointer list-none items-center justify-between gap-4 py-3 text-start font-display text-lg font-bold text-text focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary [&::-webkit-details-marker]:hidden">
              {{ t(L + 'faq.items.' + index + '.q') }}
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="shrink-0 transition-transform group-open:rotate-180" aria-hidden="true"><path d="M6 9l6 6 6-6" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </summary>
            <p class="pb-5 leading-body text-muted-text">{{ t(L + 'faq.items.' + index + '.a') }}</p>
          </details>
        {% endfor %}
      </div>
    </div>
  </section>

  <section class="bg-primary text-primary-on" aria-labelledby="cta-title">
    <div class="mx-auto flex max-w-6xl flex-col items-start gap-6 px-4 py-14 sm:px-6 sm:py-16 md:flex-row md:items-center md:justify-between">
      <div class="max-w-xl">
        <h2 id="cta-title" class="font-display text-3xl font-bold leading-heading sm:text-4xl">{{ t(L + 'cta.title') }}</h2>
        <p class="mt-2 text-lg opacity-95">{{ t(L + 'cta.text') }}</p>
      </div>
      <div class="flex flex-wrap items-center gap-3">
        <a href="{{ ctaHref }}" class="inline-flex min-h-12 items-center rounded-md bg-surface px-6 text-base font-bold text-primary-text hover:bg-muted-surface focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary-on">{{ t(L + 'cta.button') if (contact.whatsappUrl or contact.email) else t(L + 'nav.signIn') }}</a>
        {% if contact.whatsappUrl and contact.email %}
          <a href="mailto:{{ contact.email }}" class="inline-flex min-h-12 items-center rounded-md border border-primary-on/60 px-6 text-base font-medium text-primary-on hover:bg-primary-hover focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary-on">{{ t(L + 'contact.email') }}</a>
        {% endif %}
      </div>
    </div>
  </section>
</main>

<footer class="border-t border-border bg-surface">
  <div class="mx-auto flex max-w-6xl flex-col gap-6 px-4 py-10 sm:px-6 md:flex-row md:items-center md:justify-between">
    <div>
      <p class="font-display text-xl font-bold text-primary-text">{{ t('common.app.name') }}</p>
      <p class="mt-1 text-sm text-muted-text">{{ t(L + 'footer.tagline') }}</p>
    </div>
    <ul class="flex flex-wrap gap-x-2 text-sm">
      {% for key in ['how', 'features', 'pricing', 'faq'] %}
        {% if key != 'pricing' or plans.length %}
          <li><a href="#{{ key }}" class="inline-flex min-h-11 min-w-11 items-center justify-center px-2 text-text hover:underline">{{ t(L + 'nav.' + key) }}</a></li>
        {% endif %}
      {% endfor %}
      <li><a href="/admin/login" class="inline-flex min-h-11 min-w-11 items-center justify-center px-2 text-text hover:underline">{{ t(L + 'nav.signIn') }}</a></li>
    </ul>
    <p class="text-sm text-muted-text">© {{ year }} {{ t('common.app.name') }}. {{ t(L + 'footer.rights') }}</p>
  </div>
</footer>
{% endblock %}
