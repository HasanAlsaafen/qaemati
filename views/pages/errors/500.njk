{% extends "layouts/base.njk" %}

{% block title %}{{ t('common.errors.serverErrorTitle') }}{% endblock %}

{% block content %}
<div class="rounded-xl border border-border bg-surface p-8 text-center shadow-sm">
  <p class="text-sm font-medium text-danger">500</p>
  <h1 class="mt-2 font-sans text-2xl font-bold text-text">{{ t('common.errors.serverErrorTitle') }}</h1>
  <p class="mt-3 text-muted-text">{{ t('common.errors.serverErrorBody') }}</p>
  <a
    href="/"
    class="mt-6 inline-block rounded-md bg-primary px-4 py-2 text-sm font-medium text-white hover:bg-primary-hover"
  >
    {{ t('common.errors.backHome') }}
  </a>
</div>
{% endblock %}
