# Copy to .env for local development. Never commit the real file.

# development, test or production. Production enforces the secret rules below.
NODE_ENV=development
PORT=3000

# PostgreSQL connection string. Required in every environment.
DATABASE_URL="postgresql://qaemati:qaemati@localhost:5435/qaemati?schema=public"

# Secrets signing the session cookie and the CSRF token.
# Production refuses to start unless each is set, is at least 16 characters,
# and does not contain the text "change-me". Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# In development a missing or placeholder value logs a warning and uses an
# insecure built in value.
SESSION_SECRET="change-me-in-production"
CSRF_SECRET="change-me-in-production"

# Default interface language when the visitor has not chosen one: ar or en.
DEFAULT_LOCALE=ar

# true shows demo credentials on the home page and enables the reset
# endpoint. Production logs a warning if this is on.
DEMO_MODE=true

# Public origin used in canonical links, Open Graph tags and the sitemap,
# for example https://menu.example.org . Leave empty to derive it from the
# request, which is only safe when your proxy pins the Host header.
PUBLIC_BASE_URL=

# Number of reverse proxies in front of the app (for example 1). Set it so
# rate limits apply per visitor instead of per proxy. Empty means none.
TRUST_PROXY=

# Email through Gmail SMTP, used for password reset and the sign in link sent to
# new restaurant owners. Create an app password at
# https://myaccount.google.com/apppasswords (needs 2 step verification on that
# Google account) and put the 16 characters here. Leave both empty to send
# nothing: development then prints each message in the terminal.
MAIL_USER=
MAIL_APP_PASSWORD=
# Optional sender text, for example: Qaemati <you@gmail.com>
MAIL_FROM=

# Platform area (/super) hardening.
# Two step verification is required in production by default. Set true or false to override.
SUPER_REQUIRE_2FA=
# Only these addresses can open /super (everyone else gets a 404). Comma separated,
# exact IPs or IPv4 ranges like 203.0.113.0/24. Empty means anyone can reach the login page.
SUPER_ALLOWED_IPS=

# Landing page.
# Where "get in touch" goes. WhatsApp wins over email, with neither the button goes to owner sign in.
LANDING_CONTACT_WHATSAPP=
LANDING_CONTACT_EMAIL=
# Slug of the restaurant behind "see a live menu". On a demo site the first restaurant is used.
LANDING_DEMO_SLUG=
# The landing page uses the Thmanyah font. Its license does not allow serving the font files
# on a public website without thmanyah's permission (ask@thmanyah.com). Set true only once you
# have it. While false in production the page uses Tajawal instead.
THMANYAH_WEB_LICENSED=

# Renewal reminder emails (7 and 1 day before a plan ends, when the grace period starts,
# when the menu goes offline) are checked every hour. Set false to turn them off.
# They link to PUBLIC_BASE_URL, so set that too.
REMINDERS_ENABLED=
